+func TestPostGCDQueueRejectsMissingOrAdvancedGCDWindow(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	_, whirlwind := requireSpellAction(t, env, 0, 1680)
+	_, cleave := requireSpellAction(t, env, 1, 20569)
+	if _, err := env.ApplyPostGCDQueue(cleave); err == nil {
+		t.Fatal("queue without preceding GCD was accepted")
+	}
+	if result, err := env.ApplyWithAttemptID(whirlwind, "ww-before-advance"); err != nil || !result.ConsumesDecision {
+		t.Fatalf("Whirlwind did not consume the decision: result=%+v err=%v", result, err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.ApplyPostGCDQueue(cleave); err == nil {
+		t.Fatal("queue after advance reused the old GCD window")
+	}
+}
