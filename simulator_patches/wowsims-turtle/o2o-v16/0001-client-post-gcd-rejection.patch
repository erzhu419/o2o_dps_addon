+func TestPostGCDQueueAfterWhirlwindIsRejected(t *testing.T) {
+	request := testWarriorRequest()
+	second := *request.Encounter.Targets[0]
+	second.Stats = append([]float64(nil), second.Stats...)
+	request.Encounter.Targets = append(request.Encounter.Targets, &second)
+	env := newTestWarriorEnvironment(t, request)
+	_, whirlwind := requireSpellAction(t, env, 0, 1680)
+	_, cleave := requireSpellAction(t, env, 1, 20569)
+	before := env.State().TimeMS
+
+	gcd, err := env.ApplyWithAttemptID(whirlwind, "ww-then-cleave")
+	if err != nil || !gcd.Casted || !gcd.ConsumesDecision || gcd.NeedsInput {
+		t.Fatalf("Whirlwind did not consume the decision: result=%+v err=%v", gcd, err)
+	}
+	queued, err := env.ApplyPostGCDQueue(cleave)
+	if err != nil || queued.Casted || queued.ConsumesDecision || queued.NeedsInput {
+		t.Fatalf("post-GCD Cleave queue was not rejected: result=%+v err=%v", queued, err)
+	}
+	if env.State().TimeMS != before {
+		t.Fatalf("post-GCD queue advanced time: %d -> %d", before, env.State().TimeMS)
+	}
+	if _, err := env.ApplyPostGCDQueue(cleave); err == nil {
+		t.Fatal("second post-GCD queue reused the same GCD window")
+	}
+}
+
+func TestCleaveQueuedBeforeWhirlwindSurvivesRejectedRecastAndNextSwing(t *testing.T) {
+	request := testWarriorRequest()
+	second := *request.Encounter.Targets[0]
+	second.Stats = append([]float64(nil), second.Stats...)
+	request.Encounter.Targets = append(request.Encounter.Targets, &second)
+	env := newTestWarriorEnvironment(t, request)
+	character := env.player().GetCharacter()
+	_, whirlwind := requireSpellAction(t, env, 0, 1680)
+	_, cleave := requireSpellAction(t, env, 1, 20569)
+	queuedSwing := character.GetSpell(core.ActionID{SpellID: cleave.SpellID})
+	if queuedSwing == nil {
+		t.Fatal("Cleave swing replacement is not registered")
+	}
+	deadline := character.AutoAttacks.NextMHSwingAt()
+	before := queuedCancelCastCount(queuedSwing)
+	queued, err := env.Apply(cleave)
+	if err != nil || !queued.Casted || queued.ConsumesDecision {
+		t.Fatalf("pre-GCD Cleave queue was not submitted: result=%+v err=%v", queued, err)
+	}
+	advanceUntilQueueAura(t, env, cleave)
+	if !hasQueueAura(env.State(), cleave) {
+		t.Fatal("pre-GCD Cleave queue aura did not activate")
+	}
+	remaining := deadline - env.sim.CurrentTime - 300*time.Millisecond
+	if remaining <= 0 {
+		t.Fatalf("queue acceptance overtook MH window: remaining=%s", remaining)
+	}
+	if err := env.Wait(remaining); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if !hasQueueAura(env.State(), cleave) {
+		t.Fatal("Cleave queue vanished before Whirlwind")
+	}
+	gcd, err := env.ApplyWithAttemptID(whirlwind, "queued-cleave-before-ww")
+	if err != nil || !gcd.Casted || !gcd.ConsumesDecision {
+		t.Fatalf("Whirlwind was not accepted with Cleave queued: result=%+v err=%v", gcd, err)
+	}
+	if !hasQueueAura(env.State(), cleave) {
+		t.Fatal("Whirlwind cleared the previously accepted Cleave queue")
+	}
+	recast, err := env.ApplyPostGCDQueue(cleave)
+	if err != nil || recast.Casted || recast.ConsumesDecision {
+		t.Fatalf("same-key Cleave recast was not rejected: result=%+v err=%v", recast, err)
+	}
+	if !hasQueueAura(env.State(), cleave) {
+		t.Fatal("rejected recast cleared the previously accepted Cleave queue")
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if got := queuedCancelCastCount(queuedSwing); got != before+1 {
+		t.Fatalf("old Cleave queue did not produce the next MH swing: got %d want %d", got, before+1)
+	}
+}
