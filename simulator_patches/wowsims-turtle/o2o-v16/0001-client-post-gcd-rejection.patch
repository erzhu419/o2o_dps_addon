-		return ApplyResult{}, errors.New("post-GCD queue action is absent or not externally triggerable")
-	}
-	if env.dynamic != nil && (character.CurrentTarget == nil || !env.sim.Encounter.DynamicTargetUnitIsAttackable(character.CurrentTarget)) {
-		return ApplyResult{NeedsInput: false}, nil
-	}
-	if !spell.CanCast(env.sim, character.CurrentTarget) {
