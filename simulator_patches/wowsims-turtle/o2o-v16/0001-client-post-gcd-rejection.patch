+// ApplyPostGCDQueue records a next-swing attempt after a consuming GCD in the
+// same source invocation. The client probe rejected Whirlwind -> Cleave; the
+// command must not fabricate an accepted queue or clear a previously queued
+// Cleave that survives the GCD.
+func (env *Environment) ApplyPostGCDQueue(ref ActionRef) (ApplyResult, error) {
+	if env.finished || !env.postGCDQueueReady || env.sim.NeedsInput || env.sim.CurrentTime != env.postGCDQueueTime {
+		return ApplyResult{}, errors.New("post-GCD queue requires the preceding unadvanced GCD decision")
+	}
+	env.postGCDQueueReady = false
+	if ref.Tag != 1 || ref.ItemID != 0 || ref.OtherID != proto.OtherAction_OtherActionNone ||
+		(ref.SpellID != 25286 && ref.SpellID != 11567 && ref.SpellID != 20569) {
+		return ApplyResult{}, errors.New("post-GCD action must be Heroic Strike or Cleave queue")
+	}
+	return ApplyResult{Casted: false, ConsumesDecision: false, Finished: env.finished, NeedsInput: false}, nil
 }
 
