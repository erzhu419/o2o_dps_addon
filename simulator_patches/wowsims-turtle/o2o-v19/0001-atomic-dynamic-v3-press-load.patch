+func TestRunBridgeAtomicDynamicV3PressClockKeepsInitialNoTargetTicks(t *testing.T) {
+	const health = 1_000_000.0
+	config := o2o.DynamicTargetSemanticsConfigV3{
+		Schema:                 o2o.DynamicTargetSemanticsSchemaV3,
+		TargetHealth:           []o2o.DynamicTargetHealthV1{{TargetIndex: 0, Health: health}},
+		BackgroundDamageEvents: []o2o.BackgroundDamageEventV1{},
+		AttackabilityEvents: []o2o.DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 100, TargetIndex: 0, Attackable: true},
+		},
+		EffectiveArmorEvents: []o2o.DynamicEffectiveArmorEventV2{},
+		IdleAdvanceMode:      o2o.DynamicIdleAdvanceModeV3,
+		IdleAdvanceHorizonMS: 300_000,
+		SameTimestampOrder:   o2o.DynamicSameTimestampOrderV3,
+		RetargetMode:         o2o.DynamicRetargetNextAliveCyclic,
+	}
+	digest, err := o2o.DynamicTargetSemanticsDigestV3(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.ContentSHA256 = digest
+	dynamic, err := json.Marshal(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	commands := []command{
+		{Command: "load_dynamic_v3_press_clock", Request: bridgeDynamicTestRequest(t, health), Seed: 19,
+			Dynamic: dynamic, PressPeriodMS: 50, PressPhaseMS: 0},
+		{Command: "finish_press"},
+		{Command: "advance"},
+		{Command: "finish_press"},
+		{Command: "advance"},
+		{Command: "dynamic_idle_advance_receipts", Cursor: 0},
+		{Command: "close"},
+	}
+	var input bytes.Buffer
+	for _, cmd := range commands {
+		if err := json.NewEncoder(&input).Encode(cmd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var output bytes.Buffer
+	var stderr bytes.Buffer
+	runBridge(&input, &output, &stderr)
+	if stderr.Len() != 0 {
+		t.Fatalf("bridge stderr: %s", stderr.String())
+	}
+	responses := make([]response, 0, len(commands))
+	decoder := json.NewDecoder(&output)
+	for decoder.More() {
+		var row response
+		if err := decoder.Decode(&row); err != nil {
+			t.Fatal(err)
+		}
+		responses = append(responses, row)
+	}
+	if len(responses) != len(commands) {
+		t.Fatalf("got %d bridge responses, want %d", len(responses), len(commands))
+	}
+	for index, row := range responses {
+		if !row.OK {
+			t.Fatalf("command %d failed: %s", index, row.Error)
+		}
+	}
+	load := responses[0]
+	if load.DynamicLoad == nil || load.EnvironmentGeneration == nil ||
+		load.DynamicLoad.ConfigDigest != digest ||
+		load.DynamicLoad.EnvironmentGeneration != *load.EnvironmentGeneration {
+		t.Fatalf("atomic load did not bind dynamic config and press clock together: %+v", load)
+	}
+	for index, expected := range []struct {
+		responseIndex int
+		timeMS        int64
+		pressIndex    int64
+		targets       int
+	}{
+		{0, 0, 1, 0},
+		{2, 50, 2, 0},
+		{4, 100, 3, 1},
+	} {
+		state := responses[expected.responseIndex].State
+		if state == nil || state.TimeMS != expected.timeMS || !state.NeedsInput ||
+			state.NumTargets != expected.targets || state.PressClock == nil ||
+			!state.PressClock.Ready || state.PressClock.PressIndex != expected.pressIndex {
+			t.Fatalf("physical tick %d is wrong: %+v", index+1, state)
+		}
+	}
+	idle := responses[5].DynamicIdleAdvanceReceipts
+	if idle == nil || idle.NextCursor != 0 || len(idle.Receipts) != 0 {
+		t.Fatalf("atomic press load entered default dynamic idle: %+v", idle)
+	}
+}
