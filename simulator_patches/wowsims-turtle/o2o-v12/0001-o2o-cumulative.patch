+func TestServerResultsAreMetricDerivedAndAttemptBound(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		outcome meleeAvoidance
+		want    string
+	}{
+		{name: "hit", want: "HIT"},
+		{name: "miss", outcome: meleeMiss, want: "MISS"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			env := newTestWarriorEnvironment(t, testWarriorAvoidanceRequest())
+			spell, action := requireSpellAction(t, env, 0, 23894)
+			character := env.player().GetCharacter()
+			target := character.CurrentTarget
+			if tc.outcome != "" {
+				forceMeleeAvoidance(t, env, spell, tc.outcome)
+			} else {
+				attackTable := character.AttackTables[target.UnitIndex][spell.CastType]
+				character.PseudoStats.InFrontOfTarget = false
+				attackTable.BaseMissChance = 0
+				attackTable.BaseDodgeChance = 0
+				attackTable.BaseParryChance = 0
+				spell.BonusCritRating = -10000
+			}
+
+			accepted, err := env.ApplyWithAttemptID(action, "decision-1:sink-1")
+			if err != nil || !accepted.Casted {
+				t.Fatalf("Bloodthirst was not accepted: result=%+v error=%v", accepted, err)
+			}
+			if _, err := env.AdvanceUntilDecision(); err != nil {
+				t.Fatal(err)
+			}
+			// Acceptance alone does not expose an outcome. A mismatched ledger
+			// request fails and leaves the pending metric snapshot available.
+			if _, err := env.ServerResultsSinceLastDecision([]string{"unknown-attempt"}); err == nil {
+				t.Fatal("missing attempt ID was accepted for a pending result")
+			}
+			batch, err := env.ServerResultsSinceLastDecision([]string{"decision-1:sink-1"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if batch.CompleteThroughTimeMS != env.State().TimeMS || len(batch.Events) != 1 || len(batch.PendingAttemptIDs) != 0 {
+				t.Fatalf("unexpected result batch: %+v", batch)
+			}
+			event := batch.Events[0]
+			if event.AttemptID != "decision-1:sink-1" || event.Action != action || event.Outcome != tc.want {
+				t.Fatalf("unexpected typed event: %+v", event)
+			}
+			if tc.want == "HIT" && event.Damage <= 0 {
+				t.Fatalf("hit event lacks metric-derived damage: %+v", event)
+			}
+			if tc.want == "MISS" && event.Damage != 0 {
+				t.Fatalf("miss event has damage: %+v", event)
+			}
+			if len(event.TargetResults) != 1 ||
+				event.TargetResults[0].TargetIndex != int32(target.UnitIndex) ||
+				event.TargetResults[0].Outcome != tc.want ||
+				event.TargetResults[0].Damage != event.Damage {
+				t.Fatalf("single-target evidence does not match aggregate: %+v", event)
+			}
+			empty, err := env.ServerResultsSinceLastDecision(nil)
+			if err != nil || len(empty.Events) != 0 {
+				t.Fatalf("drained result stream was not empty: result=%+v error=%v", empty, err)
+			}
+		})
+	}
+}
