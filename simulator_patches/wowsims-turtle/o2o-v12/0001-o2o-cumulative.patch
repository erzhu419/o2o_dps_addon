+func TestLegacyEnvironmentWireStateDoesNotGainDynamicFields(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	wire, err := json.Marshal(env.State())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, forbidden := range []string{"dynamic_team_background", "environment_generation", "config_digest", "target_health_rows", "total_target_count"} {
+		if strings.Contains(string(wire), forbidden) {
+			t.Fatalf("legacy state gained opt-in dynamic field %q: %s", forbidden, wire)
+		}
+	}
+}
