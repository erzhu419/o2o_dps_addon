+func requireSpellAction(t *testing.T, env *Environment, tag int32, spellIDs ...int32) (*core.Spell, ActionRef) {
+	t.Helper()
+	for _, action := range env.AvailableActions() {
+		if action.Action.Tag != tag {
+			continue
+		}
+		for _, spellID := range spellIDs {
+			if action.Action.SpellID != spellID {
+				continue
+			}
+			spell := env.player().GetCharacter().GetSpell(action.Action.coreID())
+			if spell == nil {
+				t.Fatalf("spell action was exported but not registered: %+v", action.Action)
+			}
+			return spell, action.Action
+		}
+	}
+	t.Fatalf("spell action not found: tag=%d spell_ids=%v", tag, spellIDs)
+	return nil, ActionRef{}
+}
+
+func forceMeleeAvoidance(t *testing.T, env *Environment, spell *core.Spell, outcome meleeAvoidance) {
+	t.Helper()
+	character := env.player().GetCharacter()
+	target := character.CurrentTarget
+	attackTable := character.AttackTables[target.UnitIndex][spell.CastType]
+	if attackTable == nil {
+		t.Fatalf("attack table not found for %s", spell.ActionID)
+	}
+
+	character.PseudoStats.InFrontOfTarget = outcome == meleeParry
+	attackTable.BaseMissChance = 0
+	attackTable.BaseDodgeChance = 0
+	attackTable.BaseParryChance = 0
+	switch outcome {
+	case meleeMiss:
+		attackTable.BaseMissChance = 10
+	case meleeDodge:
+		attackTable.BaseDodgeChance = 10
+	case meleeParry:
+		attackTable.BaseParryChance = 10
+	default:
+		t.Fatalf("unsupported melee avoidance: %q", outcome)
+	}
+}
+
+func assertMeleeAvoidance(t *testing.T, env *Environment, spell *core.Spell, outcome meleeAvoidance) {
+	t.Helper()
+	metrics := spell.SpellMetrics[env.player().GetCharacter().CurrentTarget.UnitIndex]
+	var got int32
+	switch outcome {
+	case meleeMiss:
+		got = metrics.Misses
+	case meleeDodge:
+		got = metrics.Dodges
+	case meleeParry:
+		got = metrics.Parries
+	}
+	if got != 1 {
+		t.Fatalf("%s outcome count for %s: got %d, want 1 (metrics=%+v)", outcome, spell.ActionID, got, metrics)
+	}
+}
