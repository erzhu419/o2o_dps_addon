+func findAvailableSpell(env *Environment, spellID int32) (ActionRef, bool) {
+	for _, action := range env.AvailableActions() {
+		if action.Action.SpellID == spellID && action.Action.Tag == 0 {
+			return action.Action, action.Legal
+		}
+	}
+	return ActionRef{}, false
+}
