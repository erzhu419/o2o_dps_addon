diff --git a/cmd/o2obridge/dynamic_v3_test.go b/cmd/o2obridge/dynamic_v3_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c3e2d17b7fe3ec5d50e7798a725e1dd24a040a00
--- /dev/null
+++ b/cmd/o2obridge/dynamic_v3_test.go
@@ -0,0 +1,123 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/o2o"
+)
+
+func TestRunBridgeDynamicV3CentrallyAdvancesAndBindsIdleReceipt(t *testing.T) {
+	const health = 1_000_000.0
+	request := bridgeDynamicTestRequest(t, health)
+	config := o2o.DynamicTargetSemanticsConfigV3{
+		Schema:       o2o.DynamicTargetSemanticsSchemaV3,
+		TargetHealth: []o2o.DynamicTargetHealthV1{{TargetIndex: 0, Health: health}},
+		BackgroundDamageEvents: []o2o.BackgroundDamageEventV1{
+			{ScheduleIndex: 0, TimeMS: 50, TargetIndex: 0, EventID: "blocked", Damage: 100},
+		},
+		AttackabilityEvents: []o2o.DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 100, TargetIndex: 0, Attackable: true},
+		},
+		EffectiveArmorEvents: []o2o.DynamicEffectiveArmorEventV2{
+			{ScheduleIndex: 0, TimeMS: 25, TargetIndex: 0, EffectiveArmor: 1234},
+		},
+		IdleAdvanceMode:      o2o.DynamicIdleAdvanceModeV3,
+		IdleAdvanceHorizonMS: 300_000,
+		SameTimestampOrder:   o2o.DynamicSameTimestampOrderV3,
+		RetargetMode:         o2o.DynamicRetargetNextAliveCyclic,
+	}
+	digest, err := o2o.DynamicTargetSemanticsDigestV3(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.ContentSHA256 = digest
+	dynamicPayload, err := json.Marshal(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	commands := []command{
+		{Command: "load_dynamic_v3", Request: request, Seed: 77, Dynamic: dynamicPayload},
+		{Command: "dynamic_idle_advance_receipts", Cursor: 0},
+		{Command: "dynamic_attackability_receipts", Cursor: 0},
+		{Command: "dynamic_armor_receipts", Cursor: 0},
+		{Command: "dynamic_damage_receipts", Cursor: 0},
+		{Command: "close"},
+	}
+	var input bytes.Buffer
+	encoder := json.NewEncoder(&input)
+	for _, cmd := range commands {
+		if err := encoder.Encode(cmd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var output bytes.Buffer
+	var stderr bytes.Buffer
+	runBridge(&input, &output, &stderr)
+	if stderr.Len() != 0 {
+		t.Fatalf("bridge stderr: %s", stderr.String())
+	}
+	decoder := json.NewDecoder(&output)
+	responses := make([]response, 0, len(commands))
+	for decoder.More() {
+		var got response
+		if err := decoder.Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		responses = append(responses, got)
+	}
+	if len(responses) != len(commands) {
+		t.Fatalf("got %d responses, want %d: %s", len(responses), len(commands), output.String())
+	}
+	load := responses[0]
+	if !load.OK || load.State == nil || load.DynamicLoad == nil || load.State.TimeMS != 100 ||
+		!load.State.NeedsInput || load.State.DynamicIdleAdvance == nil || load.State.DynamicIdleAdvance.Active ||
+		load.DynamicLoad.Schema != o2o.DynamicTargetSemanticsSchemaV3 || load.DynamicLoad.ConfigDigest != digest ||
+		load.DynamicLoad.IdleAdvanceMode == nil || *load.DynamicLoad.IdleAdvanceMode != o2o.DynamicIdleAdvanceModeV3 ||
+		load.DynamicLoad.IdleAdvanceHorizonMS == nil || *load.DynamicLoad.IdleAdvanceHorizonMS != 300_000 {
+		t.Fatalf("dynamic-v3 load did not auto-advance with an exact binding: %+v", load)
+	}
+	idle := responses[1].DynamicIdleAdvanceReceipts
+	if !responses[1].OK || idle == nil || idle.ConfigDigest != digest || idle.EnvironmentGeneration != 1 ||
+		idle.NextCursor != 1 || len(idle.Receipts) != 1 || idle.Receipts[0].Status != o2o.DynamicIdleAdvanceAttackabilityRestored ||
+		idle.Receipts[0].PolicyActionsConsumed != 0 || idle.Receipts[0].PolicyTargetSelections != 0 ||
+		idle.Receipts[0].SchedulerRandomDraws != 0 {
+		t.Fatalf("dynamic-v3 idle receipt is wrong: %+v", responses[1])
+	}
+	attack := responses[2].DynamicAttackabilityReceipts
+	if !responses[2].OK || attack == nil || attack.Schema != o2o.DynamicTargetSemanticsSchemaV3 ||
+		attack.ConfigDigest != digest || !attack.ScheduleComplete || len(attack.Receipts) != 2 {
+		t.Fatalf("attackability receipts lost v3 binding: %+v", responses[2])
+	}
+	armor := responses[3].DynamicArmorReceipts
+	if !responses[3].OK || armor == nil || armor.Schema != o2o.DynamicTargetSemanticsSchemaV3 ||
+		armor.ConfigDigest != digest || !armor.ScheduleComplete || len(armor.Receipts) != 1 {
+		t.Fatalf("armor receipts lost v3 binding: %+v", responses[3])
+	}
+	background := responses[4].DynamicDamageReceipts
+	if !responses[4].OK || background == nil || background.Schema != o2o.DynamicTargetSemanticsSchemaV3 ||
+		background.ConfigDigest != digest || len(background.Receipts) != 1 ||
+		background.Receipts[0].Status != o2o.DynamicDamageCanceledTargetUnattackable {
+		t.Fatalf("background receipts lost v3 binding/cancellation: %+v", responses[4])
+	}
+}
+
+func TestRunBridgeDynamicV3RejectsUnknownConfigFields(t *testing.T) {
+	payload := `{"command":"load_dynamic_v3","dynamic":{"schema":"o2o_dynamic_target_semantics/v3","unknown_field":true}}`
+	var output bytes.Buffer
+	var stderr bytes.Buffer
+	runBridge(bytes.NewBufferString(payload+"\n"), &output, &stderr)
+	if stderr.Len() != 0 {
+		t.Fatalf("bridge stderr: %s", stderr.String())
+	}
+	var got response
+	if err := json.Unmarshal(output.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.OK || !strings.Contains(got.Error, "unknown field") {
+		t.Fatalf("dynamic-v3 did not fail closed: %+v", got)
+	}
+}
diff --git a/cmd/o2obridge/main.go b/cmd/o2obridge/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..109124dfc4c985d793c33f98205a595ed092acd7
