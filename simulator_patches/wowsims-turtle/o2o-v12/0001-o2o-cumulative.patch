+func TestServerResultTargetDeltasAreStrictAndDeterministic(t *testing.T) {
+	before := make([]core.SpellMetrics, 3)
+	after := make([]core.SpellMetrics, 3)
+	after[0].Casts = 1
+	after[0].Hits = 1
+	after[0].TotalDamage = 10
+	after[2].Hits = 1
+	after[2].TotalDamage = 20
+
+	outcome, damage, targetResults, err := deriveServerResult(before, after, 3)
