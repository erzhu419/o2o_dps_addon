+func TestDynamicDeadTargetSelectionConsumesNoWeaponOrOutcomeRNG(t *testing.T) {
+	health := []float64{1, 10_000}
+	config := boundDynamicConfig(t, DynamicRetargetRequireExplicit, health, []BackgroundDamageEventV1{
+		{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, EventID: "dead-before-auto-selection", Damage: 1},
+	})
+	newBranch := func(cancelAutoBeforeAdvance bool) *Environment {
+		env, _, err := NewDynamicV1(dynamicRequest(health...), 246, config, 7)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(env.Cleanup)
+		if cancelAutoBeforeAdvance {
+			env.player().GetCharacter().AutoAttacks.CancelAutoSwing(env.sim)
+		}
+		if _, err := env.AdvanceUntilDecision(); err != nil {
+			t.Fatal(err)
+		}
+		return env
+	}
+
+	// The candidate branch reaches a pull-time auto selection after background
+	// damage has killed target 0.  The control branch suppresses that selection.
+	// Their next live result must therefore be bit-identical if the rejected
+	// dead selection consumed neither weapon nor outcome RNG.
+	candidate := newBranch(false)
+	control := newBranch(true)
+	for _, env := range []*Environment{candidate, control} {
+		state := env.State()
+		if state.DynamicTeamBackground == nil || !state.DynamicTeamBackground.RetargetRequired {
+			t.Fatalf("explicit retarget was not required after pull-time death: %+v", state)
+		}
+		if changed, err := env.SetTarget(1); err != nil || !changed.Changed {
+			t.Fatalf("failed to select the living target: changed=%+v err=%v", changed, err)
+		}
+		mh := env.player().GetCharacter().AutoAttacks.MHAuto()
+		mh.ApplyEffects(env.sim, env.player().GetCharacter().CurrentTarget, mh)
+		if err := env.Wait(core.SpellBatchWindow + time.Millisecond); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := env.AdvanceUntilDecision(); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	candidateBatch, err := candidate.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	controlBatch, err := control.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(candidateBatch.Receipts) != 1 || len(controlBatch.Receipts) != 1 {
+		t.Fatalf("dead selection emitted a candidate receipt: candidate=%+v control=%+v", candidateBatch, controlBatch)
+	}
+	got, want := candidateBatch.Receipts[0], controlBatch.Receipts[0]
+	if got.TargetIndex != 1 || got.Outcome != want.Outcome ||
+		math.Float64bits(got.RequestedDamage) != math.Float64bits(want.RequestedDamage) {
+		t.Fatalf("dead selection advanced weapon/outcome RNG: candidate=%+v control=%+v", got, want)
+	}
+}
