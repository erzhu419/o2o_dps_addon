+func TestDynamicExecuteAndExplicitRetargetUseCurrentTargetHealth(t *testing.T) {
+	health := []float64{100, 900}
+	config := boundDynamicConfig(t, DynamicRetargetRequireExplicit, health, []BackgroundDamageEventV1{
+		{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, EventID: "execute-window", Damage: 85},
+	})
+	env := newDynamicTestEnvironment(t, dynamicRequest(health...), config)
+	state := env.State()
+	if !state.ExecutePhase20 || state.DynamicTeamBackground == nil || state.DynamicTeamBackground.RetargetRequired {
+		t.Fatalf("execute phase did not follow current target health: %+v", state)
+	}
+
+	_, execute := requireSpellAction(t, env, 0, 20662)
+	available := false
+	for _, action := range env.AvailableActions() {
+		if action.Action == execute {
+			available = action.Legal
+		}
+	}
+	if !available {
+		t.Fatal("Execute is not legal on a current target below 20 percent")
+	}
+
+	// Kill the current target through the bridge damage application path. In
+	// REQUIRE_EXPLICIT mode no implicit target switch is allowed.
+	application, err := env.sim.Encounter.ApplyTargetDamage(env.sim, env.sim.Encounter.TargetUnits[0], 15, core.TargetDamageSourceBackground)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !application.Killed {
+		t.Fatalf("synthetic target kill failed: %+v", application)
+	}
+	env.onDynamicTargetKilledV1(env.sim, env.sim.Encounter.TargetUnits[0], false)
+	state = env.State()
+	if !state.DynamicTeamBackground.RetargetRequired || state.TargetIndex != 0 {
+		t.Fatalf("explicit retarget mode switched targets implicitly: %+v", state)
+	}
+	if _, err := env.ApplyWithAttemptID(execute, "dead-target"); err == nil || !strings.Contains(err.Error(), "current target is dead") {
+		t.Fatalf("dead current target accepted an action: %v", err)
+	}
+	if _, err := env.SetTarget(0); err == nil || !strings.Contains(err.Error(), "target is dead") {
+		t.Fatalf("SetTarget accepted a dead target: %v", err)
+	}
+	changed, err := env.SetTarget(1)
+	if err != nil || !changed.Changed || env.State().DynamicTeamBackground.RetargetRequired {
+		t.Fatalf("explicit retarget did not recover: result=%+v err=%v state=%+v", changed, err, env.State())
+	}
+}
+
+func TestDynamicBackgroundDeathCancelsTargetedHardcastAttempt(t *testing.T) {
+	request := turtleSlamRequest()
+	request.Encounter.UseHealth = true
+	request.Encounter.Targets[0].Stats[stats.Health] = 100_000
+	second := googleProto.Clone(request.Encounter.Targets[0]).(*proto.Target)
+	second.Stats[stats.Health] = 10_000
+	request.Encounter.Targets = append(request.Encounter.Targets, second)
+	config := boundDynamicConfig(t, DynamicRetargetNextAliveCyclic, []float64{100_000, 10_000}, []BackgroundDamageEventV1{
+		{ScheduleIndex: 0, TimeMS: 100, TargetIndex: 0, EventID: "interrupt-slam", Damage: 100_000},
+	})
+	env := newDynamicTestEnvironment(t, request, config)
+	env.player().GetCharacter().AutoAttacks.CancelAutoSwing(env.sim)
+	_, slam := requireSpellAction(t, env, 0, turtleSlamSpellID)
+	accepted, err := env.ApplyWithAttemptID(slam, "slam-killed-target")
+	if err != nil || !accepted.Casted || env.State().CurrentCast == nil {
+		t.Fatalf("Slam was not accepted as a hardcast: result=%+v err=%v", accepted, err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if env.State().TargetIndex != 1 || env.State().CurrentCast != nil {
+		t.Fatalf("target death did not cancel hardcast and retarget: %+v", env.State())
+	}
+	batch, err := env.ServerResultsSinceLastDecision([]string{"slam-killed-target"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(batch.Events) != 1 || batch.Events[0].Outcome != "CANCELED" || batch.Events[0].TimeMS != 100 || batch.Events[0].Damage != 0 || len(batch.Events[0].TargetResults) != 0 {
+		t.Fatalf("hardcast cancellation lost attempt binding: %+v", batch)
+	}
+}
