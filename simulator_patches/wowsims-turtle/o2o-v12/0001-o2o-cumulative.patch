+func TestServerResultAggregatesMultiTargetOutcomesWithoutFabrication(t *testing.T) {
+	before := make([]core.SpellMetrics, 2)
+	after := make([]core.SpellMetrics, 2)
+	after[0].Casts = 1
+	after[0].Hits = 1
+	after[0].TotalDamage = 100
+	after[1].Crits = 1
+	after[1].TotalDamage = 250
+
+	outcome, damage, targetResults, err := deriveServerResult(before, after, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if outcome != "MIXED" || damage != 350 {
+		t.Fatalf("unexpected aggregate result: outcome=%s damage=%f", outcome, damage)
+	}
+	if len(targetResults) != 2 ||
+		targetResults[0] != (ServerTargetResult{TargetIndex: 0, Outcome: "HIT", Damage: 100}) ||
+		targetResults[1] != (ServerTargetResult{TargetIndex: 1, Outcome: "CRIT", Damage: 250}) {
+		t.Fatalf("unexpected deterministic target results: %+v", targetResults)
+	}
+	if targetResults[0].Damage+targetResults[1].Damage != damage {
+		t.Fatalf("target damage does not equal aggregate: targets=%+v aggregate=%f", targetResults, damage)
+	}
+
+	withoutOutcome := make([]core.SpellMetrics, 1)
+	withoutOutcome[0].Casts = 1
+	if _, _, _, err := deriveServerResult(make([]core.SpellMetrics, 1), withoutOutcome, 1); err == nil {
+		t.Fatal("completed cast without outcome metrics was promoted to a result")
+	}
+}
