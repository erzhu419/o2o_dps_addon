+	Health      float64 `json:"health"`
+}
+
+type BackgroundDamageEventV1 struct {
+	ScheduleIndex int     `json:"schedule_index"`
+	TimeMS        int64   `json:"time_ms"`
+	TargetIndex   int32   `json:"target_index"`
+	EventID       string  `json:"event_id"`
+	Damage        float64 `json:"damage"`
+}
+
+type DynamicTeamBackgroundConfigV1 struct {
+	Schema                 string                    `json:"schema"`
+	ContentSHA256          string                    `json:"content_sha256"`
+	TargetHealth           []DynamicTargetHealthV1   `json:"target_health"`
+	BackgroundDamageEvents []BackgroundDamageEventV1 `json:"background_damage_events"`
+	SameTimestampOrder     string                    `json:"same_timestamp_order"`
+	RetargetMode           DynamicRetargetMode       `json:"retarget_mode"`
+}
+
+type DynamicLoadReceiptV1 struct {
+	Schema                   string              `json:"schema"`
+	ConfigDigest             string              `json:"config_digest"`
+	EnvironmentGeneration    uint64              `json:"environment_generation"`
+	TargetCount              int                 `json:"target_count"`
+	BackgroundEventCount     int                 `json:"background_event_count"`
+	SameTimestampOrder       string              `json:"same_timestamp_order"`
+	RetargetMode             DynamicRetargetMode `json:"retarget_mode"`
+	AttackabilityEventCount  *int                `json:"attackability_event_count,omitempty"`
+	EffectiveArmorEventCount *int                `json:"effective_armor_event_count,omitempty"`
+	IdleAdvanceMode          *string             `json:"idle_advance_mode,omitempty"`
+	IdleAdvanceHorizonMS     *int64              `json:"idle_advance_horizon_ms,omitempty"`
+	IdleAdvanceReceiptSchema *string             `json:"idle_advance_receipt_schema,omitempty"`
+}
+
+type DynamicTargetStateV1 struct {
+	TargetIndex             int32   `json:"target_index"`
+	InitialHealth           float64 `json:"initial_health"`
+	CurrentHealth           float64 `json:"current_health"`
+	Dead                    bool    `json:"dead"`
+	DeathTimeMS             *int64  `json:"death_time_ms,omitempty"`
+	SimulatedDamageApplied  float64 `json:"simulated_damage_applied"`
+	BackgroundDamageApplied float64 `json:"background_damage_applied"`
+}
+
+type DynamicTeamBackgroundStateV1 struct {
+	Schema                    string                 `json:"schema"`
+	ConfigDigest              string                 `json:"config_digest"`
+	EnvironmentGeneration     uint64                 `json:"environment_generation"`
+	SameTimestampOrder        string                 `json:"same_timestamp_order"`
+	RetargetMode              DynamicRetargetMode    `json:"retarget_mode"`
+	RetargetRequired          bool                   `json:"retarget_required"`
+	SimulatedDamageApplied    float64                `json:"simulated_damage_applied"`
+	BackgroundDamageApplied   float64                `json:"background_damage_applied"`
+	CombinedDamageApplied     float64                `json:"combined_damage_applied"`
+	BackgroundEventsProcessed int                    `json:"background_events_processed"`
+	BackgroundEventsTotal     int                    `json:"background_events_total"`
+	BackgroundEventsCanceled  int                    `json:"background_events_canceled"`
+	CandidateEventsProcessed  int                    `json:"candidate_events_processed"`
+	CandidateEventsCanceled   int                    `json:"candidate_events_canceled"`
+	DamageApplicationsTotal   uint64                 `json:"damage_applications_total"`
+	Targets                   []DynamicTargetStateV1 `json:"targets"`
+}
+
+type DynamicDamageReceiptV1 struct {
+	DamageOrdinal   uint64  `json:"damage_ordinal,omitempty"`
+	ScheduleIndex   int     `json:"schedule_index"`
+	EventID         string  `json:"event_id"`
+	TimeMS          int64   `json:"time_ms"`
+	TargetIndex     int32   `json:"target_index"`
+	RequestedDamage float64 `json:"requested_damage"`
+	AppliedDamage   float64 `json:"applied_damage"`
+	OverkillDamage  float64 `json:"overkill_damage"`
+	Killed          bool    `json:"killed"`
+	Status          string  `json:"status"`
+	RetargetedTo    *int32  `json:"retargeted_to,omitempty"`
+}
+
+// DynamicCandidateDamageReceiptV1 is the non-draining audit row for every
+// candidate simulator damage application. DamageOrdinal shares the core
+// encounter counter with background receipts, making equal-timestamp source
+// order explicit instead of depending on JSON query order.
+type DynamicCandidateDamageReceiptV1 struct {
+	DamageOrdinal        uint64    `json:"damage_ordinal"`
+	TimeMS               int64     `json:"time_ms"`
+	TargetIndex          int32     `json:"target_index"`
+	RequestedDamage      float64   `json:"requested_damage"`
+	AppliedDamage        float64   `json:"applied_damage"`
+	OverkillDamage       float64   `json:"overkill_damage"`
+	Killed               bool      `json:"killed"`
+	Status               string    `json:"status"`
+	Action               ActionRef `json:"action"`
+	Outcome              string    `json:"outcome"`
+	ExecutionID          uint64    `json:"execution_id"`
+	ExecutionIndex       int32     `json:"execution_index"`
+	LandedExecutionIndex int32     `json:"landed_execution_index"`
+	AttemptID            string    `json:"attempt_id,omitempty"`
+	RetargetedTo         *int32    `json:"retargeted_to,omitempty"`
+	ResolutionPhase      string    `json:"resolution_phase"`
+	OutcomeComputed      bool      `json:"outcome_computed"`
+	RandomStreamRewound  bool      `json:"random_stream_rewound"`
+}
+
+type DynamicCandidateDamageReceiptBatchV1 struct {
+	Schema                string                            `json:"schema"`
+	ConfigDigest          string                            `json:"config_digest"`
+	EnvironmentGeneration uint64                            `json:"environment_generation"`
+	Cursor                int                               `json:"cursor"`
+	NextCursor            int                               `json:"next_cursor"`
+	Receipts              []DynamicCandidateDamageReceiptV1 `json:"receipts"`
+}
+
+type DynamicDamageReceiptBatchV1 struct {
+	Schema                string                   `json:"schema"`
+	ConfigDigest          string                   `json:"config_digest"`
+	EnvironmentGeneration uint64                   `json:"environment_generation"`
+	Cursor                int                      `json:"cursor"`
+	NextCursor            int                      `json:"next_cursor"`
+	ScheduleComplete      bool                     `json:"schedule_complete"`
+	Receipts              []DynamicDamageReceiptV1 `json:"receipts"`
+}
+
+type scheduledDynamicBackgroundV1 struct {
+	event  BackgroundDamageEventV1
+	action *core.PendingAction
+}
+
+type dynamicTeamBackgroundRuntimeV1 struct {
+	config             DynamicTeamBackgroundConfigV1
+	bindingSchema      string
+	bindingDigest      string
+	sameTimestampOrder string
+	generation         uint64
+	scheduled          []scheduledDynamicBackgroundV1
+	nextEvent          int
+	receipts           []DynamicDamageReceiptV1
+	candidateReceipts  []DynamicCandidateDamageReceiptV1
+	retargetRequired   bool
+	retargetAction     *core.PendingAction
+}
+
+var dynamicEventIDPatternV1 = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$`)
+
+// The content digest uses IEEE-754 bits rather than language-specific decimal
+// rendering. The canonical JSON objects below declare fields in lexical order,
+// matching Python's sort_keys=True representation exactly.
+type dynamicDigestTargetV1 struct {
+	HealthIEEE754 string `json:"health_ieee754"`
+	TargetIndex   int32  `json:"target_index"`
+}
+
+type dynamicDigestEventV1 struct {
+	DamageIEEE754 string `json:"damage_ieee754"`
+	EventID       string `json:"event_id"`
+	ScheduleIndex int    `json:"schedule_index"`
+	TargetIndex   int32  `json:"target_index"`
+	TimeMS        int64  `json:"time_ms"`
+}
+
+type dynamicDigestDocumentV1 struct {
+	BackgroundDamageEvents []dynamicDigestEventV1  `json:"background_damage_events"`
+	RetargetMode           DynamicRetargetMode     `json:"retarget_mode"`
+	SameTimestampOrder     string                  `json:"same_timestamp_order"`
+	Schema                 string                  `json:"schema"`
+	TargetHealth           []dynamicDigestTargetV1 `json:"target_health"`
+}
+
+func DynamicTeamBackgroundDigestV1(config DynamicTeamBackgroundConfigV1) (string, error) {
+	if err := validateDynamicConfigV1(config, -1); err != nil {
+		return "", err
+	}
+	document := dynamicDigestDocumentV1{
+		BackgroundDamageEvents: make([]dynamicDigestEventV1, len(config.BackgroundDamageEvents)),
+		RetargetMode:           config.RetargetMode,
+		SameTimestampOrder:     config.SameTimestampOrder,
+		Schema:                 config.Schema,
+		TargetHealth:           make([]dynamicDigestTargetV1, len(config.TargetHealth)),
+	}
+	for index, target := range config.TargetHealth {
+		document.TargetHealth[index] = dynamicDigestTargetV1{
+			HealthIEEE754: fmt.Sprintf("%016x", math.Float64bits(target.Health)),
+			TargetIndex:   target.TargetIndex,
+		}
+	}
+	for index, event := range config.BackgroundDamageEvents {
+		document.BackgroundDamageEvents[index] = dynamicDigestEventV1{
+			DamageIEEE754: fmt.Sprintf("%016x", math.Float64bits(event.Damage)),
+			EventID:       event.EventID,
+			ScheduleIndex: event.ScheduleIndex,
+			TargetIndex:   event.TargetIndex,
+			TimeMS:        event.TimeMS,
+		}
+	}
+	payload, err := json.Marshal(document)
+	if err != nil {
+		return "", fmt.Errorf("marshal dynamic content binding: %w", err)
+	}
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func validateDynamicConfigV1(config DynamicTeamBackgroundConfigV1, requestTargetCount int) error {
+	if config.Schema != DynamicTeamBackgroundSchemaV1 {
+		return fmt.Errorf("dynamic schema must be %q", DynamicTeamBackgroundSchemaV1)
+	}
+	if config.SameTimestampOrder != DynamicSameTimestampOrderV1 {
+		return fmt.Errorf("same_timestamp_order must be %q", DynamicSameTimestampOrderV1)
+	}
+	if config.RetargetMode != DynamicRetargetNextAliveCyclic && config.RetargetMode != DynamicRetargetRequireExplicit {
+		return fmt.Errorf("unsupported retarget_mode %q", config.RetargetMode)
+	}
+	if len(config.TargetHealth) == 0 {
+		return errors.New("target_health must contain at least one target")
+	}
+	if requestTargetCount >= 0 && len(config.TargetHealth) != requestTargetCount {
+		return fmt.Errorf("target_health count %d does not match RaidSimRequest target count %d", len(config.TargetHealth), requestTargetCount)
+	}
+	for index, target := range config.TargetHealth {
+		if target.TargetIndex != int32(index) {
+			return errors.New("target_health must cover target indexes 0..N-1 exactly in ascending order")
+		}
+		if math.IsNaN(target.Health) || math.IsInf(target.Health, 0) || target.Health <= 0 {
+			return fmt.Errorf("target_health[%d].health must be finite and positive", index)
+		}
+	}
+	seenEventIDs := make(map[string]struct{}, len(config.BackgroundDamageEvents))
+	for index, event := range config.BackgroundDamageEvents {
+		if event.ScheduleIndex != index {
+			return errors.New("background_damage_events schedule_index must cover 0..N-1 exactly in list order")
+		}
+		if event.TimeMS < 0 || event.TimeMS > math.MaxInt64/int64(time.Millisecond) {
+			return fmt.Errorf("background_damage_events[%d].time_ms is outside the supported non-negative duration range", index)
+		}
+		if event.TargetIndex < 0 || int(event.TargetIndex) >= len(config.TargetHealth) {
+			return fmt.Errorf("background_damage_events[%d].target_index out of range", index)
+		}
+		if !dynamicEventIDPatternV1.MatchString(event.EventID) {
+			return fmt.Errorf("background_damage_events[%d].event_id is not a safe non-empty identifier", index)
+		}
+		if _, duplicate := seenEventIDs[event.EventID]; duplicate {
+			return fmt.Errorf("duplicate background event_id %q", event.EventID)
+		}
+		seenEventIDs[event.EventID] = struct{}{}
+		if math.IsNaN(event.Damage) || math.IsInf(event.Damage, 0) || event.Damage <= 0 {
+			return fmt.Errorf("background_damage_events[%d].damage must be finite and positive", index)
+		}
+		if index > 0 && config.BackgroundDamageEvents[index-1].TimeMS > event.TimeMS {
+			return errors.New("background_damage_events must be strictly sorted by (time_ms,schedule_index)")
+		}
+	}
+	return nil
+}
+
+func NewDynamicV1(
+	request *proto.RaidSimRequest,
+	seed int64,
+	config DynamicTeamBackgroundConfigV1,
+	generation uint64,
+) (*Environment, DynamicLoadReceiptV1, error) {
+	receipt := DynamicLoadReceiptV1{}
+	if generation == 0 {
+		return nil, receipt, errors.New("environment_generation must be positive")
+	}
+	if request == nil || request.Encounter == nil {
+		return nil, receipt, errors.New("raid, encounter, and sim_options are required")
+	}
+	if err := validateDynamicConfigV1(config, len(request.Encounter.Targets)); err != nil {
+		return nil, receipt, err
+	}
+	for index, target := range config.TargetHealth {
+		requestTarget := request.Encounter.Targets[index]
+		if requestTarget == nil || len(requestTarget.Stats) <= int(stats.Health) {
+			return nil, receipt, fmt.Errorf("RaidSimRequest target %d has no explicit health stat", index)
+		}
+		requestHealth := requestTarget.Stats[stats.Health]
+		if math.Float64bits(requestHealth) != math.Float64bits(target.Health) {
+			return nil, receipt, fmt.Errorf("target_health[%d].health does not match RaidSimRequest target health", index)
+		}
+	}
+	digest, err := DynamicTeamBackgroundDigestV1(config)
+	if err != nil {
+		return nil, receipt, err
+	}
+	if len(config.ContentSHA256) != sha256.Size*2 {
+		return nil, receipt, errors.New("content_sha256 must be 64 lowercase hexadecimal characters")
+	}
+	decodedDigest, decodeErr := hex.DecodeString(config.ContentSHA256)
+	if decodeErr != nil || config.ContentSHA256 != hex.EncodeToString(decodedDigest) {
+		return nil, receipt, errors.New("content_sha256 must be 64 lowercase hexadecimal characters")
+	}
+	if config.ContentSHA256 != digest {
+		return nil, receipt, fmt.Errorf("content_sha256 mismatch: got %s, computed %s", config.ContentSHA256, digest)
+	}
+
+	config.TargetHealth = append([]DynamicTargetHealthV1(nil), config.TargetHealth...)
+	config.BackgroundDamageEvents = append([]BackgroundDamageEventV1(nil), config.BackgroundDamageEvents...)
+	env, err := newEnvironment(request, seed, &config, generation)
+	if err != nil {
+		return nil, receipt, err
+	}
+	receipt = DynamicLoadReceiptV1{
+		Schema:                DynamicTeamBackgroundSchemaV1,
+		ConfigDigest:          digest,
+		EnvironmentGeneration: generation,
+		TargetCount:           len(config.TargetHealth),
+		BackgroundEventCount:  len(config.BackgroundDamageEvents),
+		SameTimestampOrder:    DynamicSameTimestampOrderV1,
+		RetargetMode:          config.RetargetMode,
+	}
+	return env, receipt, nil
+}
+
+func newDynamicTeamBackgroundRuntimeV1(config DynamicTeamBackgroundConfigV1, generation uint64) *dynamicTeamBackgroundRuntimeV1 {
+	return &dynamicTeamBackgroundRuntimeV1{
+		config:             config,
+		bindingSchema:      DynamicTeamBackgroundSchemaV1,
+		bindingDigest:      config.ContentSHA256,
+		sameTimestampOrder: DynamicSameTimestampOrderV1,
+		generation:         generation,
+		scheduled:          make([]scheduledDynamicBackgroundV1, len(config.BackgroundDamageEvents)),
+		receipts:           make([]DynamicDamageReceiptV1, 0, len(config.BackgroundDamageEvents)),
+		candidateReceipts:  make([]DynamicCandidateDamageReceiptV1, 0),
+	}
+}
+
+func (env *Environment) scheduleDynamicBackgroundV1() {
+	for index, event := range env.dynamic.config.BackgroundDamageEvents {
+		index := index
+		event := event
+		action := &core.PendingAction{
+			NextActionAt: time.Duration(event.TimeMS) * time.Millisecond,
+			Priority:     core.ActionPriorityDynamicBackground,
+			OnAction: func(sim *core.Simulation) {
+				env.applyDynamicBackgroundV1(index, event)
+			},
+		}
+		env.dynamic.scheduled[index] = scheduledDynamicBackgroundV1{event: event, action: action}
+		env.sim.AddPendingAction(action)
+	}
+}
+
+func (env *Environment) dynamicBackgroundDueNowV1() bool {
+	return env.dynamic != nil &&
+		env.dynamic.nextEvent < len(env.dynamic.scheduled) &&
+		time.Duration(env.dynamic.scheduled[env.dynamic.nextEvent].event.TimeMS)*time.Millisecond <= env.sim.CurrentTime
+}
+
+func (env *Environment) applyDynamicBackgroundV1(index int, event BackgroundDamageEventV1) {
+	if env.dynamic == nil || index != env.dynamic.nextEvent {
+		panic(fmt.Sprintf("dynamic background schedule advanced out of order at index %d", index))
+	}
+	target := env.sim.Encounter.TargetUnits[event.TargetIndex]
+	application, err := env.sim.Encounter.ApplyTargetDamage(env.sim, target, event.Damage, core.TargetDamageSourceBackground)
+	if err != nil {
+		panic(fmt.Sprintf("apply background damage event %q: %v", event.EventID, err))
+	}
+	status := DynamicDamageApplied
+	if application.AlreadyDead {
+		status = DynamicDamageCanceledTargetDead
+	} else if application.Unattackable {
+		status = DynamicDamageCanceledTargetUnattackable
+	}
+	receipt := DynamicDamageReceiptV1{
+		DamageOrdinal:   application.DamageOrdinal,
+		ScheduleIndex:   index,
+		EventID:         event.EventID,
+		TimeMS:          event.TimeMS,
+		TargetIndex:     event.TargetIndex,
+		RequestedDamage: event.Damage,
+		AppliedDamage:   application.AppliedDamage,
+		OverkillDamage:  application.OverkillDamage,
+		Killed:          application.Killed,
+		Status:          status,
+	}
+	env.dynamic.receipts = append(env.dynamic.receipts, receipt)
+	env.dynamic.nextEvent++
+	if application.Killed {
+		env.onDynamicTargetKilledV1(env.sim, target, false)
+	}
+}
+
+func (env *Environment) onDynamicCandidateDamageV1(
+	sim *core.Simulation,
+	spell *core.Spell,
+	result *core.SpellResult,
+	application core.TargetDamageApplication,
+) {
+	if env.dynamic == nil {
+		return
+	}
+	status := DynamicDamageApplied
+	outcome := dynamicCandidateOutcomeV1(result)
+	resolutionPhase := DynamicResolutionAppliedAfterOutcome
+	if application.AlreadyDead {
+		status = DynamicDamageCanceledTargetDead
+		outcome = "CANCELED"
+		if result.DynamicOutcomeComputed() {
+			resolutionPhase = DynamicResolutionDeadAfterOutcome
+		} else {
+			resolutionPhase = DynamicResolutionDeadBeforeOutcome
+		}
+	} else if application.Unattackable {
+		status = DynamicDamageCanceledTargetUnattackable
+		outcome = "CANCELED"
+		resolutionPhase = DynamicResolutionUnattackableAfterOutcome
+	} else if application.AppliedDamage == 0 {
+		status = DynamicDamageNoDamage
+		resolutionPhase = DynamicResolutionNoDamageAfterOutcome
+	}
+	env.dynamic.candidateReceipts = append(env.dynamic.candidateReceipts, DynamicCandidateDamageReceiptV1{
+		DamageOrdinal:        application.DamageOrdinal,
+		TimeMS:               sim.CurrentTime.Milliseconds(),
+		TargetIndex:          result.Target.Index,
+		RequestedDamage:      application.RequestedDamage,
+		AppliedDamage:        application.AppliedDamage,
+		OverkillDamage:       application.OverkillDamage,
+		Killed:               application.Killed,
+		Status:               status,
+		Action:               actionRef(spell.ActionID),
+		Outcome:              outcome,
+		ExecutionID:          result.ExecutionID,
+		ExecutionIndex:       result.ExecutionIndex,
+		LandedExecutionIndex: result.LandedExecutionIndex,
+		AttemptID:            env.candidateAttemptIDV1(spell.ActionID),
+		ResolutionPhase:      resolutionPhase,
+		OutcomeComputed:      result.DynamicOutcomeComputed(),
+		RandomStreamRewound:  false,
+	})
+}
+
+func dynamicCandidateOutcomeV1(result *core.SpellResult) string {
+	switch {
+	case result.DidBlockCrit():
+		return "BLOCK_CRIT"
+	case result.DidCrit():
+		return "CRIT"
+	case result.DidGlance():
+		return "GLANCE"
+	case result.DidBlock():
+		return "BLOCK"
+	case result.DidCrush():
+		return "CRUSH"
+	case result.DidDodge():
+		return "DODGE"
+	case result.DidParry():
+		return "PARRY"
+	case result.Outcome.Matches(core.OutcomeMiss):
+		return "MISS"
+	case result.Landed():
+		return "HIT"
+	default:
+		return "EMPTY"
+	}
+}
+
+func (env *Environment) candidateAttemptIDV1(action core.ActionID) string {
+	if env.activeAttemptID != "" && env.activeAttemptAction == action {
+		return env.activeAttemptID
+	}
+	for index := len(env.pendingServerResults) - 1; index >= 0; index-- {
+		pending := env.pendingServerResults[index]
+		if !pending.canceled && pending.action.coreID() == action {
+			return pending.attemptID
+		}
+	}
+	return ""
+}
+
+func (env *Environment) onDynamicCandidateTargetKilledV1(sim *core.Simulation, target *core.Unit) {
+	env.onDynamicTargetKilledV1(sim, target, true)
+}
+
+func (env *Environment) onDynamicTargetKilledV1(sim *core.Simulation, target *core.Unit, deferCyclicRetarget bool) {
+	if env.dynamic == nil {
+		return
+	}
+	// A dead encounter target must stop originating new attacks. CancelAutoSwing
+	// is scoped to this target and is reversible through EnableAutoSwing if a
+	// future lifecycle version adds explicit resurrection; it does not touch the
+	// interactive player's weapon timers. Any already-calculated outgoing result
+	// is canceled by the dynamic source-lifecycle guard in DealDamage.
+	target.AutoAttacks.CancelAutoSwing(sim)
+	character := env.player().GetCharacter()
+	if character.CurrentTarget == target && character.IsCasting(sim) {
+		action := character.Hardcast.ActionID
+		if character.CancelHardcast(sim) {
+			env.markPendingHardcastCanceledV1(action, sim.CurrentTime.Milliseconds())
+		}
+	}
+	if sim.Encounter.DynamicAllTargetsDead() {
+		env.finished = true
+		env.dynamic.retargetRequired = false
+		if env.dynamic.retargetAction != nil {
+			env.dynamic.retargetAction.Cancel(sim)
+			env.dynamic.retargetAction = nil
+		}
+		env.cancelRemainingDynamicTargetSemanticsV2()
+		env.cancelRemainingDynamicBackgroundV1()
+		env.finishDynamicIdleAdvanceV3(DynamicIdleAdvanceAllTargetsDead)
+		return
+	}
+	if character.CurrentTarget != target {
+		return
+	}
+	if env.dynamic.config.RetargetMode == DynamicRetargetRequireExplicit {
+		env.dynamic.retargetRequired = true
+		return
+	}
+	if deferCyclicRetarget {
+		env.dynamic.retargetRequired = true
+		if env.dynamic.retargetAction == nil {
+			action := &core.PendingAction{
+				NextActionAt: sim.CurrentTime,
+				Priority:     core.ActionPriorityDynamicBackground,
+				OnAction: func(sim *core.Simulation) {
+					env.dynamic.retargetAction = nil
+					env.completeDynamicCyclicRetargetV1(sim, target)
+				},
+			}
+			env.dynamic.retargetAction = action
+			sim.AddPendingAction(action)
+		}
+		return
+	}
+	env.completeDynamicCyclicRetargetV1(sim, target)
+}
+
+func (env *Environment) completeDynamicCyclicRetargetV1(sim *core.Simulation, target *core.Unit) {
+	if env.dynamic == nil || env.finished {
+		return
+	}
+	character := env.player().GetCharacter()
+	if character.CurrentTarget != target || !sim.Encounter.DynamicTargetIsDead(target.Index) {
+		env.dynamic.retargetRequired = false
+		return
+	}
+	next := env.nextAliveTargetV1(target.Index)
+	if next == nil {
+		// At least one target is alive, but dynamic-v2 may have made every live
+		// target temporarily unattackable. Keep the decision blocked until a
+		// semantics transition makes a target selectable again.
+		env.dynamic.retargetRequired = true
+		return
+	}
+	character.CurrentTarget = next
+	env.dynamic.retargetRequired = false
+	character.AutoAttacks.ResumeDynamicTargetSwings(sim)
+	retargeted := next.Index
+	latestOrdinal := uint64(0)
+	var backgroundReceipt *DynamicDamageReceiptV1
+	for index := len(env.dynamic.receipts) - 1; index >= 0; index-- {
+		receipt := &env.dynamic.receipts[index]
+		if receipt.Killed && receipt.TargetIndex == target.Index && receipt.TimeMS == sim.CurrentTime.Milliseconds() {
+			backgroundReceipt = receipt
+			latestOrdinal = receipt.DamageOrdinal
+			break
+		}
+	}
+	var candidateReceipt *DynamicCandidateDamageReceiptV1
+	for index := len(env.dynamic.candidateReceipts) - 1; index >= 0; index-- {
+		receipt := &env.dynamic.candidateReceipts[index]
+		if receipt.Killed && receipt.TargetIndex == target.Index && receipt.TimeMS == sim.CurrentTime.Milliseconds() {
+			candidateReceipt = receipt
+			break
+		}
+	}
+	if candidateReceipt != nil && candidateReceipt.DamageOrdinal >= latestOrdinal {
+		candidateReceipt.RetargetedTo = &retargeted
+	} else if backgroundReceipt != nil {
+		backgroundReceipt.RetargetedTo = &retargeted
+	}
+}
+
+func (env *Environment) dynamicRetargetDueNowV1() bool {
+	return env.dynamic != nil && env.dynamic.retargetAction != nil &&
+		env.dynamic.retargetAction.NextActionAt <= env.sim.CurrentTime
+}
+
+func (env *Environment) nextAliveTargetV1(from int32) *core.Unit {
+	targets := env.sim.Encounter.TargetUnits
+	for offset := 1; offset <= len(targets); offset++ {
+		index := (int(from) + offset) % len(targets)
+		if env.sim.Encounter.DynamicTargetIsAttackable(int32(index)) {
+			return targets[index]
+		}
+	}
+	return nil
+}
+
+func (env *Environment) markPendingHardcastCanceledV1(action core.ActionID, canceledAtMS int64) {
+	for index := len(env.pendingServerResults) - 1; index >= 0; index-- {
+		pending := &env.pendingServerResults[index]
+		if pending.action.coreID() == action && !pending.canceled {
+			pending.canceled = true
+			pending.canceledAtMS = canceledAtMS
+			return
+		}
+	}
+}
+
+func (env *Environment) cancelRemainingDynamicBackgroundV1() {
+	if env.dynamic == nil {
+		return
+	}
+	for index := env.dynamic.nextEvent; index < len(env.dynamic.scheduled); index++ {
+		scheduled := env.dynamic.scheduled[index]
+		scheduled.action.Cancel(env.sim)
+		event := scheduled.event
+		env.dynamic.receipts = append(env.dynamic.receipts, DynamicDamageReceiptV1{
+			ScheduleIndex:   index,
+			EventID:         event.EventID,
+			TimeMS:          event.TimeMS,
+			TargetIndex:     event.TargetIndex,
+			RequestedDamage: event.Damage,
+			AppliedDamage:   0,
+			OverkillDamage:  event.Damage,
+			Killed:          false,
+			Status:          DynamicDamageCanceledTargetDead,
+		})
+	}
+	env.dynamic.nextEvent = len(env.dynamic.scheduled)
+}
+
+func (env *Environment) DynamicEnabledV1() bool {
+	return env != nil && env.dynamic != nil
+}
+
+func (env *Environment) DynamicGenerationV1() uint64 {
+	if env.dynamic == nil {
+		return 0
+	}
+	return env.dynamic.generation
+}
+
+func (env *Environment) DynamicDamageReceiptsV1(cursor int) (DynamicDamageReceiptBatchV1, error) {
+	result := DynamicDamageReceiptBatchV1{}
+	if env.dynamic == nil {
+		return result, errors.New("dynamic team background is not enabled")
+	}
+	if cursor < 0 || cursor > len(env.dynamic.receipts) {
+		return result, fmt.Errorf("dynamic receipt cursor %d out of range 0..%d", cursor, len(env.dynamic.receipts))
+	}
+	result = DynamicDamageReceiptBatchV1{
+		Schema:                env.dynamic.bindingSchema,
+		ConfigDigest:          env.dynamic.bindingDigest,
+		EnvironmentGeneration: env.dynamic.generation,
+		Cursor:                cursor,
+		NextCursor:            len(env.dynamic.receipts),
+		ScheduleComplete:      env.dynamic.nextEvent == len(env.dynamic.scheduled),
+		Receipts:              append([]DynamicDamageReceiptV1(nil), env.dynamic.receipts[cursor:]...),
+	}
+	if result.Receipts == nil {
+		result.Receipts = make([]DynamicDamageReceiptV1, 0)
+	}
+	return result, nil
+}
+
+func (env *Environment) DynamicCandidateDamageReceiptsV1(cursor int) (DynamicCandidateDamageReceiptBatchV1, error) {
+	result := DynamicCandidateDamageReceiptBatchV1{}
+	if env.dynamic == nil {
+		return result, errors.New("dynamic team background is not enabled")
+	}
+	if cursor < 0 || cursor > len(env.dynamic.candidateReceipts) {
+		return result, fmt.Errorf("dynamic candidate receipt cursor %d out of range 0..%d", cursor, len(env.dynamic.candidateReceipts))
+	}
+	result = DynamicCandidateDamageReceiptBatchV1{
+		Schema:                env.dynamic.bindingSchema,
+		ConfigDigest:          env.dynamic.bindingDigest,
+		EnvironmentGeneration: env.dynamic.generation,
+		Cursor:                cursor,
+		NextCursor:            len(env.dynamic.candidateReceipts),
+		Receipts:              append([]DynamicCandidateDamageReceiptV1(nil), env.dynamic.candidateReceipts[cursor:]...),
+	}
+	if result.Receipts == nil {
+		result.Receipts = make([]DynamicCandidateDamageReceiptV1, 0)
+	}
+	return result, nil
+}
+
+func (env *Environment) dynamicStateV1() *DynamicTeamBackgroundStateV1 {
+	if env.dynamic == nil {
+		return nil
+	}
+	snapshots := env.sim.Encounter.DynamicTargetDamageSnapshots()
+	targets := make([]DynamicTargetStateV1, len(snapshots))
+	simulated := 0.0
+	background := 0.0
+	for index, snapshot := range snapshots {
+		var deathTimeMS *int64
+		if snapshot.Dead && snapshot.DeathTime != core.NeverExpires {
+			value := snapshot.DeathTime.Milliseconds()
+			deathTimeMS = &value
+		}
+		targets[index] = DynamicTargetStateV1{
+			TargetIndex:             snapshot.TargetIndex,
+			InitialHealth:           snapshot.InitialHealth,
+			CurrentHealth:           snapshot.CurrentHealth,
+			Dead:                    snapshot.Dead,
+			DeathTimeMS:             deathTimeMS,
+			SimulatedDamageApplied:  snapshot.SimulatedDamageApplied,
+			BackgroundDamageApplied: snapshot.BackgroundDamageApplied,
+		}
+		simulated += snapshot.SimulatedDamageApplied
+		background += snapshot.BackgroundDamageApplied
+	}
+	canceled := 0
+	for _, receipt := range env.dynamic.receipts {
+		if receipt.Status == DynamicDamageCanceledTargetDead || receipt.Status == DynamicDamageCanceledTargetUnattackable {
+			canceled++
+		}
+	}
+	candidateCanceled := 0
+	for _, receipt := range env.dynamic.candidateReceipts {
+		if receipt.Status == DynamicDamageCanceledTargetDead || receipt.Status == DynamicDamageCanceledTargetUnattackable {
+			candidateCanceled++
+		}
+	}
+	return &DynamicTeamBackgroundStateV1{
+		Schema:                    env.dynamic.bindingSchema,
+		ConfigDigest:              env.dynamic.bindingDigest,
+		EnvironmentGeneration:     env.dynamic.generation,
+		SameTimestampOrder:        env.dynamic.sameTimestampOrder,
+		RetargetMode:              env.dynamic.config.RetargetMode,
+		RetargetRequired:          env.dynamic.retargetRequired,
+		SimulatedDamageApplied:    simulated,
+		BackgroundDamageApplied:   background,
+		CombinedDamageApplied:     simulated + background,
+		BackgroundEventsProcessed: len(env.dynamic.receipts),
+		BackgroundEventsTotal:     len(env.dynamic.scheduled),
+		BackgroundEventsCanceled:  canceled,
+		CandidateEventsProcessed:  len(env.dynamic.candidateReceipts),
+		CandidateEventsCanceled:   candidateCanceled,
+		DamageApplicationsTotal:   env.sim.Encounter.DynamicDamageApplicationCount(),
+		Targets:                   targets,
+	}
+}
