+func TestDynamicMainhandKillCancelsSameTimestampOffhandThenRetargets(t *testing.T) {
+	health := []float64{10_000, 10_000}
+	config := boundDynamicConfig(t, DynamicRetargetNextAliveCyclic, health, nil)
+	env := newDynamicTestEnvironment(t, dynamicRequest(health...), config)
+	character := env.player().GetCharacter()
+	if !character.AutoAttacks.IsDualWielding {
+		t.Fatal("fixture is not dual wielding")
+	}
+	forceHitOnEveryTarget(t, env, character.AutoAttacks.MHAuto())
+	forceHitOnEveryTarget(t, env, character.AutoAttacks.OHAuto())
+	// Let the pull-time main-hand batch resolve, then use the bridge-owned damage
+	// path to leave exactly one HP before the deliberately synchronized pair.
+	if err := env.Wait(20 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	initialCandidate, err := env.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	current := env.sim.Encounter.TargetUnits[0].CurrentHealth()
+	application, err := env.sim.Encounter.ApplyTargetDamage(env.sim, env.sim.Encounter.TargetUnits[0], current-1, core.TargetDamageSourceBackground)
+	if err != nil || application.Killed {
+		t.Fatalf("failed to prepare one-HP target: application=%+v err=%v", application, err)
+	}
+	ohBefore := character.AutoAttacks.OHAuto().SpellMetrics[env.sim.Encounter.TargetUnits[0].UnitIndex]
+	character.AutoAttacks.SetOffhandSwingAt(character.AutoAttacks.NextMHSwingAt())
+	resolveAfter := character.AutoAttacks.NextMHSwingAt() - env.sim.CurrentTime + core.SpellBatchWindow + time.Millisecond
+	if err := env.Wait(resolveAfter); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	state := env.State()
+	if state.TargetIndex != 1 || state.DynamicTeamBackground == nil {
+		t.Fatalf("main-hand kill did not retarget: %+v", state)
+	}
+	if !state.DynamicTeamBackground.Targets[0].Dead {
+		t.Fatalf("main hand did not kill target 0: %+v", state.DynamicTeamBackground.Targets[0])
+	}
+	candidate, err := env.DynamicCandidateDamageReceiptsV1(initialCandidate.NextCursor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(candidate.Receipts) != 2 {
+		t.Fatalf("dual-wield batch ledger has %d rows, want MH and OH: %+v", len(candidate.Receipts), candidate)
+	}
+	if state.DynamicTeamBackground.Targets[1].SimulatedDamageApplied != 0 {
+		t.Fatalf("same-time offhand escaped its dead locked target: target=%+v ledger=%+v", state.DynamicTeamBackground.Targets[1], candidate.Receipts)
+	}
+	mh, oh := candidate.Receipts[0], candidate.Receipts[1]
+	if mh.Action != actionRef(character.AutoAttacks.MHAuto().ActionID) || !mh.Killed || mh.TargetIndex != 0 || mh.AppliedDamage != 1 || mh.RetargetedTo == nil || *mh.RetargetedTo != 1 {
+		t.Fatalf("main-hand killer ledger is wrong: %+v", mh)
+	}
+	if mh.ResolutionPhase != DynamicResolutionAppliedAfterOutcome || !mh.OutcomeComputed || mh.RandomStreamRewound {
+		t.Fatalf("main-hand receipt lost committed outcome boundary: %+v", mh)
+	}
+	if oh.Action != actionRef(character.AutoAttacks.OHAuto().ActionID) || oh.TargetIndex != 0 ||
+		oh.Status != DynamicDamageCanceledTargetDead || oh.AppliedDamage != 0 ||
+		oh.Outcome != "CANCELED" || oh.LandedExecutionIndex != 0 || mh.DamageOrdinal >= oh.DamageOrdinal ||
+		oh.ResolutionPhase != DynamicResolutionDeadAfterOutcome || !oh.OutcomeComputed || oh.RandomStreamRewound {
+		t.Fatalf("same-time offhand was not deterministically canceled after MH: mh=%+v oh=%+v", mh, oh)
+	}
+	ohAfter := character.AutoAttacks.OHAuto().SpellMetrics[env.sim.Encounter.TargetUnits[0].UnitIndex]
+	if ohAfter.Casts != ohBefore.Casts+1 || ohAfter.Hits != ohBefore.Hits || ohAfter.Crits != ohBefore.Crits || ohAfter.Misses != ohBefore.Misses || ohAfter.TotalDamage != ohBefore.TotalDamage {
+		t.Fatalf("canceled offhand did not preserve cast while excluding outcome/damage metrics: before=%+v after=%+v", ohBefore, ohAfter)
+	}
+}
