+		t.Fatalf("Bonereaver aura was not registered: %+v", aura)
+	}
+	basePenetration := character.GetStat(stats.ArmorPenetration)
+
+	aura.Activate(env.sim)
+	aura.AddStack(env.sim)
+	assertBonereaverState(t, env, 1, basePenetration, 4211)
+
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if got := env.State().TimeMS; got != 400 {
+		t.Fatalf("central idle stopped at %dms, want 400ms", got)
+	}
+	assertBonereaverState(t, env, 1, basePenetration, 2511)
+
+	aura.Activate(env.sim)
+	aura.AddStack(env.sim)
+	assertBonereaverState(t, env, 2, basePenetration, 2511)
+	aura.Activate(env.sim)
+	aura.AddStack(env.sim)
+	assertBonereaverState(t, env, 3, basePenetration, 2511)
+	aura.Activate(env.sim)
+	aura.AddStack(env.sim)
+	assertBonereaverState(t, env, 3, basePenetration, 2511)
+
+	aura.Deactivate(env.sim)
+	assertBonereaverState(t, env, 0, basePenetration, 2511)
+}
+
+func assertBonereaverState(
+	t *testing.T,
+	env *Environment,
+	stacks int32,
+	basePenetration float64,
+	wantTargetArmor float64,
+) {
+	t.Helper()
+	state := env.State()
+	wantPenetration := basePenetration + 700*float64(stacks)
+	if math.IsNaN(state.ArmorPenetration) || math.Abs(state.ArmorPenetration-wantPenetration) > 1e-9 {
+		t.Fatalf(
+			"Bonereaver stacks=%d armor penetration=%.9f, want %.9f",
+			stacks,
+			state.ArmorPenetration,
+			wantPenetration,
+		)
+	}
+	if math.Abs(state.TargetArmor-wantTargetArmor) > 1e-9 {
+		t.Fatalf(
+			"Bonereaver stacks=%d changed target armor=%.9f, want %.9f",
+			stacks,
+			state.TargetArmor,
+			wantTargetArmor,
+		)
+	}
+	wantEffective := math.Max(wantTargetArmor-wantPenetration, 0)
+	if math.Abs(state.EffectiveTargetArmor-wantEffective) > 1e-9 {
+		t.Fatalf(
+			"Bonereaver stacks=%d effective target armor=%.9f, want %.9f",
+			stacks,
+			state.EffectiveTargetArmor,
+			wantEffective,
+		)
+	}
+}
diff --git a/sim/o2o/dynamic_target_semantics_v2.go b/sim/o2o/dynamic_target_semantics_v2.go
new file mode 100644
index 0000000000000000000000000000000000000000..38fb8973df4c4841847a5f9d4bf902ac5a2a11c0
--- /dev/null
+++ b/sim/o2o/dynamic_target_semantics_v2.go
@@ -0,0 +1,678 @@
+package o2o
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"time"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+	"github.com/isfir/wowsims-turtle/sim/core/stats"
+)
+
+const (
+	DynamicTargetSemanticsSchemaV2 = "o2o_dynamic_target_semantics/v2"
+	DynamicSameTimestampOrderV2    = "TARGET_SEMANTICS_BEFORE_BACKGROUND_BEFORE_CANDIDATE"
+
+	DynamicTransitionApplied                   = "APPLIED"
+	DynamicTransitionNoChange                  = "NO_CHANGE"
+	DynamicTransitionCanceledTargetDead        = "CANCELED_TARGET_DEAD"
+	DynamicTransitionCanceledEncounterFinished = "CANCELED_ENCOUNTER_FINISHED"
+)
+
+// DynamicAttackabilityEventV2 changes whether one live encounter target may
+// receive damage. ScheduleIndex is contiguous within attackability_events.
+type DynamicAttackabilityEventV2 struct {
+	Attackable    bool  `json:"attackable"`
+	ScheduleIndex int   `json:"schedule_index"`
+	TargetIndex   int32 `json:"target_index"`
+	TimeMS        int64 `json:"time_ms"`
+}
+
+// DynamicEffectiveArmorEventV2 requests an absolute target armor value. It is
+// applied through Unit.AddStatDynamic so attack tables observe the change.
+type DynamicEffectiveArmorEventV2 struct {
+	EffectiveArmor float64 `json:"effective_armor"`
+	ScheduleIndex  int     `json:"schedule_index"`
+	TargetIndex    int32   `json:"target_index"`
+	TimeMS         int64   `json:"time_ms"`
+}
+
+type DynamicTargetSemanticsConfigV2 struct {
+	Schema                 string                         `json:"schema"`
+	ContentSHA256          string                         `json:"content_sha256"`
+	TargetHealth           []DynamicTargetHealthV1        `json:"target_health"`
+	BackgroundDamageEvents []BackgroundDamageEventV1      `json:"background_damage_events"`
+	AttackabilityEvents    []DynamicAttackabilityEventV2  `json:"attackability_events"`
+	EffectiveArmorEvents   []DynamicEffectiveArmorEventV2 `json:"effective_armor_events"`
+	SameTimestampOrder     string                         `json:"same_timestamp_order"`
+	RetargetMode           DynamicRetargetMode            `json:"retarget_mode"`
+}
+
+type DynamicAttackabilityTransitionReceiptV2 struct {
+	ScheduleIndex       int    `json:"schedule_index"`
+	TimeMS              int64  `json:"time_ms"`
+	TargetIndex         int32  `json:"target_index"`
+	RequestedAttackable bool   `json:"requested_attackable"`
+	PreviousAttackable  bool   `json:"previous_attackable"`
+	ResultingAttackable bool   `json:"resulting_attackable"`
+	Status              string `json:"status"`
+	RetargetedTo        *int32 `json:"retargeted_to,omitempty"`
+}
+
+type DynamicArmorTransitionReceiptV2 struct {
+	ScheduleIndex           int     `json:"schedule_index"`
+	TimeMS                  int64   `json:"time_ms"`
+	TargetIndex             int32   `json:"target_index"`
+	RequestedEffectiveArmor float64 `json:"requested_effective_armor"`
+	PreviousTargetArmor     float64 `json:"previous_target_armor"`
+	ResultingTargetArmor    float64 `json:"resulting_target_armor"`
+	Status                  string  `json:"status"`
+}
+
+type DynamicAttackabilityReceiptBatchV2 struct {
+	Schema                string                                    `json:"schema"`
+	ConfigDigest          string                                    `json:"config_digest"`
+	EnvironmentGeneration uint64                                    `json:"environment_generation"`
+	Cursor                int                                       `json:"cursor"`
+	NextCursor            int                                       `json:"next_cursor"`
+	ScheduleComplete      bool                                      `json:"schedule_complete"`
+	Receipts              []DynamicAttackabilityTransitionReceiptV2 `json:"receipts"`
+}
+
+type DynamicArmorReceiptBatchV2 struct {
+	Schema                string                            `json:"schema"`
+	ConfigDigest          string                            `json:"config_digest"`
+	EnvironmentGeneration uint64                            `json:"environment_generation"`
+	Cursor                int                               `json:"cursor"`
+	NextCursor            int                               `json:"next_cursor"`
+	ScheduleComplete      bool                              `json:"schedule_complete"`
+	Receipts              []DynamicArmorTransitionReceiptV2 `json:"receipts"`
+}
+
+type DynamicTargetSemanticsTargetStateV2 struct {
+	TargetIndex    int32   `json:"target_index"`
+	Attackable     bool    `json:"attackable"`
+	EffectiveArmor float64 `json:"effective_armor"`
+	CurrentHealth  float64 `json:"current_health"`
+	Dead           bool    `json:"dead"`
+	DeathTimeMS    *int64  `json:"death_time_ms,omitempty"`
+}
+
+type DynamicTargetSemanticsStateV2 struct {
+	Schema                        string                                `json:"schema"`
+	ConfigDigest                  string                                `json:"config_digest"`
+	EnvironmentGeneration         uint64                                `json:"environment_generation"`
+	SameTimestampOrder            string                                `json:"same_timestamp_order"`
+	AttackabilityEventsProcessed  int                                   `json:"attackability_events_processed"`
+	AttackabilityEventsTotal      int                                   `json:"attackability_events_total"`
+	EffectiveArmorEventsProcessed int                                   `json:"effective_armor_events_processed"`
+	EffectiveArmorEventsTotal     int                                   `json:"effective_armor_events_total"`
+	Targets                       []DynamicTargetSemanticsTargetStateV2 `json:"targets"`
+}
+
+type scheduledDynamicAttackabilityV2 struct {
+	event  DynamicAttackabilityEventV2
+	action *core.PendingAction
+}
+
+type scheduledDynamicArmorV2 struct {
+	event  DynamicEffectiveArmorEventV2
+	action *core.PendingAction
+}
+
+type dynamicTargetSemanticsRuntimeV2 struct {
+	config                 DynamicTargetSemanticsConfigV2
+	generation             uint64
+	attackabilityScheduled []scheduledDynamicAttackabilityV2
+	armorScheduled         []scheduledDynamicArmorV2
+	nextAttackability      int
+	nextArmor              int
+	attackabilityReceipts  []DynamicAttackabilityTransitionReceiptV2
+	armorReceipts          []DynamicArmorTransitionReceiptV2
+}
+
+// Digest-only structs are declared in lexical JSON-key order to match
+// Python json.dumps(sort_keys=True, separators=(",", ":")) byte-for-byte.
+type dynamicDigestAttackabilityEventV2 struct {
+	Attackable    bool  `json:"attackable"`
+	ScheduleIndex int   `json:"schedule_index"`
+	TargetIndex   int32 `json:"target_index"`
+	TimeMS        int64 `json:"time_ms"`
+}
+
+type dynamicDigestArmorEventV2 struct {
+	EffectiveArmorIEEE754 string `json:"effective_armor_ieee754"`
+	ScheduleIndex         int    `json:"schedule_index"`
+	TargetIndex           int32  `json:"target_index"`
+	TimeMS                int64  `json:"time_ms"`
+}
+
+type dynamicDigestDocumentV2 struct {
+	AttackabilityEvents    []dynamicDigestAttackabilityEventV2 `json:"attackability_events"`
+	BackgroundDamageEvents []dynamicDigestEventV1              `json:"background_damage_events"`
+	EffectiveArmorEvents   []dynamicDigestArmorEventV2         `json:"effective_armor_events"`
+	RetargetMode           DynamicRetargetMode                 `json:"retarget_mode"`
+	SameTimestampOrder     string                              `json:"same_timestamp_order"`
+	Schema                 string                              `json:"schema"`
+	TargetHealth           []dynamicDigestTargetV1             `json:"target_health"`
+}
+
+func DynamicTargetSemanticsDigestV2(config DynamicTargetSemanticsConfigV2) (string, error) {
+	if err := validateDynamicConfigV2(config, -1); err != nil {
+		return "", err
+	}
+	document := dynamicDigestDocumentV2{
+		AttackabilityEvents:    make([]dynamicDigestAttackabilityEventV2, len(config.AttackabilityEvents)),
+		BackgroundDamageEvents: make([]dynamicDigestEventV1, len(config.BackgroundDamageEvents)),
+		EffectiveArmorEvents:   make([]dynamicDigestArmorEventV2, len(config.EffectiveArmorEvents)),
+		RetargetMode:           config.RetargetMode,
+		SameTimestampOrder:     config.SameTimestampOrder,
+		Schema:                 config.Schema,
+		TargetHealth:           make([]dynamicDigestTargetV1, len(config.TargetHealth)),
+	}
+	for index, target := range config.TargetHealth {
+		document.TargetHealth[index] = dynamicDigestTargetV1{
+			HealthIEEE754: fmt.Sprintf("%016x", math.Float64bits(target.Health)),
+			TargetIndex:   target.TargetIndex,
+		}
+	}
+	for index, event := range config.BackgroundDamageEvents {
+		document.BackgroundDamageEvents[index] = dynamicDigestEventV1{
+			DamageIEEE754: fmt.Sprintf("%016x", math.Float64bits(event.Damage)),
+			EventID:       event.EventID,
+			ScheduleIndex: event.ScheduleIndex,
+			TargetIndex:   event.TargetIndex,
+			TimeMS:        event.TimeMS,
+		}
+	}
+	for index, event := range config.AttackabilityEvents {
+		document.AttackabilityEvents[index] = dynamicDigestAttackabilityEventV2(event)
+	}
+	for index, event := range config.EffectiveArmorEvents {
+		document.EffectiveArmorEvents[index] = dynamicDigestArmorEventV2{
+			EffectiveArmorIEEE754: fmt.Sprintf("%016x", math.Float64bits(event.EffectiveArmor)),
+			ScheduleIndex:         event.ScheduleIndex,
+			TargetIndex:           event.TargetIndex,
+			TimeMS:                event.TimeMS,
+		}
+	}
+	payload, err := json.Marshal(document)
+	if err != nil {
+		return "", fmt.Errorf("marshal dynamic-v2 content binding: %w", err)
+	}
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func validateDynamicConfigV2(config DynamicTargetSemanticsConfigV2, requestTargetCount int) error {
+	if config.Schema != DynamicTargetSemanticsSchemaV2 {
+		return fmt.Errorf("dynamic schema must be %q", DynamicTargetSemanticsSchemaV2)
+	}
+	if config.SameTimestampOrder != DynamicSameTimestampOrderV2 {
+		return fmt.Errorf("same_timestamp_order must be %q", DynamicSameTimestampOrderV2)
+	}
+	if config.BackgroundDamageEvents == nil {
+		return errors.New("background_damage_events must be present (use [] for an empty schedule)")
+	}
+	if config.AttackabilityEvents == nil {
+		return errors.New("attackability_events must be present (use [] for an empty schedule)")
+	}
+	if config.EffectiveArmorEvents == nil {
+		return errors.New("effective_armor_events must be present (use [] for an empty schedule)")
+	}
+	base := DynamicTeamBackgroundConfigV1{
+		Schema:                 DynamicTeamBackgroundSchemaV1,
+		TargetHealth:           config.TargetHealth,
+		BackgroundDamageEvents: config.BackgroundDamageEvents,
+		SameTimestampOrder:     DynamicSameTimestampOrderV1,
+		RetargetMode:           config.RetargetMode,
+	}
+	if err := validateDynamicConfigV1(base, requestTargetCount); err != nil {
+		return err
+	}
+	seenAttackability := make(map[[2]int64]struct{}, len(config.AttackabilityEvents))
+	for index, event := range config.AttackabilityEvents {
+		if event.ScheduleIndex != index {
+			return errors.New("attackability_events schedule_index must cover 0..N-1 exactly in list order")
+		}
+		if event.TimeMS < 0 || event.TimeMS > math.MaxInt64/int64(time.Millisecond) {
+			return fmt.Errorf("attackability_events[%d].time_ms is outside the supported non-negative duration range", index)
+		}
+		if event.TargetIndex < 0 || int(event.TargetIndex) >= len(config.TargetHealth) {
+			return fmt.Errorf("attackability_events[%d].target_index out of range", index)
+		}
+		if index > 0 && config.AttackabilityEvents[index-1].TimeMS > event.TimeMS {
+			return errors.New("attackability_events must be strictly sorted by (time_ms,schedule_index)")
+		}
+		key := [2]int64{event.TimeMS, int64(event.TargetIndex)}
+		if _, duplicate := seenAttackability[key]; duplicate {
+			return fmt.Errorf("duplicate attackability event for target %d at %dms", event.TargetIndex, event.TimeMS)
+		}
+		seenAttackability[key] = struct{}{}
+	}
+	seenArmor := make(map[[2]int64]struct{}, len(config.EffectiveArmorEvents))
+	for index, event := range config.EffectiveArmorEvents {
+		if event.ScheduleIndex != index {
+			return errors.New("effective_armor_events schedule_index must cover 0..N-1 exactly in list order")
+		}
+		if event.TimeMS < 0 || event.TimeMS > math.MaxInt64/int64(time.Millisecond) {
+			return fmt.Errorf("effective_armor_events[%d].time_ms is outside the supported non-negative duration range", index)
+		}
+		if event.TargetIndex < 0 || int(event.TargetIndex) >= len(config.TargetHealth) {
+			return fmt.Errorf("effective_armor_events[%d].target_index out of range", index)
+		}
+		if math.IsNaN(event.EffectiveArmor) || math.IsInf(event.EffectiveArmor, 0) || event.EffectiveArmor < 0 {
+			return fmt.Errorf("effective_armor_events[%d].effective_armor must be finite and non-negative", index)
+		}
+		if index > 0 && config.EffectiveArmorEvents[index-1].TimeMS > event.TimeMS {
+			return errors.New("effective_armor_events must be strictly sorted by (time_ms,schedule_index)")
+		}
+		key := [2]int64{event.TimeMS, int64(event.TargetIndex)}
+		if _, duplicate := seenArmor[key]; duplicate {
+			return fmt.Errorf("duplicate effective armor event for target %d at %dms", event.TargetIndex, event.TimeMS)
+		}
+		seenArmor[key] = struct{}{}
+	}
+	return nil
+}
+
+func NewDynamicV2(
+	request *proto.RaidSimRequest,
+	seed int64,
+	config DynamicTargetSemanticsConfigV2,
+	generation uint64,
+) (*Environment, DynamicLoadReceiptV1, error) {
+	receipt := DynamicLoadReceiptV1{}
+	if generation == 0 {
+		return nil, receipt, errors.New("environment_generation must be positive")
+	}
+	if request == nil || request.Encounter == nil {
+		return nil, receipt, errors.New("raid, encounter, and sim_options are required")
+	}
+	if err := validateDynamicConfigV2(config, len(request.Encounter.Targets)); err != nil {
+		return nil, receipt, err
+	}
+	for index, target := range config.TargetHealth {
+		requestTarget := request.Encounter.Targets[index]
+		if requestTarget == nil || len(requestTarget.Stats) <= int(stats.Health) {
+			return nil, receipt, fmt.Errorf("RaidSimRequest target %d has no explicit health stat", index)
+		}
+		requestHealth := requestTarget.Stats[stats.Health]
+		if math.Float64bits(requestHealth) != math.Float64bits(target.Health) {
+			return nil, receipt, fmt.Errorf("target_health[%d].health does not match RaidSimRequest target health", index)
+		}
+		if len(requestTarget.Stats) <= int(stats.Armor) || math.IsNaN(requestTarget.Stats[stats.Armor]) ||
+			math.IsInf(requestTarget.Stats[stats.Armor], 0) || requestTarget.Stats[stats.Armor] < 0 {
+			return nil, receipt, fmt.Errorf("RaidSimRequest target %d has no finite non-negative armor stat", index)
+		}
+	}
+	digest, err := DynamicTargetSemanticsDigestV2(config)
+	if err != nil {
+		return nil, receipt, err
+	}
+	if len(config.ContentSHA256) != sha256.Size*2 {
+		return nil, receipt, errors.New("content_sha256 must be 64 lowercase hexadecimal characters")
+	}
+	decodedDigest, decodeErr := hex.DecodeString(config.ContentSHA256)
+	if decodeErr != nil || config.ContentSHA256 != hex.EncodeToString(decodedDigest) {
+		return nil, receipt, errors.New("content_sha256 must be 64 lowercase hexadecimal characters")
+	}
+	if config.ContentSHA256 != digest {
+		return nil, receipt, fmt.Errorf("content_sha256 mismatch: got %s, computed %s", config.ContentSHA256, digest)
+	}
+
+	config.TargetHealth = append([]DynamicTargetHealthV1(nil), config.TargetHealth...)
+	config.BackgroundDamageEvents = append([]BackgroundDamageEventV1(nil), config.BackgroundDamageEvents...)
+	config.AttackabilityEvents = append([]DynamicAttackabilityEventV2(nil), config.AttackabilityEvents...)
+	config.EffectiveArmorEvents = append([]DynamicEffectiveArmorEventV2(nil), config.EffectiveArmorEvents...)
+	base := DynamicTeamBackgroundConfigV1{
+		Schema:                 DynamicTeamBackgroundSchemaV1,
+		TargetHealth:           append([]DynamicTargetHealthV1(nil), config.TargetHealth...),
+		BackgroundDamageEvents: append([]BackgroundDamageEventV1(nil), config.BackgroundDamageEvents...),
+		SameTimestampOrder:     DynamicSameTimestampOrderV1,
+		RetargetMode:           config.RetargetMode,
+	}
+	baseDigest, err := DynamicTeamBackgroundDigestV1(base)
+	if err != nil {
+		return nil, receipt, err
+	}
+	base.ContentSHA256 = baseDigest
+	env, err := newEnvironmentDynamicV2(request, seed, &base, &config, generation)
+	if err != nil {
+		return nil, receipt, err
+	}
+	attackabilityCount := len(config.AttackabilityEvents)
+	armorCount := len(config.EffectiveArmorEvents)
+	receipt = DynamicLoadReceiptV1{
+		Schema:                   DynamicTargetSemanticsSchemaV2,
+		ConfigDigest:             digest,
+		EnvironmentGeneration:    generation,
+		TargetCount:              len(config.TargetHealth),
+		BackgroundEventCount:     len(config.BackgroundDamageEvents),
+		SameTimestampOrder:       DynamicSameTimestampOrderV2,
+		RetargetMode:             config.RetargetMode,
+		AttackabilityEventCount:  &attackabilityCount,
+		EffectiveArmorEventCount: &armorCount,
+	}
+	return env, receipt, nil
+}
+
+func newDynamicTargetSemanticsRuntimeV2(config DynamicTargetSemanticsConfigV2, generation uint64) *dynamicTargetSemanticsRuntimeV2 {
+	return &dynamicTargetSemanticsRuntimeV2{
+		config:                 config,
+		generation:             generation,
+		attackabilityScheduled: make([]scheduledDynamicAttackabilityV2, len(config.AttackabilityEvents)),
+		armorScheduled:         make([]scheduledDynamicArmorV2, len(config.EffectiveArmorEvents)),
+		attackabilityReceipts:  make([]DynamicAttackabilityTransitionReceiptV2, 0, len(config.AttackabilityEvents)),
+		armorReceipts:          make([]DynamicArmorTransitionReceiptV2, 0, len(config.EffectiveArmorEvents)),
+	}
+}
+
+// initializeDynamicTargetSemanticsV2 commits time-zero target semantics after
+// Simulation.Reset and before PrePull. This closes the only priority ambiguity
+// at zero while later transitions use a dedicated pending-action priority.
+func (env *Environment) initializeDynamicTargetSemanticsV2() {
+	if env.dynamicV2 == nil {
+		return
+	}
+	for env.dynamicV2.nextAttackability < len(env.dynamicV2.config.AttackabilityEvents) {
+		event := env.dynamicV2.config.AttackabilityEvents[env.dynamicV2.nextAttackability]
+		if event.TimeMS != 0 {
+			break
+		}
+		env.applyDynamicAttackabilityV2(env.dynamicV2.nextAttackability, event)
+	}
+	for env.dynamicV2.nextArmor < len(env.dynamicV2.config.EffectiveArmorEvents) {
+		event := env.dynamicV2.config.EffectiveArmorEvents[env.dynamicV2.nextArmor]
+		if event.TimeMS != 0 {
+			break
+		}
+		env.applyDynamicArmorV2(env.dynamicV2.nextArmor, event)
+	}
+}
+
+func (env *Environment) scheduleDynamicTargetSemanticsV2() {
+	if env.dynamicV2 == nil {
+		return
+	}
+	for index := env.dynamicV2.nextAttackability; index < len(env.dynamicV2.config.AttackabilityEvents); index++ {
+		index := index
+		event := env.dynamicV2.config.AttackabilityEvents[index]
+		action := &core.PendingAction{
+			NextActionAt: time.Duration(event.TimeMS) * time.Millisecond,
+			Priority:     core.ActionPriorityDynamicTargetSemantics,
+			OnAction: func(sim *core.Simulation) {
+				env.applyDynamicAttackabilityV2(index, event)
+			},
+		}
+		env.dynamicV2.attackabilityScheduled[index] = scheduledDynamicAttackabilityV2{event: event, action: action}
+		env.sim.AddPendingAction(action)
+	}
+	for index := env.dynamicV2.nextArmor; index < len(env.dynamicV2.config.EffectiveArmorEvents); index++ {
+		index := index
+		event := env.dynamicV2.config.EffectiveArmorEvents[index]
+		action := &core.PendingAction{
+			NextActionAt: time.Duration(event.TimeMS) * time.Millisecond,
+			Priority:     core.ActionPriorityDynamicTargetSemantics,
+			OnAction: func(sim *core.Simulation) {
+				env.applyDynamicArmorV2(index, event)
+			},
+		}
+		env.dynamicV2.armorScheduled[index] = scheduledDynamicArmorV2{event: event, action: action}
+		env.sim.AddPendingAction(action)
+	}
+}
+
+func (env *Environment) dynamicTargetSemanticsDueNowV2() bool {
+	if env.dynamicV2 == nil {
+		return false
+	}
+	if env.dynamicV2.nextAttackability < len(env.dynamicV2.config.AttackabilityEvents) &&
+		time.Duration(env.dynamicV2.config.AttackabilityEvents[env.dynamicV2.nextAttackability].TimeMS)*time.Millisecond <= env.sim.CurrentTime {
+		return true
+	}
+	return env.dynamicV2.nextArmor < len(env.dynamicV2.config.EffectiveArmorEvents) &&
+		time.Duration(env.dynamicV2.config.EffectiveArmorEvents[env.dynamicV2.nextArmor].TimeMS)*time.Millisecond <= env.sim.CurrentTime
+}
+
+func (env *Environment) applyDynamicAttackabilityV2(index int, event DynamicAttackabilityEventV2) {
+	if env.dynamicV2 == nil || index != env.dynamicV2.nextAttackability {
+		panic(fmt.Sprintf("dynamic attackability schedule advanced out of order at index %d", index))
+	}
+	target := env.sim.Encounter.TargetUnits[event.TargetIndex]
+	previous := env.sim.Encounter.DynamicTargetUnitIsAttackable(target)
+	status := DynamicTransitionApplied
+	var retargetedTo *int32
+	if env.sim.Encounter.DynamicTargetUnitIsDead(target) {
+		status = DynamicTransitionCanceledTargetDead
+	} else {
+		if _, err := env.sim.Encounter.SetDynamicTargetAttackable(target, event.Attackable); err != nil {
+			panic(fmt.Sprintf("apply attackability event %d: %v", index, err))
+		}
+		if previous == event.Attackable {
+			status = DynamicTransitionNoChange
+		}
+		retargetedTo = env.onDynamicAttackabilityTransitionV2(target, event.Attackable)
+	}
+	resulting := env.sim.Encounter.DynamicTargetUnitIsAttackable(target)
+	env.dynamicV2.attackabilityReceipts = append(env.dynamicV2.attackabilityReceipts, DynamicAttackabilityTransitionReceiptV2{
+		ScheduleIndex:       index,
+		TimeMS:              event.TimeMS,
+		TargetIndex:         event.TargetIndex,
+		RequestedAttackable: event.Attackable,
+		PreviousAttackable:  previous,
+		ResultingAttackable: resulting,
+		Status:              status,
+		RetargetedTo:        retargetedTo,
+	})
+	env.dynamicV2.nextAttackability++
+}
+
+func (env *Environment) onDynamicAttackabilityTransitionV2(target *core.Unit, attackable bool) *int32 {
+	character := env.player().GetCharacter()
+	if !attackable {
+		if character.CurrentTarget != target {
+			return nil
+		}
+		if env.dynamic.config.RetargetMode == DynamicRetargetRequireExplicit {
+			env.dynamic.retargetRequired = true
+			return nil
+		}
+		next := env.nextAliveTargetV1(target.Index)
+		if next == nil {
+			env.dynamic.retargetRequired = true
+			return nil
+		}
+		character.CurrentTarget = next
+		env.dynamic.retargetRequired = false
+		character.AutoAttacks.ResumeDynamicTargetSwings(env.sim)
+		retargeted := next.Index
+		return &retargeted
+	}
+
+	if env.sim.Encounter.DynamicTargetUnitIsAttackable(character.CurrentTarget) {
+		env.dynamic.retargetRequired = false
+		character.AutoAttacks.ResumeDynamicTargetSwings(env.sim)
+		return nil
+	}
+	if env.dynamic.config.RetargetMode == DynamicRetargetRequireExplicit {
+		env.dynamic.retargetRequired = true
+		return nil
+	}
+	character.CurrentTarget = target
+	env.dynamic.retargetRequired = false
+	character.AutoAttacks.ResumeDynamicTargetSwings(env.sim)
+	retargeted := target.Index
+	return &retargeted
+}
+
+func (env *Environment) applyDynamicArmorV2(index int, event DynamicEffectiveArmorEventV2) {
+	if env.dynamicV2 == nil || index != env.dynamicV2.nextArmor {
+		panic(fmt.Sprintf("dynamic armor schedule advanced out of order at index %d", index))
+	}
+	target := env.sim.Encounter.TargetUnits[event.TargetIndex]
+	previous := target.GetStat(stats.Armor)
+	resulting := previous
+	status := DynamicTransitionApplied
+	if env.sim.Encounter.DynamicTargetUnitIsDead(target) {
+		status = DynamicTransitionCanceledTargetDead
+	} else {
+		target.AddStatDynamic(env.sim, stats.Armor, event.EffectiveArmor-previous)
+		resulting = target.GetStat(stats.Armor)
+		if math.Float64bits(previous) == math.Float64bits(resulting) {
+			status = DynamicTransitionNoChange
+		}
+	}
+	env.dynamicV2.armorReceipts = append(env.dynamicV2.armorReceipts, DynamicArmorTransitionReceiptV2{
+		ScheduleIndex:           index,
+		TimeMS:                  event.TimeMS,
+		TargetIndex:             event.TargetIndex,
+		RequestedEffectiveArmor: event.EffectiveArmor,
+		PreviousTargetArmor:     previous,
+		ResultingTargetArmor:    resulting,
+		Status:                  status,
+	})
+	env.dynamicV2.nextArmor++
+}
+
+func (env *Environment) cancelRemainingDynamicTargetSemanticsV2() {
+	if env.dynamicV2 == nil {
+		return
+	}
+	for index := env.dynamicV2.nextAttackability; index < len(env.dynamicV2.attackabilityScheduled); index++ {
+		scheduled := env.dynamicV2.attackabilityScheduled[index]
+		if scheduled.action != nil {
+			scheduled.action.Cancel(env.sim)
+		}
+		target := env.sim.Encounter.TargetUnits[scheduled.event.TargetIndex]
+		current := env.sim.Encounter.DynamicTargetUnitIsAttackable(target)
+		env.dynamicV2.attackabilityReceipts = append(env.dynamicV2.attackabilityReceipts, DynamicAttackabilityTransitionReceiptV2{
+			ScheduleIndex:       index,
+			TimeMS:              scheduled.event.TimeMS,
+			TargetIndex:         scheduled.event.TargetIndex,
+			RequestedAttackable: scheduled.event.Attackable,
+			PreviousAttackable:  current,
+			ResultingAttackable: current,
+			Status:              DynamicTransitionCanceledEncounterFinished,
+		})
+	}
+	env.dynamicV2.nextAttackability = len(env.dynamicV2.attackabilityScheduled)
+	for index := env.dynamicV2.nextArmor; index < len(env.dynamicV2.armorScheduled); index++ {
+		scheduled := env.dynamicV2.armorScheduled[index]
+		if scheduled.action != nil {
+			scheduled.action.Cancel(env.sim)
+		}
+		target := env.sim.Encounter.TargetUnits[scheduled.event.TargetIndex]
+		current := target.GetStat(stats.Armor)
+		env.dynamicV2.armorReceipts = append(env.dynamicV2.armorReceipts, DynamicArmorTransitionReceiptV2{
+			ScheduleIndex:           index,
+			TimeMS:                  scheduled.event.TimeMS,
+			TargetIndex:             scheduled.event.TargetIndex,
+			RequestedEffectiveArmor: scheduled.event.EffectiveArmor,
+			PreviousTargetArmor:     current,
+			ResultingTargetArmor:    current,
+			Status:                  DynamicTransitionCanceledEncounterFinished,
+		})
+	}
+	env.dynamicV2.nextArmor = len(env.dynamicV2.armorScheduled)
+}
+
+func (env *Environment) DynamicAttackabilityReceiptsV2(cursor int) (DynamicAttackabilityReceiptBatchV2, error) {
+	result := DynamicAttackabilityReceiptBatchV2{}
+	if env.dynamicV2 == nil {
+		return result, errors.New("dynamic target semantics v2 is not enabled")
+	}
+	if cursor < 0 || cursor > len(env.dynamicV2.attackabilityReceipts) {
+		return result, fmt.Errorf("dynamic attackability receipt cursor %d out of range 0..%d", cursor, len(env.dynamicV2.attackabilityReceipts))
+	}
+	schema, digest := env.dynamicTargetSemanticsBindingV2()
+	result = DynamicAttackabilityReceiptBatchV2{
+		Schema:                schema,
+		ConfigDigest:          digest,
+		EnvironmentGeneration: env.dynamicV2.generation,
+		Cursor:                cursor,
+		NextCursor:            len(env.dynamicV2.attackabilityReceipts),
+		ScheduleComplete:      env.dynamicV2.nextAttackability == len(env.dynamicV2.attackabilityScheduled),
+		Receipts:              append([]DynamicAttackabilityTransitionReceiptV2(nil), env.dynamicV2.attackabilityReceipts[cursor:]...),
+	}
+	if result.Receipts == nil {
+		result.Receipts = make([]DynamicAttackabilityTransitionReceiptV2, 0)
+	}
+	return result, nil
+}
+
+func (env *Environment) DynamicArmorReceiptsV2(cursor int) (DynamicArmorReceiptBatchV2, error) {
+	result := DynamicArmorReceiptBatchV2{}
+	if env.dynamicV2 == nil {
+		return result, errors.New("dynamic target semantics v2 is not enabled")
+	}
+	if cursor < 0 || cursor > len(env.dynamicV2.armorReceipts) {
+		return result, fmt.Errorf("dynamic armor receipt cursor %d out of range 0..%d", cursor, len(env.dynamicV2.armorReceipts))
+	}
+	schema, digest := env.dynamicTargetSemanticsBindingV2()
+	result = DynamicArmorReceiptBatchV2{
+		Schema:                schema,
+		ConfigDigest:          digest,
+		EnvironmentGeneration: env.dynamicV2.generation,
+		Cursor:                cursor,
+		NextCursor:            len(env.dynamicV2.armorReceipts),
+		ScheduleComplete:      env.dynamicV2.nextArmor == len(env.dynamicV2.armorScheduled),
+		Receipts:              append([]DynamicArmorTransitionReceiptV2(nil), env.dynamicV2.armorReceipts[cursor:]...),
+	}
+	if result.Receipts == nil {
+		result.Receipts = make([]DynamicArmorTransitionReceiptV2, 0)
+	}
+	return result, nil
+}
+
+func (env *Environment) dynamicTargetSemanticsStateV2() *DynamicTargetSemanticsStateV2 {
+	if env.dynamicV2 == nil {
+		return nil
+	}
+	snapshots := env.sim.Encounter.DynamicTargetDamageSnapshots()
+	targets := make([]DynamicTargetSemanticsTargetStateV2, len(snapshots))
+	for index, snapshot := range snapshots {
+		var deathTimeMS *int64
+		if snapshot.Dead && snapshot.DeathTime != core.NeverExpires {
+			value := snapshot.DeathTime.Milliseconds()
+			deathTimeMS = &value
+		}
+		target := env.sim.Encounter.TargetUnits[index]
+		targets[index] = DynamicTargetSemanticsTargetStateV2{
+			TargetIndex:    snapshot.TargetIndex,
+			Attackable:     env.sim.Encounter.DynamicTargetUnitIsAttackable(target),
+			EffectiveArmor: target.GetStat(stats.Armor),
+			CurrentHealth:  snapshot.CurrentHealth,
+			Dead:           snapshot.Dead,
+			DeathTimeMS:    deathTimeMS,
+		}
+	}
+	schema, digest := env.dynamicTargetSemanticsBindingV2()
+	order := DynamicSameTimestampOrderV2
+	if env.dynamicV3 != nil {
+		order = DynamicSameTimestampOrderV3
+	}
+	return &DynamicTargetSemanticsStateV2{
+		Schema:                        schema,
+		ConfigDigest:                  digest,
+		EnvironmentGeneration:         env.dynamicV2.generation,
+		SameTimestampOrder:            order,
+		AttackabilityEventsProcessed:  len(env.dynamicV2.attackabilityReceipts),
+		AttackabilityEventsTotal:      len(env.dynamicV2.attackabilityScheduled),
+		EffectiveArmorEventsProcessed: len(env.dynamicV2.armorReceipts),
+		EffectiveArmorEventsTotal:     len(env.dynamicV2.armorScheduled),
+		Targets:                       targets,
+	}
+}
+
+func (env *Environment) dynamicTargetSemanticsBindingV2() (string, string) {
+	if env.dynamicV3 != nil {
+		return DynamicTargetSemanticsSchemaV3, env.dynamicV3.config.ContentSHA256
+	}
+	return DynamicTargetSemanticsSchemaV2, env.dynamicV2.config.ContentSHA256
+}
