+func spellCastCount(spell *core.Spell) int32 {
+	var casts int32
+	for _, metrics := range spell.SpellMetrics {
+		casts += metrics.Casts
+	}
+	return casts
+}
+
+func durationDelta(left time.Duration, right time.Duration) time.Duration {
+	delta := left - right
+	if delta < 0 {
+		return -delta
+	}
+	return delta
+}
+
+// setMainHandRemaining uses the public auto-attack reset primitive to build a
+// controlled decision state. A stale earlier scheduler wake-up is harmless:
+// the weapon-attack loop re-reads NextMHSwingAt before advancing time.
+func setMainHandRemaining(env *Environment, remaining time.Duration) time.Duration {
+	character := env.player().GetCharacter()
+	swingDuration := character.AutoAttacks.MainhandSwingSpeed()
+	character.AutoAttacks.StopMeleeUntil(
+		env.sim,
+		env.sim.CurrentTime+remaining-swingDuration,
+		false,
+	)
+	return character.AutoAttacks.NextMHSwingAt()
+}
