+	result := TargetDamageApplication{RequestedDamage: requested}
+	if !encounter.dynamicTargetHealthEnabled {
+		return result, errors.New("dynamic target health is not enabled")
+	}
+	if sim == nil || target == nil || target.Type != EnemyUnit {
+		return result, errors.New("dynamic damage target must be an enemy encounter unit")
+	}
+	if math.IsNaN(requested) || math.IsInf(requested, 0) || requested < 0 {
+		return result, errors.New("dynamic requested damage must be finite and non-negative")
+	}
+	index := int(target.Index)
+	if index < 0 || index >= len(encounter.TargetUnits) || encounter.TargetUnits[index] != target {
+		return result, errors.New("dynamic damage target is not bound to its encounter index")
+	}
+	if source != TargetDamageSourceSimulated && source != TargetDamageSourceBackground {
+		return result, errors.New("dynamic damage source is unsupported")
+	}
+	if !target.HasHealthBar() {
+		return result, errors.New("dynamic damage target has no health bar")
+	}
+	encounter.dynamicDamageOrdinal++
+	result.DamageOrdinal = encounter.dynamicDamageOrdinal
