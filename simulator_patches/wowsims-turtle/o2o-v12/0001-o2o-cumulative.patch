+	// inside both the 2379ms no-Flurry and 1830ms Flurry cast times.
+	originalDeadline := setMainHandRemaining(env, 500*time.Millisecond)
+	startAt := env.sim.CurrentTime
+	castDuration := spell.CastTime()
+	if originalDeadline >= startAt+castDuration {
+		t.Fatalf("test setup did not put the MH deadline inside Slam: deadline=%s start=%s cast=%s", originalDeadline, startAt, castDuration)
+	}
+
+	mhAuto := character.AutoAttacks.MHAuto()
+	mainHandCastsBeforeSlam := spellCastCount(mhAuto)
+	if _, err := env.Apply(slam); err != nil {
+		t.Fatal(err)
+	}
+	serverGOAt := character.Hardcast.Expires
+	for env.sim.CurrentTime < originalDeadline {
+		if env.sim.Step() {
+			t.Fatal("encounter ended before overdue main-hand deadline")
+		}
+	}
+	if got := spellCastCount(mhAuto); got != mainHandCastsBeforeSlam {
+		t.Fatalf("main hand fired during Slam before server GO: casts=%d, before=%d", got, mainHandCastsBeforeSlam)
+	}
+	if got := character.AutoAttacks.NextMHSwingAt(); durationDelta(got, serverGOAt) > core.SpellBatchWindow {
+		t.Fatalf("overdue main hand was not rescheduled to Slam GO: next=%s GO=%s", got, serverGOAt)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if spell.LastCastAt != serverGOAt {
+		t.Fatalf("Slam server GO = %s, want %s", spell.LastCastAt, serverGOAt)
+	}
+	if got := spellCastCount(mhAuto); got != mainHandCastsBeforeSlam+1 {
+		t.Fatalf("overdue main hand did not release once with Slam GO: casts=%d, before=%d", got, mainHandCastsBeforeSlam)
+	}
+	if delta := durationDelta(env.sim.CurrentTime, serverGOAt); delta > core.SpellBatchWindow {
+		t.Fatalf("decision resumed at %s, want Slam GO %s within one batch", env.sim.CurrentTime, serverGOAt)
+	}
+	if got := character.AutoAttacks.NextMHSwingAt(); got <= serverGOAt {
+		t.Fatalf("main-hand timer did not advance after GO release: next=%s GO=%s", got, serverGOAt)
+	}
+}
+
+func TestTurtleImprovedSlamReducesCastAndGCDByPointOneSecondsPerRank(t *testing.T) {
+	request := turtleSlamRequest()
+	request.Raid.Parties[0].Players[0].TalentsString = "30205020332-05050005025510051"
+	env, err := New(request, 456)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer env.Cleanup()
+
+	slam := env.player().GetCharacter().GetSpell(core.ActionID{SpellID: turtleSlamSpellID})
+	if slam == nil {
+		t.Fatal("Turtle Slam was not registered")
+	}
+	if slam.DefaultCast.CastTime != 2*time.Second {
+		t.Fatalf("5/5 Improved Slam cast time = %s, want 2s", slam.DefaultCast.CastTime)
+	}
+	if slam.DefaultCast.GCD != time.Second {
+		t.Fatalf("5/5 Improved Slam GCD = %s, want 1s", slam.DefaultCast.GCD)
+	}
+}
+
+func TestTurtleSlamCastTimeUsesFlurryMeleeSpeed(t *testing.T) {
+	env, err := New(turtleSlamRequest(), 321)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer env.Cleanup()
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+
+	character := env.player().GetCharacter()
+	spell := character.GetSpell(core.ActionID{SpellID: turtleSlamSpellID})
+	if spell == nil {
+		t.Fatal("rank-5 Slam was not registered")
+	}
+	withoutFlurry := spell.CastTime()
+	flurry := character.GetAuraByID(core.ActionID{SpellID: 12970})
+	if flurry == nil {
+		t.Fatal("5/5 Flurry aura was not registered")
+	}
+	flurry.Activate(env.sim)
+	flurry.SetStacks(env.sim, 3)
+	withFlurry := spell.CastTime()
+	want := time.Duration(float64(withoutFlurry) / 1.3)
+	if delta := math.Abs(float64(withFlurry - want)); delta > float64(time.Microsecond) {
+		t.Fatalf("Flurry Slam cast = %s, want %s", withFlurry, want)
+	}
+	if durationDelta(withFlurry, 1830*time.Millisecond) > 5*time.Millisecond {
+		t.Fatalf("live-profile Flurry Slam cast = %s, want about 1830ms", withFlurry)
+	}
+}
+
+func TestTurtleSlamCanCastWhileMoving(t *testing.T) {
+	env, err := New(turtleSlamRequest(), 456)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer env.Cleanup()
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+
+	character := env.player().GetCharacter()
+	character.MovementHandler.Moving = true
+	slam, legal := findAvailableSpell(env, turtleSlamSpellID)
+	if slam.SpellID == 0 || !legal {
+		t.Fatal("Turtle Slam must remain legal while moving")
+	}
+	result, err := env.Apply(slam)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !result.Casted {
+		t.Fatal("Turtle Slam cast was rejected while moving")
+	}
+}
