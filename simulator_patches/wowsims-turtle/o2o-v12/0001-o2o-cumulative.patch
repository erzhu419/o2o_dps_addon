+func TestDynamicV2BlockedAutoPreservesTimerAndRandomStream(t *testing.T) {
+	config := boundDynamicV2Config(
+		t,
+		DynamicRetargetRequireExplicit,
+		[]float64{100000},
+		nil,
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 555, TargetIndex: 0, Attackable: true},
+		},
+		nil,
+	)
+	blocked := newDynamicV2TestEnvironment(t, config, 98765)
+	control := newDynamicV2TestEnvironment(t, config, 98765)
+	control.player().GetCharacter().AutoAttacks.CancelAutoSwing(control.sim)
+
+	if err := blocked.Wait(555 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := blocked.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if err := control.Wait(555 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := control.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	control.player().GetCharacter().AutoAttacks.EnableAutoSwing(control.sim)
+
+	for _, env := range []*Environment{blocked, control} {
+		if err := env.Wait(core.SpellBatchWindow + time.Millisecond); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := env.AdvanceUntilDecision(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	blockedBatch, err := blocked.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	controlBatch, err := control.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(blockedBatch.Receipts) == 0 || !reflect.DeepEqual(blockedBatch.Receipts, controlBatch.Receipts) {
+		t.Fatalf("blocked autos consumed RNG or lost swing state:\nblocked=%+v\ncontrol=%+v", blockedBatch.Receipts, controlBatch.Receipts)
+	}
+	for _, receipt := range blockedBatch.Receipts {
+		if receipt.TimeMS < 555 || receipt.Status != DynamicDamageApplied {
+			t.Fatalf("auto damage escaped before reactivation: %+v", receipt)
+		}
+	}
+}
