+++ b/cmd/o2obridge/main.go
@@ -0,0 +1,381 @@
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"time"
+
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+	"github.com/isfir/wowsims-turtle/sim/o2o"
+	"google.golang.org/protobuf/encoding/protojson"
+)
+
+type command struct {
+	Command     string          `json:"command"`
+	Request     json.RawMessage `json:"request,omitempty"`
+	Seed        int64           `json:"seed,omitempty"`
+	Dynamic     json.RawMessage `json:"dynamic,omitempty"`
+	Action      o2o.ActionRef   `json:"action,omitempty"`
+	WaitMS      int64           `json:"wait_ms,omitempty"`
+	TargetIndex int32           `json:"target_index,omitempty"`
+	AttemptID   string          `json:"attempt_id,omitempty"`
+	AttemptIDs  []string        `json:"attempt_ids,omitempty"`
+	Cursor      int             `json:"cursor,omitempty"`
+}
+
+type response struct {
+	OK                             bool                                      `json:"ok"`
+	Command                        string                                    `json:"command"`
+	Error                          string                                    `json:"error,omitempty"`
+	State                          *o2o.State                                `json:"state,omitempty"`
+	Actions                        []o2o.AvailableAction                     `json:"actions,omitempty"`
+	Apply                          *o2o.ApplyResult                          `json:"apply,omitempty"`
+	CancelQueue                    *o2o.CancelQueuedMeleeResult              `json:"cancel_queue,omitempty"`
+	SetTarget                      *o2o.SetTargetResult                      `json:"set_target,omitempty"`
+	Control                        *o2o.ControlResult                        `json:"control,omitempty"`
+	ServerResults                  *o2o.ServerResultsResult                  `json:"server_results,omitempty"`
+	DynamicLoad                    *o2o.DynamicLoadReceiptV1                 `json:"dynamic_load,omitempty"`
+	DynamicDamageReceipts          *o2o.DynamicDamageReceiptBatchV1          `json:"dynamic_damage_receipts,omitempty"`
+	DynamicCandidateDamageReceipts *o2o.DynamicCandidateDamageReceiptBatchV1 `json:"dynamic_candidate_damage_receipts,omitempty"`
+	DynamicAttackabilityReceipts   *o2o.DynamicAttackabilityReceiptBatchV2   `json:"dynamic_attackability_receipts,omitempty"`
+	DynamicArmorReceipts           *o2o.DynamicArmorReceiptBatchV2           `json:"dynamic_armor_receipts,omitempty"`
+	DynamicIdleAdvanceReceipts     *o2o.DynamicIdleAdvanceReceiptBatchV3     `json:"dynamic_idle_advance_receipts,omitempty"`
+	EnvironmentGeneration          *uint64                                   `json:"environment_generation,omitempty"`
+}
+
+func main() {
+	runBridge(os.Stdin, os.Stdout, os.Stderr)
+}
+
+func runBridge(input io.Reader, output io.Writer, errorOutput io.Writer) {
+	scanner := bufio.NewScanner(input)
+	scanner.Buffer(make([]byte, 64*1024), 8*1024*1024)
+	encoder := json.NewEncoder(output)
+	var env *o2o.Environment
+	var environmentGeneration uint64
+
+	for scanner.Scan() {
+		var cmd command
+		if err := json.Unmarshal(scanner.Bytes(), &cmd); err != nil {
+			write(encoder, response{OK: false, Error: err.Error()})
+			continue
+		}
+		out := response{OK: true, Command: cmd.Command}
+		switch cmd.Command {
+		case "load":
+			request := &proto.RaidSimRequest{}
+			if err := protojson.Unmarshal(cmd.Request, request); err != nil {
+				out.OK, out.Error = false, err.Error()
+				break
+			}
+			if env != nil {
+				env.Cleanup()
+			}
+			var err error
+			env, err = o2o.New(request, cmd.Seed)
+			if err == nil {
+				_, err = env.AdvanceUntilDecision()
+			}
+			if err != nil {
+				out.OK, out.Error = false, err.Error()
+				env = nil
+				break
+			}
+			environmentGeneration++
+			state := env.State()
+			out.State = &state
+		case "load_dynamic_v1":
+			if len(cmd.Dynamic) == 0 {
+				out.OK, out.Error = false, "dynamic config is required"
+				break
+			}
+			var dynamic o2o.DynamicTeamBackgroundConfigV1
+			if err := json.Unmarshal(cmd.Dynamic, &dynamic); err != nil {
+				out.OK, out.Error = false, err.Error()
+				break
+			}
+			request := &proto.RaidSimRequest{}
+			if err := protojson.Unmarshal(cmd.Request, request); err != nil {
+				out.OK, out.Error = false, err.Error()
+				break
+			}
+			if env != nil {
+				env.Cleanup()
+			}
+			nextGeneration := environmentGeneration + 1
+			var receipt o2o.DynamicLoadReceiptV1
+			var err error
+			env, receipt, err = o2o.NewDynamicV1(request, cmd.Seed, dynamic, nextGeneration)
+			if err == nil {
+				_, err = env.AdvanceUntilDecision()
+			}
+			if err != nil {
+				out.OK, out.Error = false, err.Error()
+				env = nil
+				break
+			}
+			environmentGeneration = nextGeneration
+			out.DynamicLoad = &receipt
+			state := env.State()
+			out.State = &state
+		case "load_dynamic_v2":
+			if len(cmd.Dynamic) == 0 {
+				out.OK, out.Error = false, "dynamic config is required"
+				break
+			}
+			var dynamic o2o.DynamicTargetSemanticsConfigV2
+			decoder := json.NewDecoder(bytes.NewReader(cmd.Dynamic))
+			decoder.DisallowUnknownFields()
+			if err := decoder.Decode(&dynamic); err != nil {
+				out.OK, out.Error = false, err.Error()
+				break
+			}
+			request := &proto.RaidSimRequest{}
+			if err := protojson.Unmarshal(cmd.Request, request); err != nil {
+				out.OK, out.Error = false, err.Error()
+				break
+			}
+			if env != nil {
+				env.Cleanup()
+			}
+			nextGeneration := environmentGeneration + 1
+			var receipt o2o.DynamicLoadReceiptV1
+			var err error
+			env, receipt, err = o2o.NewDynamicV2(request, cmd.Seed, dynamic, nextGeneration)
+			if err == nil {
+				_, err = env.AdvanceUntilDecision()
+			}
+			if err != nil {
+				out.OK, out.Error = false, err.Error()
+				env = nil
+				break
+			}
+			environmentGeneration = nextGeneration
+			out.DynamicLoad = &receipt
+			state := env.State()
+			out.State = &state
+		case "load_dynamic_v3":
+			if len(cmd.Dynamic) == 0 {
+				out.OK, out.Error = false, "dynamic config is required"
+				break
+			}
+			var dynamic o2o.DynamicTargetSemanticsConfigV3
+			decoder := json.NewDecoder(bytes.NewReader(cmd.Dynamic))
+			decoder.DisallowUnknownFields()
+			if err := decoder.Decode(&dynamic); err != nil {
+				out.OK, out.Error = false, err.Error()
+				break
+			}
+			if err := decoder.Decode(&struct{}{}); err != io.EOF {
+				out.OK, out.Error = false, "dynamic config must contain exactly one JSON object"
+				break
+			}
+			request := &proto.RaidSimRequest{}
+			if err := protojson.Unmarshal(cmd.Request, request); err != nil {
+				out.OK, out.Error = false, err.Error()
+				break
+			}
+			if env != nil {
+				env.Cleanup()
+			}
+			nextGeneration := environmentGeneration + 1
+			var receipt o2o.DynamicLoadReceiptV1
+			var err error
+			env, receipt, err = o2o.NewDynamicV3(request, cmd.Seed, dynamic, nextGeneration)
+			if err == nil {
+				_, err = env.AdvanceUntilDecision()
+			}
+			if err != nil {
+				out.OK, out.Error = false, err.Error()
+				env = nil
+				break
+			}
+			environmentGeneration = nextGeneration
+			out.DynamicLoad = &receipt
+			state := env.State()
+			out.State = &state
+		case "advance":
+			if requireEnv(&out, env) {
+				_, err := env.AdvanceUntilDecision()
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					state := env.State()
+					out.State = &state
+				}
+			}
+		case "state":
+			if requireEnv(&out, env) {
+				state := env.State()
+				out.State = &state
+			}
+		case "actions":
+			if requireEnv(&out, env) {
+				out.Actions = env.AvailableActions()
+			}
+		case "act":
+			if requireEnv(&out, env) {
+				result, err := env.ApplyWithAttemptID(cmd.Action, cmd.AttemptID)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.Apply = &result
+					state := env.State()
+					out.State = &state
+				}
+			}
+		case "cancel_queue":
+			if requireEnv(&out, env) {
+				result, err := env.CancelQueuedMelee()
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.CancelQueue = &result
+					state := env.State()
+					out.State = &state
+				}
+			}
+		case "start_attack":
+			if requireEnv(&out, env) {
+				result, err := env.StartAttack()
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.Control = &result
+					state := env.State()
+					out.State = &state
+				}
+			}
+		case "stop_cast":
+			if requireEnv(&out, env) {
+				result, err := env.StopCast()
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.Control = &result
+					state := env.State()
+					out.State = &state
+				}
+			}
+		case "server_results":
+			if requireEnv(&out, env) {
+				result, err := env.ServerResultsSinceLastDecision(cmd.AttemptIDs)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.ServerResults = &result
+				}
+			}
+		case "dynamic_damage_receipts":
+			if requireEnv(&out, env) {
+				result, err := env.DynamicDamageReceiptsV1(cmd.Cursor)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.DynamicDamageReceipts = &result
+				}
+			}
+		case "dynamic_candidate_damage_receipts":
+			if requireEnv(&out, env) {
+				result, err := env.DynamicCandidateDamageReceiptsV1(cmd.Cursor)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.DynamicCandidateDamageReceipts = &result
+				}
+			}
+		case "dynamic_attackability_receipts":
+			if requireEnv(&out, env) {
+				result, err := env.DynamicAttackabilityReceiptsV2(cmd.Cursor)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.DynamicAttackabilityReceipts = &result
+				}
+			}
+		case "dynamic_armor_receipts":
+			if requireEnv(&out, env) {
+				result, err := env.DynamicArmorReceiptsV2(cmd.Cursor)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.DynamicArmorReceipts = &result
+				}
+			}
+		case "dynamic_idle_advance_receipts":
+			if requireEnv(&out, env) {
+				result, err := env.DynamicIdleAdvanceReceiptsV3(cmd.Cursor)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.DynamicIdleAdvanceReceipts = &result
+				}
+			}
+		case "set_target":
+			if requireEnv(&out, env) {
+				result, err := env.SetTarget(cmd.TargetIndex)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					out.SetTarget = &result
+					state := env.State()
+					out.State = &state
+				}
+			}
+		case "wait":
+			if requireEnv(&out, env) {
+				err := env.Wait(time.Duration(cmd.WaitMS) * time.Millisecond)
+				if err != nil {
+					out.OK, out.Error = false, err.Error()
+				} else {
+					state := env.State()
+					out.State = &state
+				}
+			}
+		case "close":
+			if env != nil {
+				env.Cleanup()
+			}
+			bindDynamicGeneration(&out, env)
+			write(encoder, out)
+			return
+		default:
+			out.OK, out.Error = false, fmt.Sprintf("unknown command %q", cmd.Command)
+		}
+		bindDynamicGeneration(&out, env)
+		write(encoder, out)
+	}
+	if err := scanner.Err(); err != nil {
+		fmt.Fprintln(errorOutput, err)
+	}
+	if env != nil {
+		env.Cleanup()
+	}
+}
+
+func bindDynamicGeneration(out *response, env *o2o.Environment) {
+	if env == nil || !env.DynamicEnabledV1() {
+		return
+	}
+	generation := env.DynamicGenerationV1()
+	out.EnvironmentGeneration = &generation
+}
+
+func requireEnv(out *response, env *o2o.Environment) bool {
+	if env != nil {
+		return true
+	}
+	out.OK = false
+	out.Error = "load a RaidSimRequest first"
+	return false
+}
+
+func write(encoder *json.Encoder, out response) {
+	if err := encoder.Encode(out); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+	}
+}
diff --git a/cmd/o2obridge/main_test.go b/cmd/o2obridge/main_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..44c9136e15d1dd8a7831c34c1ce32b876af2bebe
--- /dev/null
+++ b/cmd/o2obridge/main_test.go
@@ -0,0 +1,248 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	rootSim "github.com/isfir/wowsims-turtle/sim"
+	"github.com/isfir/wowsims-turtle/sim/core"
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+	"github.com/isfir/wowsims-turtle/sim/core/stats"
+	"github.com/isfir/wowsims-turtle/sim/o2o"
+	"google.golang.org/protobuf/encoding/protojson"
+)
+
+func bridgeDynamicTestRequest(t *testing.T, health float64) json.RawMessage {
+	t.Helper()
+	rootSim.RegisterAll()
+	gear := core.GetGearSet("../../ui/warrior/gear_sets", "phase_1").GearSet
+	player := core.WithSpec(&proto.Player{
+		Class:              proto.Class_ClassWarrior,
+		Race:               proto.Race_RaceOrc,
+		Equipment:          gear,
+		TalentsString:      "30305001302-05050005525010051",
+		DistanceFromTarget: 5,
+		Rotation:           &proto.APLRotation{},
+	}, &proto.Player_Warrior{Warrior: &proto.Warrior{Options: &proto.Warrior_Options{
+		StartingRage: 100,
+		Stance:       proto.WarriorStance_WarriorStanceBerserker,
+	}}})
+	request := &proto.RaidSimRequest{
+		Raid:      core.SinglePlayerRaidProto(player, &proto.PartyBuffs{}, &proto.RaidBuffs{}, &proto.Debuffs{}),
+		Encounter: core.MakeSingleTargetEncounter(60),
+		SimOptions: &proto.SimOptions{
+			Iterations:  1,
+			RandomSeed:  1,
+			Interactive: true,
+			IsTest:      true,
+		},
+	}
+	request.Encounter.UseHealth = true
+	request.Encounter.Targets[0].Stats = make([]float64, stats.Len)
+	request.Encounter.Targets[0].Stats[stats.Health] = health
+	payload, err := protojson.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return payload
+}
+
+func TestRunBridgeRepeatedDynamicLoadsReplaceGenerationAndBindReceipts(t *testing.T) {
+	const health = 1_000_000.0
+	config := o2o.DynamicTeamBackgroundConfigV1{
+		Schema:             o2o.DynamicTeamBackgroundSchemaV1,
+		TargetHealth:       []o2o.DynamicTargetHealthV1{{TargetIndex: 0, Health: health}},
+		SameTimestampOrder: o2o.DynamicSameTimestampOrderV1,
+		RetargetMode:       o2o.DynamicRetargetNextAliveCyclic,
+	}
+	digest, err := o2o.DynamicTeamBackgroundDigestV1(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.ContentSHA256 = digest
+	request := bridgeDynamicTestRequest(t, health)
+	dynamicPayload, err := json.Marshal(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	commands := []command{
+		{Command: "load_dynamic_v1", Request: request, Seed: 11, Dynamic: dynamicPayload},
+		{Command: "load_dynamic_v1", Request: request, Seed: 12, Dynamic: dynamicPayload},
+		{Command: "dynamic_candidate_damage_receipts", Cursor: 0},
+		{Command: "close"},
+	}
+	var input bytes.Buffer
+	encoder := json.NewEncoder(&input)
+	for _, cmd := range commands {
+		if err := encoder.Encode(cmd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var output bytes.Buffer
+	var stderr bytes.Buffer
+	runBridge(&input, &output, &stderr)
+	if stderr.Len() != 0 {
+		t.Fatalf("bridge stderr: %s", stderr.String())
+	}
+
+	decoder := json.NewDecoder(&output)
+	responses := make([]response, 0, len(commands))
+	for decoder.More() {
+		var got response
+		if err := decoder.Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		responses = append(responses, got)
+	}
+	if len(responses) != len(commands) {
+		t.Fatalf("got %d responses, want %d: %s", len(responses), len(commands), output.String())
+	}
+	for index := 0; index < 2; index++ {
+		got := responses[index]
+		wantGeneration := uint64(index + 1)
+		if !got.OK || got.DynamicLoad == nil || got.State == nil || got.EnvironmentGeneration == nil ||
+			*got.EnvironmentGeneration != wantGeneration || got.DynamicLoad.EnvironmentGeneration != wantGeneration ||
+			got.DynamicLoad.ConfigDigest != digest || got.State.DynamicTeamBackground == nil ||
+			got.State.DynamicTeamBackground.EnvironmentGeneration != wantGeneration ||
+			got.DynamicLoad.AttackabilityEventCount != nil || got.DynamicLoad.EffectiveArmorEventCount != nil ||
+			got.State.DynamicTargetSemantics != nil {
+			t.Fatalf("dynamic load %d lost atomic generation/content binding: %+v", index, got)
+		}
+	}
+	batch := responses[2].DynamicCandidateDamageReceipts
+	if !responses[2].OK || batch == nil || batch.EnvironmentGeneration != 2 || batch.ConfigDigest != digest || batch.Cursor != 0 || batch.NextCursor != 0 || len(batch.Receipts) != 0 {
+		t.Fatalf("candidate receipt command is not bound to replacement environment: %+v", responses[2])
+	}
+	if !responses[3].OK || responses[3].EnvironmentGeneration == nil || *responses[3].EnvironmentGeneration != 2 {
+		t.Fatalf("close response lost current generation: %+v", responses[3])
+	}
+}
