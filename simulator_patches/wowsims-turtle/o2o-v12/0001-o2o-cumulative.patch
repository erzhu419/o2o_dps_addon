+func TestSingletonHealthExportsEncounterProgressAndStopsAtExactBudget(t *testing.T) {
+	request := testWarriorRequest()
+	request.Encounter.UseHealth = true
+	request.Encounter.Duration = (2 * time.Hour).Seconds()
+	request.Encounter.Targets[0].Stats = make([]float64, stats.Len)
+	request.Encounter.Targets[0].Stats[stats.Health] = 1_000_000
+	env := newTestWarriorEnvironment(t, request)
+
+	initial := env.State()
+	if env.sim.Duration != 2*time.Hour {
+		t.Fatalf("health fight shortened the caller watchdog duration: got %s", env.sim.Duration)
+	}
+	if initial.EncounterDamageTaken != 0 || initial.EncounterHealthTarget != 1_000_000 {
+		t.Fatalf("unexpected initial health-fight progress: %+v", initial)
+	}
+
+	spell, action := requireSpellAction(t, env, 0, 23894)
+	character := env.player().GetCharacter()
+	target := character.CurrentTarget
+	attackTable := character.AttackTables[target.UnitIndex][spell.CastType]
+	if attackTable == nil {
+		t.Fatalf("attack table not found for %s", spell.ActionID)
+	}
+	character.PseudoStats.InFrontOfTarget = false
+	attackTable.BaseMissChance = 0
+	attackTable.BaseDodgeChance = 0
+	attackTable.BaseParryChance = 0
+
+	result, err := env.Apply(action)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !result.Casted || !result.ConsumesDecision {
+		t.Fatalf("Bloodthirst did not consume the health-fight decision: %+v", result)
+	}
+	afterHit := env.State()
+	if afterHit.EncounterDamageTaken <= 0 {
+		t.Fatalf("health-fight damage was not exported: %+v", afterHit)
+	}
+
+	// A discrete hit can land exactly on a numeric kill budget. Put the health
+	// fight on that exact boundary; the next Step must finish immediately instead
+	// of processing another event or attack.
+	env.sim.Encounter.DamageTaken = env.sim.Encounter.EndFightAtHealth
+	exactBoundary := env.State()
+	finished, err := env.AdvanceUntilDecision()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !finished {
+		t.Fatal("exact health budget did not finish the encounter")
+	}
+	terminal := env.State()
+	if terminal.TimeMS != exactBoundary.TimeMS {
+		t.Fatalf("exact health completion advanced time: before=%d after=%d", exactBoundary.TimeMS, terminal.TimeMS)
+	}
+	if terminal.EncounterDamageTaken != exactBoundary.EncounterDamageTaken {
+		t.Fatalf("exact health completion processed extra damage: before=%f after=%f", exactBoundary.EncounterDamageTaken, terminal.EncounterDamageTaken)
+	}
+	if terminal.EncounterHealthTarget != exactBoundary.EncounterDamageTaken {
+		t.Fatalf("exact health target was not exported: %+v", terminal)
+	}
+}
