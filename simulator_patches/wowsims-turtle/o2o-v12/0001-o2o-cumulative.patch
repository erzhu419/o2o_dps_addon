+
+func (aa *AutoAttacks) resumeDynamicTargetSwings(sim *Simulation) {
+	resume := func(wa *WeaponAttack) {
+		if !wa.dynamicTargetBlocked {
+			return
+		}
+		wa.swingAt = max(wa.dynamicTargetReadyAt, sim.CurrentTime)
+		wa.dynamicTargetBlocked = false
+		wa.dynamicTargetReadyAt = NeverExpires
+		sim.rescheduleWeaponAttack(wa.swingAt)
+	}
+	if aa.AutoSwingMelee {
+		resume(&aa.mh)
+		if aa.IsDualWielding {
+			resume(&aa.oh)
+		}
+	}
+	if aa.AutoSwingRanged {
+		resume(&aa.ranged)
+	}
