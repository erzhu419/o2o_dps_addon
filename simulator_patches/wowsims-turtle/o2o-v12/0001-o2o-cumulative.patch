@@ -0,0 +1,62 @@
+package o2o
+
+import (
+	"math"
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+	"github.com/isfir/wowsims-turtle/sim/core/stats"
+)
+
+func TestTurtleSunderMatchesPhase5ArmorStrata(t *testing.T) {
+	request := turtleSlamRequest()
+	request.Encounter.Targets[0].Stats[stats.Armor] = 4211
+	request.Raid.Parties[0].Players[0].Buffs = &proto.IndividualBuffs{
+		RallyingCryOfTheDragonslayer: true,
+	}
+	env := newTestWarriorEnvironment(t, request)
+
+	spell, action := requireSpellAction(t, env, 0, 11597)
+	if spell.DefaultCast.Cost != 10 {
+		t.Fatalf("Turtle rank-5 Sunder Armor cost = %.0f, want 10", spell.DefaultCast.Cost)
+	}
+
+	character := env.player().GetCharacter()
+	target := character.CurrentTarget
+	attackTable := character.AttackTables[target.UnitIndex][spell.CastType]
+	character.PseudoStats.InFrontOfTarget = false
+	attackTable.BaseMissChance = 0
+	attackTable.BaseDodgeChance = 0
+	attackTable.BaseParryChance = 0
+
+	for stacks := 1; stacks <= 5; stacks++ {
+		beforeRage := env.State().Power.Current
+		result, err := env.Apply(action)
+		if err != nil || !result.Casted {
+			t.Fatalf("Sunder Armor stack %d failed: result=%+v error=%v", stacks, result, err)
+		}
+		if stacks == 1 {
+			if got := beforeRage - env.State().Power.Current; math.Abs(got-10) > 1e-9 {
+				t.Fatalf("first Sunder Armor rage cost = %.9f, want 10", got)
+			}
+		}
+		wantArmor := 4211.0 - 450.0*float64(stacks)
+		if got := env.State().TargetArmor; math.Abs(got-wantArmor) > 1e-9 {
+			t.Fatalf("Sunder Armor stack %d target armor = %.9f, want %.9f", stacks, got, wantArmor)
+		}
+		if stacks < 5 {
+			if _, err := env.AdvanceUntilDecision(); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+
+	aura := target.GetAuraByID(core.ActionID{SpellID: 11597})
+	if aura == nil || !aura.IsActive() || aura.GetStacks() != 5 {
+		t.Fatalf("Sunder Armor aura after five casts = %+v, want active with five stacks", aura)
+	}
+	if aura.Duration.Seconds() != 30 {
+		t.Fatalf("Sunder Armor duration = %s, want 30s", aura.Duration)
+	}
+}
