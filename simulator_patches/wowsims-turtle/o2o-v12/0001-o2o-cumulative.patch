+		{Command: "dynamic_damage_receipts", Cursor: 0},
+		{Command: "wait", WaitMS: 100},
+		{Command: "advance"},
+		{Command: "dynamic_attackability_receipts", Cursor: 1},
+		{Command: "close"},
+	}
+	var input bytes.Buffer
+	encoder := json.NewEncoder(&input)
+	for _, cmd := range commands {
+		if err := encoder.Encode(cmd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var output bytes.Buffer
+	var stderr bytes.Buffer
+	runBridge(&input, &output, &stderr)
+	if stderr.Len() != 0 {
+		t.Fatalf("bridge stderr: %s", stderr.String())
+	}
+	decoder := json.NewDecoder(&output)
+	responses := make([]response, 0, len(commands))
+	for decoder.More() {
+		var got response
+		if err := decoder.Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		responses = append(responses, got)
+	}
+	if len(responses) != len(commands) {
+		t.Fatalf("got %d responses, want %d: %s", len(responses), len(commands), output.String())
+	}
+	load := responses[0]
+	if !load.OK || load.DynamicLoad == nil || load.State == nil || load.EnvironmentGeneration == nil ||
+		*load.EnvironmentGeneration != 1 || load.DynamicLoad.Schema != o2o.DynamicTargetSemanticsSchemaV2 ||
+		load.DynamicLoad.ConfigDigest != digest || load.DynamicLoad.AttackabilityEventCount == nil ||
+		*load.DynamicLoad.AttackabilityEventCount != 2 || load.DynamicLoad.EffectiveArmorEventCount == nil ||
+		*load.DynamicLoad.EffectiveArmorEventCount != 1 || load.State.DynamicTargetSemantics == nil ||
+		load.State.DynamicTargetSemantics.Targets[0].Attackable || load.State.DynamicTargetSemantics.Targets[0].EffectiveArmor != 1721 {
+		t.Fatalf("dynamic-v2 load lost config/generation/state binding: %+v", load)
+	}
+	attack0 := responses[1].DynamicAttackabilityReceipts
+	if !responses[1].OK || attack0 == nil || attack0.ConfigDigest != digest || attack0.ScheduleComplete ||
+		attack0.Cursor != 0 || attack0.NextCursor != 1 || len(attack0.Receipts) != 1 || attack0.Receipts[0].ResultingAttackable {
+		t.Fatalf("initial attackability receipt is wrong: %+v", responses[1])
+	}
+	armor := responses[2].DynamicArmorReceipts
+	if !responses[2].OK || armor == nil || armor.ConfigDigest != digest || !armor.ScheduleComplete ||
+		len(armor.Receipts) != 1 || armor.Receipts[0].ResultingTargetArmor != 1721 {
+		t.Fatalf("armor receipt is wrong: %+v", responses[2])
+	}
+	background := responses[3].DynamicDamageReceipts
