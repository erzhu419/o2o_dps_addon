+		},
+		[]DynamicEffectiveArmorEventV2{
+			{ScheduleIndex: 0, TimeMS: 10, TargetIndex: 0, EffectiveArmor: 1000},
+			{ScheduleIndex: 1, TimeMS: 20, TargetIndex: 1, EffectiveArmor: 0},
+		},
