+func twoHandedWeaponSpecializationDamageMultiplier(rank int32) float64 {
+	return 1 + 0.02*float64(rank)
+}
+
+func twoHandedWeaponSpecializationApplies(spell *core.Spell) bool {
+	if spell.BonusCoefficient <= 0 {
+		return false
+	}
+	switch spell.SpellCode {
+	case SpellCode_WarriorBloodthirst,
+		SpellCode_WarriorExecute,
+		SpellCode_WarriorRevenge,
+		SpellCode_WarriorShieldSlam:
+		return false
+	}
+	switch spell.ActionID.SpellID {
+	case 6552, 7373: // Live Turtle Pummel and Hamstring deal fixed, non-weapon damage.
+		return false
+	}
+	return true
+}
