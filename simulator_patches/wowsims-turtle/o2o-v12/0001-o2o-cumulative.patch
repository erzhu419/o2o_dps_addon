+func TestDynamicV2GuardsTravelDotAoeAndBackgroundThenReactivates(t *testing.T) {
+	config := boundDynamicV2Config(
+		t,
+		DynamicRetargetNextAliveCyclic,
+		[]float64{10000, 10000},
+		[]BackgroundDamageEventV1{
+			{ScheduleIndex: 0, TimeMS: 10, TargetIndex: 0, EventID: "unattackable-background", Damage: 50},
+		},
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 10, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 40, TargetIndex: 0, Attackable: true},
+		},
+		nil,
+	)
+	env := newDynamicV2TestEnvironment(t, config, 456)
+	character := env.player().GetCharacter()
+	character.AutoAttacks.CancelAutoSwing(env.sim)
+	spell := character.AutoAttacks.MHAuto()
+	forceHitOnEveryTarget(t, env, spell)
+	target0 := env.sim.Encounter.TargetUnits[0]
+	target1 := env.sim.Encounter.TargetUnits[1]
+
+	// Calculate a projectile-like result while target 0 is attackable, then
+	// resolve it after the transition. The outcome/RNG commitment survives but
+	// DealDamage suppresses damage, threat, and callbacks at resolution.
+	inFlight := spell.CalcDamage(env.sim, target0, 100, spell.OutcomeMeleeSpecialHit)
+	core.StartDelayedAction(env.sim, core.DelayedActionOptions{
+		DoAt: 20 * time.Millisecond,
+		OnAction: func(sim *core.Simulation) {
+			spell.DealDamage(sim, inFlight)
+		},
+	})
+	if err := env.Wait(25 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if env.State().TargetIndex != 1 || env.State().NumTargets != 1 || target0.CurrentHealth() != 10000 {
+		t.Fatalf("unattackability did not retarget/cancel in-flight damage: %+v", env.State())
+	}
+	if _, err := env.SetTarget(0); err == nil || !strings.Contains(err.Error(), "unattackable") {
+		t.Fatalf("unattackable target accepted explicit selection: %v", err)
+	}
+
+	// Exercise the periodic and multi-target paths directly. Both flow through
+	// the same central resolution guard; target 1 remains damageable.
+	periodic := spell.CalcDamage(env.sim, target0, 80, spell.OutcomeAlwaysHit)
+	spell.DealPeriodicDamage(env.sim, periodic)
+	spell.CalcAndDealDamage(env.sim, target0, 70, spell.OutcomeAlwaysHit)
+	spell.CalcAndDealDamage(env.sim, target1, 70, spell.OutcomeAlwaysHit)
+	if target0.CurrentHealth() != 10000 || target1.CurrentHealth() >= 10000 {
+		t.Fatalf("periodic/AoE guard leaked or suppressed the wrong target: target0=%f target1=%f", target0.CurrentHealth(), target1.CurrentHealth())
+	}
+
+	if err := env.Wait(20 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.SetTarget(0); err != nil {
+		t.Fatalf("reactivated target could not be selected: %v", err)
+	}
+	spell.CalcAndDealDamage(env.sim, target0, 60, spell.OutcomeAlwaysHit)
+	if target0.CurrentHealth() >= 10000 {
+		t.Fatal("post-reactivation damage was not applied")
+	}
+
+	candidate, err := env.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(candidate.Receipts) != 6 {
+		t.Fatalf("candidate ledger has %d rows, want in-flight OH+travel+dot+2 aoe+reactivated direct: %+v", len(candidate.Receipts), candidate)
+	}
+	// The dual-wield fixture has one pull-time offhand result already in flight
+	// when CancelAutoSwing runs. It resolves at the same 10ms boundary and is a
+	// useful additional proof that target semantics precede pending auto damage.
+	for _, index := range []int{0, 1, 2, 3} {
+		receipt := candidate.Receipts[index]
+		if receipt.TargetIndex != 0 || receipt.Status != DynamicDamageCanceledTargetUnattackable ||
+			receipt.AppliedDamage != 0 || !receipt.OutcomeComputed || receipt.RandomStreamRewound {
+			t.Fatalf("unattackable candidate path %d escaped central cancellation: %+v", index, receipt)
+		}
+	}
+	if candidate.Receipts[4].TargetIndex != 1 || candidate.Receipts[4].Status != DynamicDamageApplied ||
+		candidate.Receipts[5].TargetIndex != 0 || candidate.Receipts[5].Status != DynamicDamageApplied {
+		t.Fatalf("attackable/reactivated damage paths were not applied: %+v", candidate.Receipts)
+	}
+	background, err := env.DynamicDamageReceiptsV1(0)
+	if err != nil || len(background.Receipts) != 1 || background.Receipts[0].Status != DynamicDamageCanceledTargetUnattackable {
+		t.Fatalf("background guard failed: batch=%+v err=%v", background, err)
+	}
+	attackability, err := env.DynamicAttackabilityReceiptsV2(0)
+	if err != nil || !attackability.ScheduleComplete || len(attackability.Receipts) != 2 ||
+		attackability.Receipts[0].RetargetedTo == nil || *attackability.Receipts[0].RetargetedTo != 1 ||
+		attackability.Receipts[1].ResultingAttackable != true {
+		t.Fatalf("attackability receipts lost transition/retarget evidence: batch=%+v err=%v", attackability, err)
+	}
+}
+
+func TestDynamicV2ArmorUsesDynamicStatsAndOnlyChangesLaterDamage(t *testing.T) {
+	config := boundDynamicV2Config(
+		t,
+		DynamicRetargetNextAliveCyclic,
+		[]float64{100000},
+		nil,
+		nil,
+		[]DynamicEffectiveArmorEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, EffectiveArmor: 2000},
+			{ScheduleIndex: 1, TimeMS: 100, TargetIndex: 0, EffectiveArmor: 0},
+		},
+	)
+	env := newDynamicV2TestEnvironment(t, config, 789)
+	character := env.player().GetCharacter()
+	character.AutoAttacks.CancelAutoSwing(env.sim)
+	spell := character.AutoAttacks.MHAuto()
+	target := env.sim.Encounter.TargetUnits[0]
+	before := spell.CalcAndDealDamage(env.sim, target, 1000, spell.OutcomeAlwaysHit).Damage
+	if got := target.GetStat(stats.Armor); math.Float64bits(got) != math.Float64bits(2000) {
+		t.Fatalf("time-zero armor = %.17g, want 2000", got)
+	}
+	if err := env.Wait(100 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	after := spell.CalcAndDealDamage(env.sim, target, 1000, spell.OutcomeAlwaysHit).Damage
+	if got := target.GetStat(stats.Armor); math.Float64bits(got) != math.Float64bits(0) {
+		t.Fatalf("post-transition armor = %.17g, want 0", got)
+	}
+	if !(after > before) {
+		t.Fatalf("dynamic armor did not affect only later physical damage: before=%f after=%f", before, after)
+	}
+	armor, err := env.DynamicArmorReceiptsV2(0)
+	if err != nil || !armor.ScheduleComplete || len(armor.Receipts) != 2 {
+		t.Fatalf("armor receipt schedule incomplete: batch=%+v err=%v", armor, err)
+	}
+	want := []DynamicArmorTransitionReceiptV2{
+		{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, RequestedEffectiveArmor: 2000, PreviousTargetArmor: 1000, ResultingTargetArmor: 2000, Status: DynamicTransitionApplied},
+		{ScheduleIndex: 1, TimeMS: 100, TargetIndex: 0, RequestedEffectiveArmor: 0, PreviousTargetArmor: 2000, ResultingTargetArmor: 0, Status: DynamicTransitionApplied},
+	}
+	if !reflect.DeepEqual(armor.Receipts, want) {
+		t.Fatalf("armor transition evidence differs:\n got=%+v\nwant=%+v", armor.Receipts, want)
+	}
+}
