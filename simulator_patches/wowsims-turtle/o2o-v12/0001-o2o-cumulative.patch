+// MultiplyMeleeSpeedAtWhiteSwingBoundary applies a melee-speed change caused
+// synchronously by a main-hand or off-hand white swing. The triggering hand has
+// already scheduled its next cycle, so that cycle is rescaled normally. The
+// opposite hand keeps the deadline it had before this boundary.
+func (unit *Unit) MultiplyMeleeSpeedAtWhiteSwingBoundary(sim *Simulation, amount float64, triggeringSwing ProcMask) {
+	aa := &unit.AutoAttacks
+	if !aa.enabled || !aa.AutoSwingMelee || !aa.IsDualWielding {
+		unit.MultiplyMeleeSpeed(sim, amount)
+		return
+	}
+
+	var oppositeHand *WeaponAttack
+	switch triggeringSwing {
+	case ProcMaskMeleeMHAuto:
+		oppositeHand = &aa.oh
+	case ProcMaskMeleeOHAuto:
+		oppositeHand = &aa.mh
+	default:
+		unit.MultiplyMeleeSpeed(sim, amount)
+		return
+	}
+
+	oppositeDeadline := oppositeHand.swingAt
+	unit.PseudoStats.MeleeSpeedMultiplier *= amount
+	for _, pet := range unit.DynamicMeleeSpeedPets {
+		pet.dynamicMeleeSpeedInheritance(amount)
+	}
+	aa.UpdateSwingTimers(sim)
+	oppositeHand.swingAt = oppositeDeadline
+	sim.rescheduleWeaponAttack(oppositeDeadline)
+}
