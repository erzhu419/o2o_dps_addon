+	gcdReadyAt := character.GCD.ReadyAt()
+
+	result, err := env.StopCast()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !result.Accepted || result.ConsumesDecision {
+		t.Fatalf("unexpected stop-cast result: %+v", result)
+	}
+	if character.IsCasting(env.sim) || env.State().CurrentCast != nil {
+		t.Fatal("Slam hardcast remained active after stop_cast")
+	}
+	if character.GCD.ReadyAt() != gcdReadyAt {
+		t.Fatalf("stop_cast changed GCD: got %s, want %s", character.GCD.ReadyAt(), gcdReadyAt)
+	}
+	second, err := env.StopCast()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second.Accepted || second.ConsumesDecision {
+		t.Fatalf("stop_cast without an active cast was not a no-op: %+v", second)
+	}
+
+	if err := env.Wait(3 * time.Second); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if got := spellCastCount(spell); got != 0 {
+		t.Fatalf("canceled Slam completed later through the GCD callback: casts=%d", got)
+	}
+}
