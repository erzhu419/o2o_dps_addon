+func newDynamicV2TestEnvironment(t *testing.T, config DynamicTargetSemanticsConfigV2, seed int64) *Environment {
+	t.Helper()
+	health := make([]float64, len(config.TargetHealth))
+	for index, target := range config.TargetHealth {
+		health[index] = target.Health
+	}
+	env, receipt, err := NewDynamicV2(dynamicRequest(health...), seed, config, 9)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(env.Cleanup)
+	if receipt.Schema != DynamicTargetSemanticsSchemaV2 || receipt.ConfigDigest != config.ContentSHA256 ||
+		receipt.EnvironmentGeneration != 9 || receipt.AttackabilityEventCount == nil ||
+		*receipt.AttackabilityEventCount != len(config.AttackabilityEvents) || receipt.EffectiveArmorEventCount == nil ||
+		*receipt.EffectiveArmorEventCount != len(config.EffectiveArmorEvents) {
+		t.Fatalf("dynamic-v2 load receipt lost its binding: %+v", receipt)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	return env
+}
