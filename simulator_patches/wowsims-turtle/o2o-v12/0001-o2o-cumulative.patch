+package database
+
+import (
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+)
+
+func TestTurtleFuryEnchantOverrides(t *testing.T) {
+	tests := []struct {
+		effectID int32
+		itemID   int32
+		spellID  int32
+		name     string
+		itemType proto.ItemType
+		stat     proto.Stat
+		value    float64
+	}{
+		{
+			effectID: 362,
+			itemID:   103,
+			spellID:  73,
+			name:     "Obsidian Belt Buckle",
+			itemType: proto.ItemType_ItemTypeWaist,
+			stat:     proto.Stat_StatStrength,
+			value:    10,
+		},
+		{
+			effectID: 93,
+			itemID:   0, // 42187 is the enchanting formula, not an applied item.
+			spellID:  49016,
+			name:     "Enchant Cloak - Agility",
+			itemType: proto.ItemType_ItemTypeBack,
+			stat:     proto.Stat_StatAgility,
+			value:    7,
+		},
+		{
+			effectID: 3016,
+			itemID:   18329,
+			spellID:  22840,
+			name:     "Arcanum of Rapidity",
+			itemType: proto.ItemType_ItemTypeHead,
+			stat:     proto.Stat_StatMeleeHaste,
+			value:    1,
+		},
+		{
+			effectID: 1068,
+			itemID:   0,
+			spellID:  57127,
+			name:     "Enchant Boots - Superior Stamina",
+			itemType: proto.ItemType_ItemTypeFeet,
+			stat:     proto.Stat_StatStamina,
+			value:    15,
+		},
+		{
+			effectID: 1267,
+			itemID:   92008,
+			spellID:  57154,
+			name:     "Invocation of Greater Arcane Fortitude",
+			itemType: proto.ItemType_ItemTypeHead,
+			stat:     proto.Stat_StatArcaneResistance,
+			value:    25,
+		},
+		{
+			effectID: 1257,
+			itemID:   0,
+			spellID:  57117,
+			name:     "Enchant Cloak - Greater Arcane Resistance",
+			itemType: proto.ItemType_ItemTypeBack,
+			stat:     proto.Stat_StatArcaneResistance,
+			value:    15,
+		},
+	}
+
+	for _, test := range tests {
+		var matches []*proto.UIEnchant
+		for _, enchant := range EnchantOverrides {
+			if enchant.EffectId == test.effectID && enchant.Type == test.itemType {
+				matches = append(matches, enchant)
+			}
+		}
+		if len(matches) != 1 {
+			t.Fatalf("effect %d on %s has %d overrides, want exactly one", test.effectID, test.itemType, len(matches))
+		}
+
+		enchant := matches[0]
+		if enchant.ItemId != test.itemID || enchant.SpellId != test.spellID || enchant.Name != test.name {
+			t.Fatalf("effect %d identity = item %d, spell %d, name %q", test.effectID, enchant.ItemId, enchant.SpellId, enchant.Name)
+		}
+		if int(test.stat) >= len(enchant.Stats) || enchant.Stats[test.stat] != test.value {
+			t.Fatalf("effect %d %s = %.0f, want %.0f", test.effectID, test.stat, enchant.Stats[test.stat], test.value)
+		}
+	}
+}
