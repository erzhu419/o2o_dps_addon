+const (
+	DynamicTargetSemanticsSchemaV3 = "o2o_dynamic_target_semantics/v3"
+	DynamicSameTimestampOrderV3    = "TARGET_SEMANTICS_BEFORE_BACKGROUND_BEFORE_IDLE_WAKE_BEFORE_CANDIDATE"
+
+	DynamicIdleAdvanceModeV3          = "CENTRAL_TO_NEXT_ATTACKABLE_OR_HORIZON"
+	DynamicIdleAdvanceReceiptSchemaV3 = "o2o_dynamic_idle_advance_receipts/v3"
+
+	DynamicIdleAdvanceAttackabilityRestored = "ATTACKABILITY_RESTORED"
+	DynamicIdleAdvanceAllTargetsDead        = "ALL_TARGETS_DEAD"
+	DynamicIdleAdvanceHorizonReached        = "SCENARIO_HORIZON_REACHED"
+	DynamicIdleAdvanceSimulatorTerminal     = "SIMULATOR_TERMINAL"
+
+	DynamicIdleWakeAttackability = "NEXT_ATTACKABILITY_TRUE"
+	DynamicIdleWakeHorizon       = "SCENARIO_HORIZON"
+)
+
+// DynamicTargetSemanticsConfigV3 is a versioned extension of v2. The explicit
+// horizon is bound to the caller's encounter duration before the health-mode
+// simulator expands its internal watchdog estimate.
+type DynamicTargetSemanticsConfigV3 struct {
+	Schema                 string                         `json:"schema"`
+	ContentSHA256          string                         `json:"content_sha256"`
+	TargetHealth           []DynamicTargetHealthV1        `json:"target_health"`
+	BackgroundDamageEvents []BackgroundDamageEventV1      `json:"background_damage_events"`
+	AttackabilityEvents    []DynamicAttackabilityEventV2  `json:"attackability_events"`
+	EffectiveArmorEvents   []DynamicEffectiveArmorEventV2 `json:"effective_armor_events"`
+	IdleAdvanceMode        string                         `json:"idle_advance_mode"`
+	IdleAdvanceHorizonMS   int64                          `json:"idle_advance_horizon_ms"`
+	SameTimestampOrder     string                         `json:"same_timestamp_order"`
+	RetargetMode           DynamicRetargetMode            `json:"retarget_mode"`
+}
+
+// DynamicIdleAdvanceReceiptV3 records one contiguous interval during which no
+// live target was attackable and the central environment scheduler, rather
+// than the policy, advanced time. Cursor deltas make already-pending
+// environment effects auditable; the three zero counters are scheduler-local
+// invariants, not claims that unrelated pending effects consumed no RNG.
+type DynamicIdleAdvanceReceiptV3 struct {
+	IdleAdvanceOrdinal       int    `json:"idle_advance_ordinal"`
+	StartTimeMS              int64  `json:"start_time_ms"`
+	EndTimeMS                int64  `json:"end_time_ms"`
+	PlannedWakeTimeMS        int64  `json:"planned_wake_time_ms"`
+	WakeSource               string `json:"wake_source"`
+	WakeAttemptCount         int    `json:"wake_attempt_count"`
+	Status                   string `json:"status"`
+	StartTargetIndex         *int32 `json:"start_target_index,omitempty"`
+	EndTargetIndex           *int32 `json:"end_target_index,omitempty"`
+	AttackableTargetsBefore  int    `json:"attackable_targets_before"`
+	AttackableTargetsAfter   int    `json:"attackable_targets_after"`
+	AttackabilityCursorStart int    `json:"attackability_cursor_start"`
+	AttackabilityCursorEnd   int    `json:"attackability_cursor_end"`
+	ArmorCursorStart         int    `json:"armor_cursor_start"`
+	ArmorCursorEnd           int    `json:"armor_cursor_end"`
+	BackgroundCursorStart    int    `json:"background_cursor_start"`
+	BackgroundCursorEnd      int    `json:"background_cursor_end"`
+	CandidateCursorStart     int    `json:"candidate_cursor_start"`
+	CandidateCursorEnd       int    `json:"candidate_cursor_end"`
+	PolicyActionsConsumed    int    `json:"policy_actions_consumed"`
+	PolicyTargetSelections   int    `json:"policy_target_selections_consumed"`
+	SchedulerRandomDraws     int    `json:"scheduler_random_draws"`
+	EnvironmentRetargeted    bool   `json:"environment_retargeted"`
+	AutoAdvancedDurationMS   int64  `json:"auto_advanced_duration_ms"`
+}
+
+type DynamicIdleAdvanceReceiptBatchV3 struct {
+	Schema                string                        `json:"schema"`
+	ConfigDigest          string                        `json:"config_digest"`
+	EnvironmentGeneration uint64                        `json:"environment_generation"`
+	Cursor                int                           `json:"cursor"`
+	NextCursor            int                           `json:"next_cursor"`
+	StreamClosed          bool                          `json:"stream_closed"`
+	Active                bool                          `json:"active"`
+	Receipts              []DynamicIdleAdvanceReceiptV3 `json:"receipts"`
+}
+
+type DynamicIdleAdvanceStateV3 struct {
+	Schema                string `json:"schema"`
+	ConfigDigest          string `json:"config_digest"`
+	EnvironmentGeneration uint64 `json:"environment_generation"`
+	Mode                  string `json:"mode"`
+	HorizonMS             int64  `json:"horizon_ms"`
+	Active                bool   `json:"active"`
+	ReceiptsProcessed     int    `json:"receipts_processed"`
+	TotalAutoAdvancedMS   int64  `json:"total_auto_advanced_ms"`
+	StreamClosed          bool   `json:"stream_closed"`
+	ActiveStartTimeMS     *int64 `json:"active_start_time_ms,omitempty"`
+	PlannedWakeTimeMS     *int64 `json:"planned_wake_time_ms,omitempty"`
+	PlannedWakeSource     string `json:"planned_wake_source,omitempty"`
+}
+
+type dynamicIdleAdvanceRuntimeV3 struct {
+	config            DynamicTargetSemanticsConfigV3
+	generation        uint64
+	receipts          []DynamicIdleAdvanceReceiptV3
+	totalMS           int64
+	active            bool
+	startTimeMS       int64
+	startTarget       *int32
+	attackStart       int
+	armorStart        int
+	backgroundStart   int
+	candidateStart    int
+	plannedWakeMS     int64
+	plannedWakeSource string
+	wakeAttempts      int
+	wakeAction        *core.PendingAction
+	horizonAction     *core.PendingAction
+}
+
+// Digest-only structs remain in lexical JSON-key order to match Python's
+// json.dumps(sort_keys=True, separators=(",", ":")) byte-for-byte.
+type dynamicDigestDocumentV3 struct {
+	AttackabilityEvents    []dynamicDigestAttackabilityEventV2 `json:"attackability_events"`
+	BackgroundDamageEvents []dynamicDigestEventV1              `json:"background_damage_events"`
+	EffectiveArmorEvents   []dynamicDigestArmorEventV2         `json:"effective_armor_events"`
+	IdleAdvanceHorizonMS   int64                               `json:"idle_advance_horizon_ms"`
+	IdleAdvanceMode        string                              `json:"idle_advance_mode"`
+	RetargetMode           DynamicRetargetMode                 `json:"retarget_mode"`
+	SameTimestampOrder     string                              `json:"same_timestamp_order"`
+	Schema                 string                              `json:"schema"`
+	TargetHealth           []dynamicDigestTargetV1             `json:"target_health"`
+}
+
+func DynamicTargetSemanticsDigestV3(config DynamicTargetSemanticsConfigV3) (string, error) {
+	if err := validateDynamicConfigV3(config, -1, 0); err != nil {
+		return "", err
+	}
+	document := dynamicDigestDocumentV3{
+		AttackabilityEvents:    make([]dynamicDigestAttackabilityEventV2, len(config.AttackabilityEvents)),
+		BackgroundDamageEvents: make([]dynamicDigestEventV1, len(config.BackgroundDamageEvents)),
+		EffectiveArmorEvents:   make([]dynamicDigestArmorEventV2, len(config.EffectiveArmorEvents)),
+		IdleAdvanceHorizonMS:   config.IdleAdvanceHorizonMS,
+		IdleAdvanceMode:        config.IdleAdvanceMode,
+		RetargetMode:           config.RetargetMode,
+		SameTimestampOrder:     config.SameTimestampOrder,
+		Schema:                 config.Schema,
+		TargetHealth:           make([]dynamicDigestTargetV1, len(config.TargetHealth)),
+	}
+	for index, target := range config.TargetHealth {
+		document.TargetHealth[index] = dynamicDigestTargetV1{
+			HealthIEEE754: fmt.Sprintf("%016x", math.Float64bits(target.Health)),
+			TargetIndex:   target.TargetIndex,
+		}
+	}
+	for index, event := range config.BackgroundDamageEvents {
+		document.BackgroundDamageEvents[index] = dynamicDigestEventV1{
+			DamageIEEE754: fmt.Sprintf("%016x", math.Float64bits(event.Damage)),
+			EventID:       event.EventID,
+			ScheduleIndex: event.ScheduleIndex,
+			TargetIndex:   event.TargetIndex,
+			TimeMS:        event.TimeMS,
+		}
+	}
+	for index, event := range config.AttackabilityEvents {
+		document.AttackabilityEvents[index] = dynamicDigestAttackabilityEventV2(event)
+	}
+	for index, event := range config.EffectiveArmorEvents {
+		document.EffectiveArmorEvents[index] = dynamicDigestArmorEventV2{
+			EffectiveArmorIEEE754: fmt.Sprintf("%016x", math.Float64bits(event.EffectiveArmor)),
+			ScheduleIndex:         event.ScheduleIndex,
+			TargetIndex:           event.TargetIndex,
+			TimeMS:                event.TimeMS,
+		}
+	}
+	payload, err := json.Marshal(document)
+	if err != nil {
+		return "", fmt.Errorf("marshal dynamic-v3 content binding: %w", err)
+	}
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func validateDynamicConfigV3(config DynamicTargetSemanticsConfigV3, requestTargetCount int, requestHorizon time.Duration) error {
+	if config.Schema != DynamicTargetSemanticsSchemaV3 {
+		return fmt.Errorf("dynamic schema must be %q", DynamicTargetSemanticsSchemaV3)
+	}
+	if config.SameTimestampOrder != DynamicSameTimestampOrderV3 {
+		return fmt.Errorf("same_timestamp_order must be %q", DynamicSameTimestampOrderV3)
+	}
+	if config.IdleAdvanceMode != DynamicIdleAdvanceModeV3 {
+		return fmt.Errorf("idle_advance_mode must be %q", DynamicIdleAdvanceModeV3)
+	}
+	if config.IdleAdvanceHorizonMS <= 0 || config.IdleAdvanceHorizonMS > math.MaxInt64/int64(time.Millisecond) {
+		return errors.New("idle_advance_horizon_ms is outside the supported positive duration range")
+	}
+	if requestHorizon > 0 && time.Duration(config.IdleAdvanceHorizonMS)*time.Millisecond != requestHorizon {
+		return fmt.Errorf("idle_advance_horizon_ms %d does not match RaidSimRequest encounter duration %dms", config.IdleAdvanceHorizonMS, requestHorizon.Milliseconds())
+	}
+	base := DynamicTargetSemanticsConfigV2{
+		Schema:                 DynamicTargetSemanticsSchemaV2,
+		TargetHealth:           config.TargetHealth,
+		BackgroundDamageEvents: config.BackgroundDamageEvents,
+		AttackabilityEvents:    config.AttackabilityEvents,
+		EffectiveArmorEvents:   config.EffectiveArmorEvents,
+		SameTimestampOrder:     DynamicSameTimestampOrderV2,
+		RetargetMode:           config.RetargetMode,
+	}
+	if err := validateDynamicConfigV2(base, requestTargetCount); err != nil {
+		return err
+	}
+	for index, event := range config.BackgroundDamageEvents {
+		if event.TimeMS > config.IdleAdvanceHorizonMS {
+			return fmt.Errorf("background_damage_events[%d].time_ms exceeds idle_advance_horizon_ms", index)
+		}
+	}
+	for index, event := range config.AttackabilityEvents {
+		if event.TimeMS > config.IdleAdvanceHorizonMS {
+			return fmt.Errorf("attackability_events[%d].time_ms exceeds idle_advance_horizon_ms", index)
+		}
+	}
+	for index, event := range config.EffectiveArmorEvents {
+		if event.TimeMS > config.IdleAdvanceHorizonMS {
+			return fmt.Errorf("effective_armor_events[%d].time_ms exceeds idle_advance_horizon_ms", index)
+		}
+	}
+	return nil
+}
+
+func NewDynamicV3(
+	request *proto.RaidSimRequest,
+	seed int64,
+	config DynamicTargetSemanticsConfigV3,
+	generation uint64,
+) (*Environment, DynamicLoadReceiptV1, error) {
+	receipt := DynamicLoadReceiptV1{}
+	if generation == 0 {
+		return nil, receipt, errors.New("environment_generation must be positive")
+	}
+	if request == nil || request.Encounter == nil {
+		return nil, receipt, errors.New("raid, encounter, and sim_options are required")
+	}
+	requestHorizon := time.Duration(math.Round(float64(time.Second) * request.Encounter.Duration))
+	if err := validateDynamicConfigV3(config, len(request.Encounter.Targets), requestHorizon); err != nil {
+		return nil, receipt, err
+	}
+	digest, err := DynamicTargetSemanticsDigestV3(config)
+	if err != nil {
+		return nil, receipt, err
+	}
+	if len(config.ContentSHA256) != sha256.Size*2 {
+		return nil, receipt, errors.New("content_sha256 must be 64 lowercase hexadecimal characters")
+	}
+	decodedDigest, decodeErr := hex.DecodeString(config.ContentSHA256)
+	if decodeErr != nil || config.ContentSHA256 != hex.EncodeToString(decodedDigest) {
+		return nil, receipt, errors.New("content_sha256 must be 64 lowercase hexadecimal characters")
+	}
+	if config.ContentSHA256 != digest {
+		return nil, receipt, fmt.Errorf("content_sha256 mismatch: got %s, computed %s", config.ContentSHA256, digest)
+	}
+
+	config.TargetHealth = append(make([]DynamicTargetHealthV1, 0, len(config.TargetHealth)), config.TargetHealth...)
+	config.BackgroundDamageEvents = append(make([]BackgroundDamageEventV1, 0, len(config.BackgroundDamageEvents)), config.BackgroundDamageEvents...)
+	config.AttackabilityEvents = append(make([]DynamicAttackabilityEventV2, 0, len(config.AttackabilityEvents)), config.AttackabilityEvents...)
+	config.EffectiveArmorEvents = append(make([]DynamicEffectiveArmorEventV2, 0, len(config.EffectiveArmorEvents)), config.EffectiveArmorEvents...)
+	v2 := DynamicTargetSemanticsConfigV2{
+		Schema:                 DynamicTargetSemanticsSchemaV2,
+		TargetHealth:           append(make([]DynamicTargetHealthV1, 0, len(config.TargetHealth)), config.TargetHealth...),
+		BackgroundDamageEvents: append(make([]BackgroundDamageEventV1, 0, len(config.BackgroundDamageEvents)), config.BackgroundDamageEvents...),
+		AttackabilityEvents:    append(make([]DynamicAttackabilityEventV2, 0, len(config.AttackabilityEvents)), config.AttackabilityEvents...),
+		EffectiveArmorEvents:   append(make([]DynamicEffectiveArmorEventV2, 0, len(config.EffectiveArmorEvents)), config.EffectiveArmorEvents...),
+		SameTimestampOrder:     DynamicSameTimestampOrderV2,
+		RetargetMode:           config.RetargetMode,
+	}
+	v2Digest, err := DynamicTargetSemanticsDigestV2(v2)
+	if err != nil {
+		return nil, receipt, err
+	}
+	v2.ContentSHA256 = v2Digest
+	env, _, err := NewDynamicV2(request, seed, v2, generation)
+	if err != nil {
+		return nil, receipt, err
+	}
+	env.dynamicV3 = &dynamicIdleAdvanceRuntimeV3{
+		config:     config,
+		generation: generation,
+		receipts:   make([]DynamicIdleAdvanceReceiptV3, 0),
+	}
+	env.scheduleDynamicHorizonV3()
+	env.dynamic.bindingSchema = DynamicTargetSemanticsSchemaV3
+	env.dynamic.bindingDigest = digest
+	env.dynamic.sameTimestampOrder = DynamicSameTimestampOrderV3
+
+	attackabilityCount := len(config.AttackabilityEvents)
+	armorCount := len(config.EffectiveArmorEvents)
+	mode := config.IdleAdvanceMode
+	horizonMS := config.IdleAdvanceHorizonMS
+	receiptSchema := DynamicIdleAdvanceReceiptSchemaV3
+	receipt = DynamicLoadReceiptV1{
+		Schema:                   DynamicTargetSemanticsSchemaV3,
+		ConfigDigest:             digest,
+		EnvironmentGeneration:    generation,
+		TargetCount:              len(config.TargetHealth),
+		BackgroundEventCount:     len(config.BackgroundDamageEvents),
+		SameTimestampOrder:       DynamicSameTimestampOrderV3,
+		RetargetMode:             config.RetargetMode,
+		AttackabilityEventCount:  &attackabilityCount,
+		EffectiveArmorEventCount: &armorCount,
+		IdleAdvanceMode:          &mode,
+		IdleAdvanceHorizonMS:     &horizonMS,
+		IdleAdvanceReceiptSchema: &receiptSchema,
+	}
+	return env, receipt, nil
+}
+
+// scheduleDynamicHorizonV3 makes the declared wave horizon terminal even while
+// a target remains attackable. Health-mode simulations otherwise replace the
+// request duration with a long watchdog and can run a counterfactual policy
+// beyond the historical exposure window. Environment transitions at the exact
+// boundary retain their higher priority; candidate combat work at or after the
+// boundary is not consumed.
+func (env *Environment) scheduleDynamicHorizonV3() {
+	runtime := env.dynamicV3
+	if runtime == nil || runtime.horizonAction != nil || env.finished {
+		return
+	}
+	action := &core.PendingAction{
+		NextActionAt: time.Duration(runtime.config.IdleAdvanceHorizonMS) * time.Millisecond,
+		Priority:     core.ActionPriorityDynamicIdleWake,
+		OnAction: func(sim *core.Simulation) {
+			runtime.horizonAction = nil
+			if env.finished {
+				return
+			}
+			env.finished = true
+			sim.NeedsInput = false
+			env.cancelRemainingDynamicTargetSemanticsV2()
+			env.cancelRemainingDynamicBackgroundV1()
+			env.finishDynamicIdleAdvanceV3(DynamicIdleAdvanceHorizonReached)
+		},
+	}
+	runtime.horizonAction = action
+	env.sim.AddPendingAction(action)
+}
+
+func (env *Environment) beginDynamicIdleAdvanceV3() bool {
+	if env.dynamicV3 == nil || env.dynamicV3.active || env.finished || !env.sim.NeedsInput {
+		return false
+	}
+	if env.sim.Encounter.DynamicAllTargetsDead() || env.sim.Environment.GetNumActiveTargets() != 0 {
+		return false
+	}
+	runtime := env.dynamicV3
+	runtime.active = true
+	runtime.startTimeMS = env.sim.CurrentTime.Milliseconds()
+	runtime.startTarget = env.currentTargetIndexV3()
+	runtime.attackStart = len(env.dynamicV2.attackabilityReceipts)
+	runtime.armorStart = len(env.dynamicV2.armorReceipts)
+	runtime.backgroundStart = len(env.dynamic.receipts)
+	runtime.candidateStart = len(env.dynamic.candidateReceipts)
+	runtime.wakeAttempts = 0
+	env.sim.NeedsInput = false
+	if runtime.startTimeMS >= runtime.config.IdleAdvanceHorizonMS {
+		env.finished = true
+		env.cancelRemainingDynamicTargetSemanticsV2()
+		env.cancelRemainingDynamicBackgroundV1()
+		env.finishDynamicIdleAdvanceV3(DynamicIdleAdvanceHorizonReached)
+		return true
+	}
+	env.scheduleNextDynamicIdleWakeV3()
+	return true
+}
+
+func (env *Environment) scheduleNextDynamicIdleWakeV3() {
+	runtime := env.dynamicV3
+	if runtime == nil || !runtime.active || env.finished {
+		return
+	}
+	currentMS := env.sim.CurrentTime.Milliseconds()
+	wakeMS := runtime.config.IdleAdvanceHorizonMS
+	wakeSource := DynamicIdleWakeHorizon
+	for index := env.dynamicV2.nextAttackability; index < len(env.dynamicV2.config.AttackabilityEvents); index++ {
+		event := env.dynamicV2.config.AttackabilityEvents[index]
+		if event.TimeMS <= currentMS || !event.Attackable || env.sim.Encounter.DynamicTargetIsDead(event.TargetIndex) {
+			continue
+		}
+		if event.TimeMS < wakeMS {
+			wakeMS = event.TimeMS
+			wakeSource = DynamicIdleWakeAttackability
+		}
+		break
+	}
+	runtime.plannedWakeMS = wakeMS
+	runtime.plannedWakeSource = wakeSource
+	runtime.wakeAttempts++
+	action := &core.PendingAction{
+		NextActionAt: time.Duration(wakeMS) * time.Millisecond,
+		Priority:     core.ActionPriorityDynamicIdleWake,
+		OnAction: func(sim *core.Simulation) {
+			runtime.wakeAction = nil
+			env.onDynamicIdleWakeV3()
+		},
+	}
+	runtime.wakeAction = action
+	env.sim.AddPendingAction(action)
+}
+
+func (env *Environment) onDynamicIdleWakeV3() {
+	if env.dynamicV3 == nil || !env.dynamicV3.active {
+		return
+	}
+	currentMS := env.sim.CurrentTime.Milliseconds()
+	if env.sim.Encounter.DynamicAllTargetsDead() {
+		env.finished = true
+		env.cancelRemainingDynamicTargetSemanticsV2()
+		env.cancelRemainingDynamicBackgroundV1()
+		env.finishDynamicIdleAdvanceV3(DynamicIdleAdvanceAllTargetsDead)
+		return
+	}
+	if currentMS >= env.dynamicV3.config.IdleAdvanceHorizonMS {
+		env.finished = true
+		env.cancelRemainingDynamicTargetSemanticsV2()
+		env.cancelRemainingDynamicBackgroundV1()
+		env.finishDynamicIdleAdvanceV3(DynamicIdleAdvanceHorizonReached)
+		return
+	}
+	if env.sim.Environment.GetNumActiveTargets() > 0 {
+		env.sim.NeedsInput = true
+		env.finishDynamicIdleAdvanceV3(DynamicIdleAdvanceAttackabilityRestored)
+		return
+	}
+	env.scheduleNextDynamicIdleWakeV3()
+}
+
+func (env *Environment) finishDynamicIdleAdvanceV3(status string) {
+	runtime := env.dynamicV3
+	if runtime == nil || !runtime.active {
+		return
+	}
+	if runtime.wakeAction != nil {
+		runtime.wakeAction.Cancel(env.sim)
+		runtime.wakeAction = nil
+	}
+	endTarget := env.currentTargetIndexV3()
+	endMS := env.sim.CurrentTime.Milliseconds()
+	retargeted := !sameOptionalTargetIndexV3(runtime.startTarget, endTarget)
+	if !retargeted {
+		for _, receipt := range env.dynamicV2.attackabilityReceipts[runtime.attackStart:] {
+			if receipt.RetargetedTo != nil {
+				retargeted = true
+				break
+			}
+		}
+	}
+	if !retargeted {
+		for _, receipt := range env.dynamic.receipts[runtime.backgroundStart:] {
+			if receipt.RetargetedTo != nil {
+				retargeted = true
+				break
+			}
+		}
+	}
+	if !retargeted {
+		for _, receipt := range env.dynamic.candidateReceipts[runtime.candidateStart:] {
+			if receipt.RetargetedTo != nil {
+				retargeted = true
+				break
+			}
+		}
+	}
+	durationMS := endMS - runtime.startTimeMS
+	if durationMS < 0 {
+		panic("dynamic idle advance moved time backwards")
+	}
+	runtime.receipts = append(runtime.receipts, DynamicIdleAdvanceReceiptV3{
+		IdleAdvanceOrdinal:       len(runtime.receipts),
+		StartTimeMS:              runtime.startTimeMS,
+		EndTimeMS:                endMS,
+		PlannedWakeTimeMS:        runtime.plannedWakeMS,
+		WakeSource:               runtime.plannedWakeSource,
+		WakeAttemptCount:         runtime.wakeAttempts,
+		Status:                   status,
+		StartTargetIndex:         cloneOptionalTargetIndexV3(runtime.startTarget),
+		EndTargetIndex:           cloneOptionalTargetIndexV3(endTarget),
+		AttackableTargetsBefore:  0,
+		AttackableTargetsAfter:   int(env.sim.Environment.GetNumActiveTargets()),
+		AttackabilityCursorStart: runtime.attackStart,
+		AttackabilityCursorEnd:   len(env.dynamicV2.attackabilityReceipts),
+		ArmorCursorStart:         runtime.armorStart,
+		ArmorCursorEnd:           len(env.dynamicV2.armorReceipts),
+		BackgroundCursorStart:    runtime.backgroundStart,
+		BackgroundCursorEnd:      len(env.dynamic.receipts),
+		CandidateCursorStart:     runtime.candidateStart,
+		CandidateCursorEnd:       len(env.dynamic.candidateReceipts),
+		PolicyActionsConsumed:    0,
+		PolicyTargetSelections:   0,
+		SchedulerRandomDraws:     0,
+		EnvironmentRetargeted:    retargeted,
+		AutoAdvancedDurationMS:   durationMS,
+	})
+	runtime.totalMS += durationMS
+	runtime.active = false
+}
+
+func (env *Environment) currentTargetIndexV3() *int32 {
+	if env == nil || env.sim == nil {
+		return nil
+	}
+	target := env.player().GetCharacter().CurrentTarget
+	if target == nil {
+		return nil
+	}
+	value := target.Index
+	return &value
+}
+
+func cloneOptionalTargetIndexV3(value *int32) *int32 {
+	if value == nil {
+		return nil
+	}
+	copy := *value
+	return &copy
+}
+
+func sameOptionalTargetIndexV3(left, right *int32) bool {
+	return (left == nil && right == nil) || (left != nil && right != nil && *left == *right)
+}
+
+func (env *Environment) DynamicIdleAdvanceReceiptsV3(cursor int) (DynamicIdleAdvanceReceiptBatchV3, error) {
+	result := DynamicIdleAdvanceReceiptBatchV3{}
+	if env.dynamicV3 == nil {
+		return result, errors.New("dynamic idle advance v3 is not enabled")
+	}
+	if cursor < 0 || cursor > len(env.dynamicV3.receipts) {
+		return result, fmt.Errorf("dynamic idle receipt cursor %d out of range 0..%d", cursor, len(env.dynamicV3.receipts))
+	}
+	result = DynamicIdleAdvanceReceiptBatchV3{
+		Schema:                DynamicIdleAdvanceReceiptSchemaV3,
+		ConfigDigest:          env.dynamicV3.config.ContentSHA256,
+		EnvironmentGeneration: env.dynamicV3.generation,
+		Cursor:                cursor,
+		NextCursor:            len(env.dynamicV3.receipts),
+		StreamClosed:          env.finished,
+		Active:                env.dynamicV3.active,
+		Receipts:              append([]DynamicIdleAdvanceReceiptV3(nil), env.dynamicV3.receipts[cursor:]...),
+	}
+	if result.Receipts == nil {
+		result.Receipts = make([]DynamicIdleAdvanceReceiptV3, 0)
+	}
+	return result, nil
+}
+
+func (env *Environment) dynamicIdleAdvanceStateV3() *DynamicIdleAdvanceStateV3 {
+	if env.dynamicV3 == nil {
+		return nil
+	}
+	state := &DynamicIdleAdvanceStateV3{
+		Schema:                DynamicIdleAdvanceReceiptSchemaV3,
+		ConfigDigest:          env.dynamicV3.config.ContentSHA256,
+		EnvironmentGeneration: env.dynamicV3.generation,
+		Mode:                  env.dynamicV3.config.IdleAdvanceMode,
+		HorizonMS:             env.dynamicV3.config.IdleAdvanceHorizonMS,
+		Active:                env.dynamicV3.active,
+		ReceiptsProcessed:     len(env.dynamicV3.receipts),
+		TotalAutoAdvancedMS:   env.dynamicV3.totalMS,
+		StreamClosed:          env.finished,
+	}
+	if env.dynamicV3.active {
+		start := env.dynamicV3.startTimeMS
+		wake := env.dynamicV3.plannedWakeMS
+		state.ActiveStartTimeMS = &start
+		state.PlannedWakeTimeMS = &wake
+		state.PlannedWakeSource = env.dynamicV3.plannedWakeSource
+	}
+	return state
+}
