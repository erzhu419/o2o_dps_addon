+package warrior
+
+import (
+	"math"
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+)
+
+func TestBerserkerStanceDamageTakenMultiplierRestoresOnExit(t *testing.T) {
+	party := &core.Party{Index: 0}
+	character := core.NewCharacter(party, 0, &proto.Player{
+		Name:      "stance-test",
+		Race:      proto.Race_RaceHuman,
+		Class:     proto.Class_ClassWarrior,
+		Spec:      &proto.Player_Warrior{Warrior: &proto.Warrior{}},
+		Equipment: &proto.EquipmentSpec{},
+	})
+	warrior := NewWarrior(&character, "", WarriorInputs{})
+	warrior.Unit.Env = &core.Environment{State: core.Constructed}
+	warrior.registerBerserkerStanceAura()
+	warrior.Unit.Env.State = core.Finalized
+
+	sim := &core.Simulation{}
+	baseline := warrior.PseudoStats.DamageTakenMultiplier
+	warrior.BerserkerStanceAura.Activate(sim)
+	if got, want := warrior.PseudoStats.DamageTakenMultiplier, baseline*1.1; math.Abs(got-want) > 1e-12 {
+		t.Fatalf("Berserker Stance damage taken multiplier on gain = %.12f, want %.12f", got, want)
+	}
+
+	warrior.BerserkerStanceAura.Deactivate(sim)
+	if got := warrior.PseudoStats.DamageTakenMultiplier; math.Abs(got-baseline) > 1e-12 {
+		t.Fatalf("Berserker Stance damage taken multiplier after exit = %.12f, want baseline %.12f", got, baseline)
+	}
+}
