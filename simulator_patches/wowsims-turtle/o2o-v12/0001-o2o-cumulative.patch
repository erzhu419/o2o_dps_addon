+	if err != nil || len(idle.Receipts) != 1 || idle.Receipts[0].Status != DynamicIdleAdvanceAttackabilityRestored ||
+		!idle.Receipts[0].EnvironmentRetargeted || idle.Receipts[0].WakeAttemptCount != 1 ||
+		idle.Receipts[0].AttackabilityCursorStart != 1 || idle.Receipts[0].AttackabilityCursorEnd != 3 {
+		t.Fatalf("death/retarget idle receipt is wrong: batch=%+v err=%v", idle, err)
+	}
+	attack, err := env.DynamicAttackabilityReceiptsV2(0)
+	if err != nil || len(attack.Receipts) != 3 || attack.Receipts[1].Status != DynamicTransitionCanceledTargetDead ||
+		attack.Receipts[2].RetargetedTo == nil || *attack.Receipts[2].RetargetedTo != 1 {
+		t.Fatalf("dead transition cancellation or cyclic retarget is wrong: batch=%+v err=%v", attack, err)
+	}
+}
+
+func TestDynamicV3AutomaticIdlePreservesV2ManualWaitRandomStream(t *testing.T) {
+	v3 := boundDynamicV3Config(
+		t,
+		DynamicRetargetRequireExplicit,
+		2000,
+		[]float64{100000},
+		nil,
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 555, TargetIndex: 0, Attackable: true},
+		},
+		nil,
+	)
+	automatic := newDynamicV3TestEnvironment(t, v3, 98765)
+	if _, err := automatic.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	v2 := boundDynamicV2Config(
+		t,
+		DynamicRetargetRequireExplicit,
+		[]float64{100000},
+		nil,
+		v3.AttackabilityEvents,
+		nil,
+	)
+	manual := newDynamicV2TestEnvironment(t, v2, 98765)
+	if err := manual.Wait(555 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := manual.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	for _, env := range []*Environment{automatic, manual} {
+		if err := env.Wait(core.SpellBatchWindow + time.Millisecond); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := env.AdvanceUntilDecision(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	automaticBatch, err := automatic.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manualBatch, err := manual.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(automaticBatch.Receipts) == 0 || !reflect.DeepEqual(automaticBatch.Receipts, manualBatch.Receipts) {
+		t.Fatalf("central idle consumed candidate RNG or changed swing state:\nautomatic=%+v\nmanual=%+v", automaticBatch.Receipts, manualBatch.Receipts)
+	}
+}
+
+func TestDynamicV3ValidationBindsHorizonAndV2RemainsManual(t *testing.T) {
+	config := boundDynamicV3Config(t, DynamicRetargetRequireExplicit, 200, []float64{1000}, nil,
+		[]DynamicAttackabilityEventV2{{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false}}, nil)
+	request := dynamicRequest(1000)
+	request.Encounter.Duration = 0.3
+	if _, _, err := NewDynamicV3(request, 1, config, 1); err == nil {
+		t.Fatal("dynamic-v3 accepted a horizon different from the request duration")
+	}
+
+	v2 := boundDynamicV2Config(t, DynamicRetargetRequireExplicit, []float64{1000}, nil,
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 100, TargetIndex: 0, Attackable: true},
+		}, nil)
+	legacy := newDynamicV2TestEnvironment(t, v2, 2)
+	state := legacy.State()
+	if state.TimeMS != 0 || !state.NeedsInput || state.NumTargets != 0 || state.DynamicIdleAdvance != nil {
+		t.Fatalf("new scheduler changed opt-in v2 behavior: %+v", state)
+	}
+}
