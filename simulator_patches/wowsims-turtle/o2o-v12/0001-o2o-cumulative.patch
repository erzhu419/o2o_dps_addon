+func TestTurtleSlamPreservesMainHandDeadlineAfterServerGO(t *testing.T) {
+	// Preserve the effective RNG stream used when this timing fixture was
+	// authored; New now treats 246 as absolute rather than doubling 123.
+	env, err := New(turtleSlamRequest(), 246)
+	if err != nil {
+		t.Fatal(err)
