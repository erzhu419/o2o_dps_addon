+	if spell == nil {
+		t.Fatal("rank-5 Slam was not registered")
+	}
+	slam, legal := findAvailableSpell(env, turtleSlamSpellID)
+	if !legal {
+		t.Fatal("Turtle rank-5 Slam must be legal")
+	}
+
+	// The live "early" trials cast just after a white swing. The next main-hand
+	// deadline therefore remains beyond Slam's server GO.
+	preservedDeadline := setMainHandRemaining(env, character.AutoAttacks.MainhandSwingSpeed())
+	startAt := env.sim.CurrentTime
+	castDuration := spell.CastTime()
+	if preservedDeadline <= startAt+castDuration {
+		t.Fatalf("test setup did not put the MH deadline after Slam GO: deadline=%s start=%s cast=%s", preservedDeadline, startAt, castDuration)
+	}
+
+	if _, err := env.Apply(slam); err != nil {
+		t.Fatal(err)
+	}
+	mhAuto := character.AutoAttacks.MHAuto()
+	mainHandCastsBeforeGO := spellCastCount(mhAuto)
+	serverGOAt := character.Hardcast.Expires
+	if got := character.AutoAttacks.NextMHSwingAt(); got != preservedDeadline {
+		t.Fatalf("Slam start moved future MH deadline: got %s, want %s", got, preservedDeadline)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if spell.LastCastAt != serverGOAt {
+		t.Fatalf("Slam server GO = %s, want %s", spell.LastCastAt, serverGOAt)
+	}
+	if got := spellCastCount(mhAuto); got != mainHandCastsBeforeGO {
+		t.Fatalf("main hand fired before its preserved deadline: casts=%d, before=%d", got, mainHandCastsBeforeGO)
+	}
+	if got := character.AutoAttacks.NextMHSwingAt(); got != preservedDeadline {
+		t.Fatalf("Slam server GO moved future MH deadline: got %s, want %s", got, preservedDeadline)
+	}
+
+	if err := env.Wait(preservedDeadline - env.sim.CurrentTime); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if got := spellCastCount(mhAuto); got != mainHandCastsBeforeGO+1 {
+		t.Fatalf("main hand did not fire once at preserved deadline: casts=%d, before=%d", got, mainHandCastsBeforeGO)
+	}
+	if delta := durationDelta(env.sim.CurrentTime, preservedDeadline); delta > core.SpellBatchWindow {
+		t.Fatalf("decision resumed at %s, want preserved MH deadline %s within one batch", env.sim.CurrentTime, preservedDeadline)
+	}
+	if got := character.AutoAttacks.NextMHSwingAt(); got <= preservedDeadline {
+		t.Fatalf("main-hand timer did not advance after preserved swing: next=%s deadline=%s", got, preservedDeadline)
+	}
+	if preservedDeadline <= serverGOAt {
+		t.Fatalf("future MH deadline was not kept after Slam GO: deadline=%s GO=%s", preservedDeadline, serverGOAt)
+	}
+}
