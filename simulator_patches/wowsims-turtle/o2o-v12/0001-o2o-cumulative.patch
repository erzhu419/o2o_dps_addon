+const (
+	DynamicTeamBackgroundSchemaV1 = "o2o_dynamic_team_background/v1"
+	DynamicSameTimestampOrderV1   = "BACKGROUND_BEFORE_CANDIDATE"
+
+	DynamicDamageApplied                    = "APPLIED"
+	DynamicDamageNoDamage                   = "NO_DAMAGE"
+	DynamicDamageCanceledTargetDead         = "CANCELED_TARGET_DEAD"
+	DynamicDamageCanceledTargetUnattackable = "CANCELED_TARGET_UNATTACKABLE"
+
+	DynamicResolutionAppliedAfterOutcome      = "APPLIED_AFTER_OUTCOME"
+	DynamicResolutionNoDamageAfterOutcome     = "NO_DAMAGE_AFTER_OUTCOME"
+	DynamicResolutionDeadBeforeOutcome        = "TARGET_DEAD_BEFORE_OUTCOME"
+	DynamicResolutionDeadAfterOutcome         = "TARGET_DIED_AFTER_OUTCOME"
+	DynamicResolutionUnattackableAfterOutcome = "TARGET_UNATTACKABLE_AFTER_OUTCOME"
+)
+
+type DynamicRetargetMode string
+
+const (
+	DynamicRetargetNextAliveCyclic DynamicRetargetMode = "NEXT_ALIVE_CYCLIC"
+	DynamicRetargetRequireExplicit DynamicRetargetMode = "REQUIRE_EXPLICIT"
+)
+
+type DynamicTargetHealthV1 struct {
