+func newTestWarriorEnvironment(t *testing.T, request *proto.RaidSimRequest) *Environment {
+	t.Helper()
+	// These mechanics fixtures were originally authored against the effective
+	// RNG stream 246 (request seed 123 plus the old, accidental second 123
+	// offset). Keep that unrelated deterministic stream stable while the seed
+	// contract regression above verifies New's corrected absolute semantics.
+	env, err := New(request, 246)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(env.Cleanup)
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	return env
+}
