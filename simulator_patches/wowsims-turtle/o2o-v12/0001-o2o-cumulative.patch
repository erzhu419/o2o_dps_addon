+// Environment is a single-player interactive simulator. It deliberately does
+// not implement snapshot/restore yet; search must not claim branching support
+// until canonical reconstruction is added and tested.
+type Environment struct {
+	sim                  *core.Simulation
+	finished             bool
+	pendingServerResults []pendingServerResult
+	usedAttemptIDs       map[string]struct{}
+	dynamic              *dynamicTeamBackgroundRuntimeV1
+	dynamicV2            *dynamicTargetSemanticsRuntimeV2
+	dynamicV3            *dynamicIdleAdvanceRuntimeV3
+	activeAttemptID      string
+	activeAttemptAction  core.ActionID
+}
+
+func New(request *proto.RaidSimRequest, seed int64) (*Environment, error) {
+	return newEnvironment(request, seed, nil, 0)
+}
+
+func newEnvironment(
+	request *proto.RaidSimRequest,
+	seed int64,
+	dynamicConfig *DynamicTeamBackgroundConfigV1,
+	generation uint64,
+) (*Environment, error) {
+	return newEnvironmentInternal(request, seed, dynamicConfig, nil, generation)
+}
+
+func newEnvironmentDynamicV2(
+	request *proto.RaidSimRequest,
+	seed int64,
+	dynamicConfig *DynamicTeamBackgroundConfigV1,
+	dynamicV2Config *DynamicTargetSemanticsConfigV2,
+	generation uint64,
+) (*Environment, error) {
+	if dynamicConfig == nil || dynamicV2Config == nil {
+		return nil, errors.New("dynamic-v2 requires both lifecycle and target-semantics configs")
+	}
+	return newEnvironmentInternal(request, seed, dynamicConfig, dynamicV2Config, generation)
+}
+
+func newEnvironmentInternal(
+	request *proto.RaidSimRequest,
+	seed int64,
+	dynamicConfig *DynamicTeamBackgroundConfigV1,
+	dynamicV2Config *DynamicTargetSemanticsConfigV2,
+	generation uint64,
+) (*Environment, error) {
+	if request == nil || request.Raid == nil || request.Encounter == nil || request.SimOptions == nil {
+		return nil, errors.New("raid, encounter, and sim_options are required")
+	}
+	if len(request.Raid.Parties) == 0 || len(request.Raid.Parties[0].Players) == 0 {
+		return nil, errors.New("interactive environment requires a player in raid.parties[0]")
+	}
+
+	cloned := googleProto.Clone(request).(*proto.RaidSimRequest)
+	cloned.SimOptions.Interactive = true
+	cloned.SimOptions.Iterations = 1
+	if seed != 0 {
+		cloned.SimOptions.RandomSeed = seed
+	}
+	if dynamicConfig != nil {
+		cloned.Encounter.UseHealth = true
+	}
+
+	sim.RegisterAll()
+	active := core.NewSim(cloned, simsignals.Signals{})
+	env := &Environment{sim: active, usedAttemptIDs: make(map[string]struct{})}
+	if dynamicConfig != nil {
+		initialHealth := make([]float64, len(dynamicConfig.TargetHealth))
+		for index, target := range dynamicConfig.TargetHealth {
+			initialHealth[index] = target.Health
+		}
+		if err := active.Encounter.ConfigureDynamicTargetHealth(initialHealth); err != nil {
+			return nil, err
+		}
+		env.dynamic = newDynamicTeamBackgroundRuntimeV1(*dynamicConfig, generation)
+		if dynamicV2Config != nil {
+			env.dynamicV2 = newDynamicTargetSemanticsRuntimeV2(*dynamicV2Config, generation)
+			env.dynamic.bindingSchema = DynamicTargetSemanticsSchemaV2
+			env.dynamic.bindingDigest = dynamicV2Config.ContentSHA256
+			env.dynamic.sameTimestampOrder = DynamicSameTimestampOrderV2
+		}
+		active.Encounter.SetDynamicTargetKilledHandler(env.onDynamicCandidateTargetKilledV1)
+		active.Encounter.SetDynamicCandidateDamageHandler(env.onDynamicCandidateDamageV1)
+	}
+	// NewSim already initializes its RNG from the absolute RandomSeed selected
+	// above. Simulation.Reseed takes an iteration offset and adds it to that
+	// RandomSeed, so reseeding here would accidentally double every non-zero
+	// request/override seed (and would turn an unspecified seed into zero).
+	active.Reset()
+	if env.dynamicV2 != nil {
+		env.initializeDynamicTargetSemanticsV2()
+		env.scheduleDynamicTargetSemanticsV2()
+	}
+	if env.dynamic != nil {
+		env.scheduleDynamicBackgroundV1()
+	}
+	active.PrePull()
+	return env, nil
+}
+
+func (env *Environment) player() core.Agent {
+	return env.sim.Raid.Parties[0].Players[0]
+}
+
+// AdvanceUntilDecision processes events until the policy is asked for another
+// input or the encounter ends.
+func (env *Environment) AdvanceUntilDecision() (bool, error) {
+	if env.finished {
+		return true, nil
+	}
+	if env.dynamic != nil {
+		for {
+			if env.finished {
+				return true, nil
+			}
+			if env.sim.NeedsInput && !env.dynamicTargetSemanticsDueNowV2() && !env.dynamicBackgroundDueNowV1() && !env.dynamicRetargetDueNowV1() {
+				if env.beginDynamicIdleAdvanceV3() {
+					continue
+				}
+				return false, nil
+			}
+			if env.sim.Step() {
+				env.finished = true
+				env.cancelRemainingDynamicTargetSemanticsV2()
+				env.cancelRemainingDynamicBackgroundV1()
+				env.finishDynamicIdleAdvanceV3(DynamicIdleAdvanceSimulatorTerminal)
+				return true, nil
+			}
+		}
+	}
+	for !env.sim.NeedsInput {
+		if env.sim.Step() {
+			env.finished = true
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func (env *Environment) AvailableActions() []AvailableAction {
+	character := env.player().GetCharacter()
+	target := character.CurrentTarget
+	targetAlive := target != nil && (env.dynamic == nil || env.sim.Encounter.DynamicTargetUnitIsAttackable(target))
+	actions := make([]AvailableAction, 0, len(character.Spellbook))
+	for index, spell := range character.Spellbook {
+		// The spellbook also contains implementation-only spells such as the
+		// tag-0 Heroic Strike / Cleave swing replacements. Those are cast by the
+		// auto-attack engine after their tag-1 queue action; exposing them here
+		// would let an interactive policy bypass the next-swing contract.
+		if !spell.Flags.Matches(core.SpellFlagAPL) {
+			continue
+		}
+		ready := spell.TimeToReady(env.sim)
+		actions = append(actions, AvailableAction{
+			Index:       index,
+			Action:      actionRef(spell.ActionID),
+			Label:       spell.ActionID.String(),
+			Legal:       !env.finished && env.sim.NeedsInput && targetAlive && spell.CanCast(env.sim, target),
+			ReadyInMS:   nonNegativeMS(ready),
+			TriggersGCD: spell.DefaultCast.GCD > 0,
+		})
+	}
+	return actions
+}
+
+// Apply casts one exact spellbook action. Queue actions keep NeedsInput true so
+// a policy can submit queue -> GCD in the same decision.
+func (env *Environment) Apply(ref ActionRef) (ApplyResult, error) {
+	return env.apply(ref, "", false)
+}
+
+// ApplyWithAttemptID is the strict bridge entry point. Result-bearing Fury GCD
+// actions require an encounter-unique attempt ID before submission, so a later
+// metric event can remain bound to the original action across decision steps.
+func (env *Environment) ApplyWithAttemptID(ref ActionRef, attemptID string) (ApplyResult, error) {
+	return env.apply(ref, attemptID, true)
+}
+
+func (env *Environment) apply(ref ActionRef, attemptID string, trackResults bool) (ApplyResult, error) {
+	if env.finished {
+		return ApplyResult{Finished: true}, errors.New("encounter is already finished")
+	}
+	if !env.sim.NeedsInput {
+		return ApplyResult{}, errors.New("simulator is not waiting for an action")
+	}
+	character := env.player().GetCharacter()
+	if env.dynamic != nil && (character.CurrentTarget == nil || !env.sim.Encounter.DynamicTargetUnitIsAttackable(character.CurrentTarget)) {
+		if character.CurrentTarget != nil && !env.sim.Encounter.DynamicTargetUnitIsDead(character.CurrentTarget) {
+			return ApplyResult{NeedsInput: env.sim.NeedsInput}, errors.New("current target is unattackable; select an attackable target")
+		}
+		return ApplyResult{NeedsInput: env.sim.NeedsInput}, errors.New("current target is dead; select a living target")
+	}
+	spell := character.GetSpell(ref.coreID())
+	if spell == nil {
+		return ApplyResult{}, fmt.Errorf("action not found: %s", ref.coreID().String())
+	}
+	if !spell.Flags.Matches(core.SpellFlagAPL) {
+		return ApplyResult{}, fmt.Errorf("action is not externally triggerable: %s", ref.coreID().String())
+	}
+	_, resultBearing := resultBearingFuryGCDSpellIDs[spell.ActionID.SpellID]
+	resultBearing = resultBearing && spell.ActionID.Tag == 0
+	if trackResults {
+		switch {
+		case resultBearing && attemptID == "":
+			return ApplyResult{}, fmt.Errorf("result-bearing action %s requires attempt_id", ref.coreID().String())
+		case !resultBearing && attemptID != "":
+			return ApplyResult{}, fmt.Errorf("non-result-bearing action %s must not carry attempt_id", ref.coreID().String())
+		case resultBearing:
+			if _, duplicate := env.usedAttemptIDs[attemptID]; duplicate {
+				return ApplyResult{}, fmt.Errorf("attempt_id %q was already used in this encounter", attemptID)
+			}
+		}
+	}
+	if !spell.CanCast(env.sim, character.CurrentTarget) {
+		return ApplyResult{NeedsInput: env.sim.NeedsInput}, nil
+	}
+	var before []core.SpellMetrics
+	if trackResults && resultBearing {
+		before = cloneSpellMetrics(spell.SpellMetrics)
+	}
+	if trackResults && resultBearing {
+		env.activeAttemptID = attemptID
+		env.activeAttemptAction = spell.ActionID
+	}
+	casted := spell.Cast(env.sim, character.CurrentTarget)
+	env.activeAttemptID = ""
+	env.activeAttemptAction = core.ActionID{}
+	if casted && before != nil {
+		env.usedAttemptIDs[attemptID] = struct{}{}
+		resultTimeMS := env.sim.CurrentTime.Milliseconds()
+		if character.IsCasting(env.sim) && character.Hardcast.ActionID == spell.ActionID {
+			resultTimeMS = character.Hardcast.Expires.Milliseconds()
+		}
+		env.pendingServerResults = append(env.pendingServerResults, pendingServerResult{
+			action:       actionRef(spell.ActionID),
+			attemptID:    attemptID,
+			metrics:      before,
+			resultTimeMS: resultTimeMS,
+		})
+	}
+	consumesDecision := casted && spell.CurCast.GCD > 0
+	if consumesDecision {
+		env.sim.NeedsInput = false
+	}
+	return ApplyResult{
+		Casted:           casted,
+		ConsumesDecision: consumesDecision,
+		Finished:         env.finished,
+		NeedsInput:       env.sim.NeedsInput,
+	}, nil
+}
+
+// StartAttack is an idempotent client control.  A successful acknowledgement
+// never consumes the open decision and is not a combat-result event.
+func (env *Environment) StartAttack() (ControlResult, error) {
+	if env.finished {
+		return ControlResult{}, errors.New("encounter is already finished")
+	}
+	if !env.sim.NeedsInput {
+		return ControlResult{}, errors.New("simulator is not waiting for an action")
+	}
+	character := env.player().GetCharacter()
+	if env.dynamic != nil && (character.CurrentTarget == nil || !env.sim.Encounter.DynamicTargetUnitIsAttackable(character.CurrentTarget)) {
+		if character.CurrentTarget != nil && !env.sim.Encounter.DynamicTargetUnitIsDead(character.CurrentTarget) {
+			return ControlResult{}, errors.New("current target is unattackable; select an attackable target")
+		}
+		return ControlResult{}, errors.New("current target is dead; select a living target")
+	}
+	character.AutoAttacks.EnableAutoSwing(env.sim)
+	return ControlResult{Accepted: true, ConsumesDecision: false}, nil
+}
+
+// StopCast interrupts only an active hardcast.  The GCD and current decision
+// remain untouched.  No server-result event is fabricated for the control.
+func (env *Environment) StopCast() (ControlResult, error) {
+	if env.finished {
+		return ControlResult{}, errors.New("encounter is already finished")
+	}
+	if !env.sim.NeedsInput {
+		return ControlResult{}, errors.New("simulator is not waiting for an action")
+	}
+	character := env.player().GetCharacter()
+	action := character.Hardcast.ActionID
+	accepted := character.CancelHardcast(env.sim)
+	if accepted {
+		for index := len(env.pendingServerResults) - 1; index >= 0; index-- {
+			pending := &env.pendingServerResults[index]
+			if pending.action.coreID() == action && !pending.canceled {
+				pending.canceled = true
+				pending.canceledAtMS = env.sim.CurrentTime.Milliseconds()
+				break
+			}
+		}
+	}
+	return ControlResult{Accepted: accepted, ConsumesDecision: false}, nil
+}
+
+// ServerResultsSinceLastDecision validates the caller's complete outstanding
+// ledger in acceptance order. Resolved attempts emit one aggregate event with
+// deterministic per-target evidence and are removed after a fully successful
+// query. Unresolved hardcasts emit no event and remain pending across decision
+// steps; canceled hardcasts emit CANCELED with zero damage and no target rows.
+func (env *Environment) ServerResultsSinceLastDecision(attemptIDs []string) (ServerResultsResult, error) {
+	result := ServerResultsResult{
+		CompleteThroughTimeMS: env.sim.CurrentTime.Milliseconds(),
+		Events:                make([]ServerResultEvent, 0, len(attemptIDs)),
+		PendingAttemptIDs:     make([]string, 0, len(attemptIDs)),
+	}
+	if env.dynamic != nil {
+		generation := env.dynamic.generation
+		result.EnvironmentGeneration = &generation
+	}
+	if len(attemptIDs) != len(env.pendingServerResults) {
+		return result, fmt.Errorf(
+			"attempt_ids count %d does not match pending result-bearing actions %d",
+			len(attemptIDs), len(env.pendingServerResults),
+		)
+	}
+	seen := make(map[string]struct{}, len(attemptIDs))
+	for _, attemptID := range attemptIDs {
+		if attemptID == "" {
+			return result, errors.New("attempt_ids must be non-empty")
+		}
+		if _, duplicate := seen[attemptID]; duplicate {
+			return result, fmt.Errorf("duplicate attempt_id %q", attemptID)
+		}
+		seen[attemptID] = struct{}{}
+	}
+	for index, attemptID := range attemptIDs {
+		if attemptID != env.pendingServerResults[index].attemptID {
+			if _, known := env.usedAttemptIDs[attemptID]; !known {
+				return result, fmt.Errorf("unknown attempt_id %q", attemptID)
+			}
+			return result, fmt.Errorf(
+				"outstanding attempt_id order mismatch at index %d: got %q, want %q",
+				index, attemptID, env.pendingServerResults[index].attemptID,
+			)
+		}
+	}
+
+	character := env.player().GetCharacter()
+	remaining := make([]pendingServerResult, 0, len(env.pendingServerResults))
+	for index, pending := range env.pendingServerResults {
+		if pending.canceled {
+			result.Events = append(result.Events, ServerResultEvent{
+				TimeMS:        pending.canceledAtMS,
+				Outcome:       "CANCELED",
+				AttemptID:     pending.attemptID,
+				Damage:        0,
+				Action:        pending.action,
+				TargetResults: make([]ServerTargetResult, 0),
+			})
+			continue
+		}
+		if character.IsCasting(env.sim) && character.Hardcast.ActionID == pending.action.coreID() {
+			pending.resultTimeMS = character.Hardcast.Expires.Milliseconds()
+			remaining = append(remaining, pending)
+			result.PendingAttemptIDs = append(result.PendingAttemptIDs, pending.attemptID)
+			continue
+		}
+		if pending.resultTimeMS > result.CompleteThroughTimeMS {
+			remaining = append(remaining, pending)
+			result.PendingAttemptIDs = append(result.PendingAttemptIDs, pending.attemptID)
+			continue
+		}
+		spell := character.GetSpell(pending.action.coreID())
+		if spell == nil {
+			return result, fmt.Errorf("tracked action disappeared from spellbook: %s", pending.action.coreID().String())
+		}
+		outcome, damage, targetResults, err := deriveServerResult(
+			pending.metrics,
+			spell.SpellMetrics,
+			len(env.sim.Encounter.TargetUnits),
+		)
+		if err != nil {
+			if errors.Is(err, errServerResultPending) {
+				remaining = append(remaining, pending)
+				result.PendingAttemptIDs = append(result.PendingAttemptIDs, pending.attemptID)
+				continue
+			}
+			return result, fmt.Errorf("derive result for %s: %w", pending.action.coreID().String(), err)
+		}
+		result.Events = append(result.Events, ServerResultEvent{
+			TimeMS:        pending.resultTimeMS,
+			Outcome:       outcome,
+			AttemptID:     attemptIDs[index],
+			Damage:        damage,
+			Action:        pending.action,
+			TargetResults: targetResults,
+		})
+	}
+	env.pendingServerResults = remaining
+	return result, nil
+}
+
+// CancelQueuedMelee is a control operation, not a spell action. It only clears
+// an already-accepted Heroic Strike/Cleave queue and deliberately leaves the
+// current decision open.
+func (env *Environment) CancelQueuedMelee() (CancelQueuedMeleeResult, error) {
+	if env.finished {
+		return CancelQueuedMeleeResult{Finished: true}, errors.New("encounter is already finished")
+	}
+	if !env.sim.NeedsInput {
+		return CancelQueuedMeleeResult{}, errors.New("simulator is not waiting for an action")
+	}
+
+	canceled := false
+	if canceler, ok := env.player().(queuedMeleeCanceler); ok {
+		canceled = canceler.CancelQueuedHSOrCleave(env.sim)
+	}
+	return CancelQueuedMeleeResult{
+		Canceled:         canceled,
+		ConsumesDecision: false,
+		Finished:         false,
+		NeedsInput:       env.sim.NeedsInput,
+	}, nil
+}
+
+// SetTarget changes only the interactive player's current target. It neither
+// consumes the decision nor resets either weapon swing timer, matching an
+// in-game target change while auto attack remains active.
+func (env *Environment) SetTarget(index int32) (SetTargetResult, error) {
+	if env.finished {
+		return SetTargetResult{Finished: true}, errors.New("encounter is already finished")
+	}
+	if !env.sim.NeedsInput {
+		return SetTargetResult{}, errors.New("simulator is not waiting for an action")
+	}
+	if index < 0 || index >= int32(len(env.sim.Encounter.TargetUnits)) {
+		return SetTargetResult{}, fmt.Errorf("target index out of range: %d", index)
+	}
+	if env.dynamic != nil && env.sim.Encounter.DynamicTargetIsDead(index) {
+		return SetTargetResult{}, fmt.Errorf("target is dead: %d", index)
+	}
+	if env.dynamic != nil && !env.sim.Encounter.DynamicTargetIsAttackable(index) {
+		return SetTargetResult{}, fmt.Errorf("target is unattackable: %d", index)
+	}
+
+	character := env.player().GetCharacter()
+	target := env.sim.Encounter.TargetUnits[index]
+	changed := character.CurrentTarget != target
+	character.CurrentTarget = target
+	character.AutoAttacks.ResumeDynamicTargetSwings(env.sim)
+	if env.dynamic != nil {
+		env.dynamic.retargetRequired = false
+	}
+	return SetTargetResult{
+		Changed:     changed,
+		TargetIndex: index,
+		Finished:    false,
+		NeedsInput:  env.sim.NeedsInput,
+	}, nil
+}
+
+// Wait advances the decision clock without casting. It is an explicit action,
+// not a busy loop, so search can compare short holds against immediate casts.
+func (env *Environment) Wait(duration time.Duration) error {
+	if env.finished {
+		return errors.New("encounter is already finished")
+	}
+	if !env.sim.NeedsInput {
+		return errors.New("simulator is not waiting for an action")
+	}
+	if duration <= 0 {
+		return errors.New("wait duration must be positive")
+	}
+	character := env.player().GetCharacter()
+	character.WaitUntil(env.sim, env.sim.CurrentTime+duration)
+	env.sim.NeedsInput = false
+	return nil
+}
+
+func (env *Environment) State() State {
+	character := env.player().GetCharacter()
+	target := character.CurrentTarget
+	state := State{
+		TimeMS:                 env.sim.CurrentTime.Milliseconds(),
+		RemainingMS:            nonNegativeMS(env.sim.GetRemainingDuration()),
+		Finished:               env.finished,
+		NeedsInput:             env.sim.NeedsInput,
+		HealthCurrent:          character.CurrentHealth(),
+		HealthMaximum:          character.MaxHealth(),
+		Moving:                 character.IsMoving(),
+		GCDRemainingMS:         nonNegativeMS(character.GCD.TimeToReady(env.sim)),
+		MHSwingRemainingMS:     nonNegativeMS(character.AutoAttacks.NextMHSwingAt() - env.sim.CurrentTime),
+		MHSwingDurationMS:      int64(character.AutoAttacks.MH().SwingSpeed / character.SwingSpeed() * 1000),
+		EncounterDamageTaken:   env.sim.Encounter.DamageTaken,
+		EncounterHealthTarget:  env.sim.Encounter.EndFightAtHealth,
+		ExecutePhase20:         env.sim.IsTargetExecutePhase20(target),
+		ExecutePhase25:         env.sim.IsTargetExecutePhase25(target),
+		ExecutePhase35:         env.sim.IsTargetExecutePhase35(target),
+		Strength:               character.GetStat(stats.Strength),
+		MeleeAttackPower:       character.GetStat(stats.AttackPower),
+		ArmorPenetration:       character.GetStat(stats.ArmorPenetration),
+		DamageDone:             damageDone(character),
+		Auras:                  activeAuras(character.GetAuras(), env.sim),
+		NumTargets:             int(env.sim.Environment.GetNumActiveTargets()),
+		DynamicTeamBackground:  env.dynamicStateV1(),
+		DynamicTargetSemantics: env.dynamicTargetSemanticsStateV2(),
+		DynamicIdleAdvance:     env.dynamicIdleAdvanceStateV3(),
+	}
+	if env.dynamic != nil {
+		totalTargetCount := len(env.sim.Encounter.TargetUnits)
+		state.TotalTargetCount = &totalTargetCount
+	}
+	if character.IsCasting(env.sim) {
+		hardcast := character.Hardcast
+		current := character.GetSpell(hardcast.ActionID)
+		duration := int64(0)
+		if current != nil {
+			duration = nonNegativeMS(current.CurCast.CastTime)
+		}
+		state.CurrentCast = &CastState{
+			Action:      actionRef(hardcast.ActionID),
+			RemainingMS: nonNegativeMS(hardcast.Expires - env.sim.CurrentTime),
+			DurationMS:  duration,
+		}
+	}
+	if character.AutoAttacks.IsDualWielding {
+		oh := nonNegativeMS(character.AutoAttacks.NextOHSwingAt() - env.sim.CurrentTime)
+		state.OHSwingRemainingMS = &oh
+	}
+	if target != nil {
+		state.TargetIndex = target.Index
+		state.TargetArmor = target.Armor()
+		state.EffectiveTargetArmor = max(state.TargetArmor-state.ArmorPenetration, 0)
+		if target.HasHealthBar() {
+			state.TargetHealth = target.CurrentHealth()
+			state.TargetHealthMax = target.MaxHealth()
+			state.TargetHealthKnown = true
+			if state.TargetHealthMax > 0 {
+				state.TargetHealthPct = state.TargetHealth / state.TargetHealthMax * 100
+			}
+		}
+		state.TargetAuras = activeAuras(target.GetAuras(), env.sim)
+	}
+	switch {
+	case character.HasRageBar():
+		state.Power = PowerState{Type: "rage", Current: character.CurrentRage(), Maximum: 100}
+	case character.HasEnergyBar():
+		state.Power = PowerState{Type: "energy", Current: character.CurrentEnergy(), Maximum: character.MaxEnergy()}
+	case character.HasManaBar():
+		state.Power = PowerState{Type: "mana", Current: character.CurrentMana(), Maximum: character.MaxMana()}
+	default:
+		state.Power = PowerState{Type: "none"}
+	}
+	return state
+}
+
+func (env *Environment) Cleanup() {
+	if env.sim != nil {
+		env.sim.Cleanup()
+	}
+}
+
+func activeAuras(all []*core.Aura, activeSim *core.Simulation) []AuraState {
+	result := make([]AuraState, 0)
+	for _, aura := range all {
+		if aura == nil || !aura.IsActive() {
+			continue
+		}
+		remaining := aura.RemainingDuration(activeSim)
+		remainingMS := int64(-1)
+		if remaining != core.NeverExpires {
+			remainingMS = nonNegativeMS(remaining)
+		}
+		result = append(result, AuraState{
+			Label:       aura.Label,
+			Action:      actionRef(aura.ActionID),
+			Stacks:      aura.GetStacks(),
+			RemainingMS: remainingMS,
+		})
+	}
+	return result
+}
+
+func damageDone(character *core.Character) float64 {
+	total := 0.0
+	for _, spell := range character.Spellbook {
+		for _, metrics := range spell.SpellMetrics {
+			total += metrics.TotalDamage
+		}
+	}
+	return total
+}
+
+func cloneSpellMetrics(metrics []core.SpellMetrics) []core.SpellMetrics {
+	return append([]core.SpellMetrics(nil), metrics...)
+}
+
+var errServerResultPending = errors.New("server result is still pending")
+
+func deriveServerResult(before, after []core.SpellMetrics, targetCount int) (string, float64, []ServerTargetResult, error) {
+	if len(before) != len(after) {
+		return "", 0, nil, fmt.Errorf("spell metric target count changed from %d to %d", len(before), len(after))
+	}
+	if targetCount < 0 || targetCount > len(after) {
+		return "", 0, nil, fmt.Errorf("invalid encounter target count %d for %d spell metric slots", targetCount, len(after))
+	}
+	type outcomeTotal struct {
+		name  string
+		count int64
+	}
+	outcomes := []outcomeTotal{
+		{name: "MISS"},
+		{name: "HIT"},
+		{name: "CRIT"},
+		{name: "DODGE"},
+		{name: "PARRY"},
+		{name: "BLOCK"},
+		{name: "BLOCK_CRIT"},
+		{name: "GLANCE"},
+		{name: "CRUSH"},
+	}
+	var casts int64
+	targetResults := make([]ServerTargetResult, 0, targetCount)
+	for index := range before {
+		left, right := before[index], after[index]
+		metricDeltas := []int32{
+			right.Misses - left.Misses,
+			right.Hits - left.Hits,
+			right.Crits - left.Crits,
+			right.Dodges - left.Dodges,
+			right.Parries - left.Parries,
+			right.Blocks - left.Blocks,
+			right.BlockedCrits - left.BlockedCrits,
+			right.Glances - left.Glances,
+			right.Crushes - left.Crushes,
+		}
+		targetObservedKinds := 0
+		targetOutcome := ""
+		for outcomeIndex, delta := range metricDeltas {
+			if delta < 0 {
+				return "", 0, nil, fmt.Errorf("%s metric decreased on target index %d", outcomes[outcomeIndex].name, index)
+			}
+			outcomes[outcomeIndex].count += int64(delta)
+			if delta > 0 {
+				targetObservedKinds++
+				targetOutcome = outcomes[outcomeIndex].name
+			}
+		}
+		castDelta := right.Casts - left.Casts
+		if castDelta < 0 {
+			return "", 0, nil, fmt.Errorf("cast metric decreased on target index %d", index)
+		}
+		casts += int64(castDelta)
+		targetDamage := right.TotalDamage - left.TotalDamage
+		if math.IsNaN(targetDamage) || math.IsInf(targetDamage, 0) || targetDamage < -1e-9 {
+			return "", 0, nil, fmt.Errorf("invalid damage delta %v on target index %d", targetDamage, index)
+		}
+		if targetDamage < 0 {
+			targetDamage = 0
+		}
+		if index >= targetCount && (castDelta > 0 || targetObservedKinds > 0 || targetDamage != 0) {
+			return "", 0, nil, fmt.Errorf("result metric advanced outside encounter targets at unit index %d", index)
+		}
+		if targetObservedKinds == 0 {
+			if targetDamage != 0 {
+				return "", 0, nil, fmt.Errorf("damage metric advanced without an outcome on target index %d", index)
+			}
+			continue
+		}
+		if targetObservedKinds > 1 {
+			targetOutcome = "MIXED"
+		}
+		targetResults = append(targetResults, ServerTargetResult{
+			TargetIndex: int32(index),
+			Outcome:     targetOutcome,
+			Damage:      targetDamage,
+		})
+	}
+	if casts == 0 {
+		for _, outcome := range outcomes {
+			if outcome.count != 0 {
+				return "", 0, nil, errors.New("outcome metric advanced without a completed cast")
+			}
+		}
+		if len(targetResults) != 0 {
+			return "", 0, nil, errors.New("damage metric advanced without a completed cast")
+		}
+		return "", 0, nil, errServerResultPending
+	}
+	if casts != 1 {
+		return "", 0, nil, fmt.Errorf("expected exactly one completed cast metric, observed %d", casts)
+	}
+	if len(targetResults) == 0 {
+		return "", 0, nil, errors.New("completed cast has no outcome metric")
+	}
+	damage := 0.0
+	for _, targetResult := range targetResults {
+		damage += targetResult.Damage
+	}
+	observedKinds := 0
+	selected := ""
+	for _, outcome := range outcomes {
+		if outcome.count > 0 {
+			observedKinds++
+			selected = outcome.name
+		}
+	}
+	if observedKinds == 0 {
+		return "", 0, nil, errors.New("completed cast has no outcome metric")
+	}
+	if observedKinds > 1 {
+		selected = "MIXED"
+	}
+	return selected, damage, targetResults, nil
+}
+
+func nonNegativeMS(duration time.Duration) int64 {
+	if duration <= 0 {
+		return 0
+	}
+	return duration.Milliseconds()
+}
