+func TestLevelSixtyWhiteHitRageUsesDamageConversion(t *testing.T) {
+	request := turtleSlamRequest()
+	player := request.Raid.Parties[0].Players[0]
+	player.TalentsString = ""
+	player.GetWarrior().Options.StartingRage = 0
+	env, err := New(request, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(env.Cleanup)
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	character := env.player().GetCharacter()
+	mhAuto := character.AutoAttacks.MHAuto()
+	if mhAuto == nil {
+		t.Fatal("main-hand auto attack was not registered")
+	}
+	target := character.CurrentTarget
+	attackTable := character.AttackTables[target.UnitIndex][mhAuto.CastType]
+	attackTable.BaseMissChance = 0
+	attackTable.BaseDodgeChance = 0
+	attackTable.BaseParryChance = 0
+	character.PseudoStats.InFrontOfTarget = false
+
+	metrics := &mhAuto.SpellMetrics[target.UnitIndex]
+	for attempt := 1; attempt <= 10; attempt++ {
+		deadline := character.AutoAttacks.NextMHSwingAt()
+		if err := env.Wait(deadline - env.sim.CurrentTime - time.Millisecond); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := env.AdvanceUntilDecision(); err != nil {
+			t.Fatal(err)
+		}
+		damageBefore := metrics.TotalDamage
+		castsBefore := spellCastCount(mhAuto)
+		rageBefore := env.State().Power.Current
+		// Cross, rather than land exactly on, the delayed auto-attack batch.
+		// A wait decision at the same timestamp has higher priority than the
+		// delayed damage action.
+		if err := env.Wait(2*time.Millisecond + core.SpellBatchWindow); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := env.AdvanceUntilDecision(); err != nil {
+			t.Fatal(err)
+		}
+		if got := spellCastCount(mhAuto); got != castsBefore+1 {
+			t.Fatalf("expected one white swing: casts=%d before=%d", got, castsBefore)
+		}
+		damage := metrics.TotalDamage - damageBefore
+		if damage <= 0 {
+			continue
+		}
+		want := damage * 7.5 / core.GetRageConversion(character.Level)
+		if got := env.State().Power.Current - rageBefore; math.Abs(got-want) > 1e-9 {
+			t.Fatalf("white-hit rage = %.9f, want %.9f from damage %.3f", got, want, damage)
+		}
+		return
+	}
+	t.Fatalf("no damaging white hit observed after 10 swings: metrics=%+v", metrics)
+}
