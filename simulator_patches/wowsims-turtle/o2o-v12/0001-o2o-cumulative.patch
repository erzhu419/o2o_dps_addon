+func boundDynamicV2Config(
+	t *testing.T,
+	mode DynamicRetargetMode,
+	health []float64,
+	background []BackgroundDamageEventV1,
+	attackability []DynamicAttackabilityEventV2,
+	armor []DynamicEffectiveArmorEventV2,
+) DynamicTargetSemanticsConfigV2 {
+	t.Helper()
+	if background == nil {
+		background = make([]BackgroundDamageEventV1, 0)
+	}
+	if attackability == nil {
+		attackability = make([]DynamicAttackabilityEventV2, 0)
+	}
+	if armor == nil {
+		armor = make([]DynamicEffectiveArmorEventV2, 0)
+	}
+	targets := make([]DynamicTargetHealthV1, len(health))
+	for index, value := range health {
+		targets[index] = DynamicTargetHealthV1{TargetIndex: int32(index), Health: value}
+	}
+	config := DynamicTargetSemanticsConfigV2{
+		Schema:                 DynamicTargetSemanticsSchemaV2,
+		TargetHealth:           targets,
+		BackgroundDamageEvents: background,
+		AttackabilityEvents:    attackability,
+		EffectiveArmorEvents:   armor,
+		SameTimestampOrder:     DynamicSameTimestampOrderV2,
+		RetargetMode:           mode,
+	}
+	digest, err := DynamicTargetSemanticsDigestV2(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.ContentSHA256 = digest
+	return config
+}
