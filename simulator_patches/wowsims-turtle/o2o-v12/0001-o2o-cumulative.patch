+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(batch.Events) != 1 {
+		t.Fatalf("missing Whirlwind result: %+v", batch)
+	}
+	counts := map[int32]int{}
+	for _, target := range batch.Events[0].TargetResults {
+		if target.Damage > 0 {
+			counts[target.TargetIndex]++
+		}
+	}
+	if counts[0] != 1 || counts[2] != 1 || counts[3] != 1 || counts[4] != 1 || counts[1] != 0 {
+		t.Fatalf("Whirlwind redirected or repeated a target: %+v", batch.Events[0].TargetResults)
+	}
+	deadBefore := beforeMetrics[env.sim.Encounter.TargetUnits[1].UnitIndex]
+	deadAfter := spell.SpellMetrics[env.sim.Encounter.TargetUnits[1].UnitIndex]
+	if deadAfter.Hits != deadBefore.Hits || deadAfter.Crits != deadBefore.Crits ||
+		deadAfter.Misses != deadBefore.Misses || deadAfter.TotalDamage != deadBefore.TotalDamage {
+		t.Fatalf("dead Whirlwind secondary polluted outcome metrics: before=%+v after=%+v", deadBefore, deadAfter)
+	}
+	candidate, err := env.DynamicCandidateDamageReceiptsV1(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(candidate.Receipts) != 4 {
+		t.Fatalf("Whirlwind candidate ledger has %d rows, want 4 live selections: %+v", len(candidate.Receipts), candidate)
+	}
+	wantTargets := []int32{0, 2, 3, 4}
+	for index, receipt := range candidate.Receipts {
+		if receipt.TargetIndex != wantTargets[index] || receipt.AttemptID != "ww-dead-secondary" ||
+			receipt.ResolutionPhase != DynamicResolutionAppliedAfterOutcome ||
+			!receipt.OutcomeComputed || receipt.RandomStreamRewound {
+			t.Fatalf("Whirlwind ledger lost live selection/commit order: %+v", candidate.Receipts)
+		}
+	}
+}
