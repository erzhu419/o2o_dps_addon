+	player := request.Raid.Parties[0].Players[0]
+	player.TalentsString = "0000000000001"
+	player.GetWarrior().Options.Stance = proto.WarriorStance_WarriorStanceBattle
+	config := boundDynamicConfig(t, DynamicRetargetNextAliveCyclic, health, []BackgroundDamageEventV1{
+		{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 1, EventID: "dead-sweep-next", Damage: 1},
+	})
+	env := newDynamicTestEnvironment(t, request, config)
+	character := env.player().GetCharacter()
+	character.AutoAttacks.CancelAutoSwing(env.sim)
+	sweeping := character.GetSpell(core.ActionID{SpellID: 12292})
+	if sweeping == nil {
+		t.Fatal("Sweeping Strikes was not registered by the fixture talent")
+	}
+	sweeping.ApplyEffects(env.sim, character.CurrentTarget, sweeping)
+	mh := character.AutoAttacks.MHAuto()
+	forceHitOnEveryTarget(t, env, mh)
+	mh.ApplyEffects(env.sim, character.CurrentTarget, mh)
+	if err := env.Wait(core.SpellBatchWindow + time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	state := env.State().DynamicTeamBackground
+	if state == nil || state.Targets[0].SimulatedDamageApplied <= 0 || state.Targets[2].SimulatedDamageApplied <= 0 || state.Targets[1].SimulatedDamageApplied != 0 {
+		t.Fatalf("Sweeping Strikes did not skip the dead next target: %+v", state)
+	}
+}
