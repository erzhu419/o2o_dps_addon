+	current := target.CurrentHealth()
+	if current <= 0 {
+		result.AlreadyDead = true
+		result.OverkillDamage = requested
+		return result, nil
+	}
+	if !encounter.dynamicTargetAttackable[index] {
+		result.Unattackable = true
+		result.OverkillDamage = requested
+		return result, nil
+	}
