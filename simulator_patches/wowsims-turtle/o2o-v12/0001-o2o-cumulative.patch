+		t.Fatalf("sparse same-outcome targets were not stable: outcome=%s damage=%f targets=%+v", outcome, damage, targetResults)
+	}
+
+	if _, _, _, err := deriveServerResult(before, after, 2); err == nil {
+		t.Fatal("a raid-unit metric slot was mislabeled as an encounter target")
+	}
