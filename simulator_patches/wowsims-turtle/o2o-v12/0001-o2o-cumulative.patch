@@ -0,0 +1,13 @@
+package core
+
+import (
+	"math"
+	"testing"
+)
+
+func TestLevelSixtyRageConversionUsesLevelSquared(t *testing.T) {
+	want := 0.0091107836*60*60 + 3.225598133*60 + 4.2652911
+	if got := GetRageConversion(60); math.Abs(got-want) > 1e-9 {
+		t.Fatalf("level-60 rage conversion = %.9f, want %.9f", got, want)
+	}
+}
