+func newSeedReferenceSimulation(t *testing.T, request *proto.RaidSimRequest, seed int64) *core.Simulation {
+	t.Helper()
+	cloned := googleProto.Clone(request).(*proto.RaidSimRequest)
+	cloned.SimOptions.Interactive = true
+	cloned.SimOptions.Iterations = 1
+	cloned.SimOptions.RandomSeed = seed
+
+	reference := core.NewSim(cloned, simsignals.Signals{})
+	reference.Reset()
+	reference.PrePull()
+	return reference
+}
