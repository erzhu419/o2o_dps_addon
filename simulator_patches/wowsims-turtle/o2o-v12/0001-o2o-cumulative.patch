+	tests := []struct {
+		name   string
+		mutate func(*DynamicTargetSemanticsConfigV2)
+		match  string
+	}{
+		{name: "schema", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.Schema = "v3" }, match: "dynamic schema"},
+		{name: "order", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.SameTimestampOrder = DynamicSameTimestampOrderV1 }, match: "same_timestamp_order"},
+		{name: "missing background field", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.BackgroundDamageEvents = nil }, match: "background_damage_events must be present"},
+		{name: "missing attack field", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.AttackabilityEvents = nil }, match: "attackability_events must be present"},
+		{name: "missing armor field", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.EffectiveArmorEvents = nil }, match: "effective_armor_events must be present"},
+		{name: "attack cursor", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.AttackabilityEvents[1].ScheduleIndex = 3 }, match: "attackability_events schedule_index"},
+		{name: "attack duplicate", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.AttackabilityEvents[1].TimeMS = 10 }, match: "duplicate attackability"},
+		{name: "attack target", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.AttackabilityEvents[0].TargetIndex = 7 }, match: "attackability_events[0].target_index"},
+		{name: "armor cursor", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.EffectiveArmorEvents[1].ScheduleIndex = 3 }, match: "effective_armor_events schedule_index"},
+		{name: "armor duplicate", mutate: func(c *DynamicTargetSemanticsConfigV2) {
+			c.EffectiveArmorEvents[1] = DynamicEffectiveArmorEventV2{ScheduleIndex: 1, TimeMS: 10, TargetIndex: 0, EffectiveArmor: 1}
+		}, match: "duplicate effective armor"},
+		{name: "armor nonfinite", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.EffectiveArmorEvents[0].EffectiveArmor = math.Inf(1) }, match: "finite and non-negative"},
+		{name: "hash", mutate: func(c *DynamicTargetSemanticsConfigV2) { c.ContentSHA256 = strings.Repeat("0", 64) }, match: "content_sha256 mismatch"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			config := base
+			config.TargetHealth = append([]DynamicTargetHealthV1(nil), base.TargetHealth...)
+			config.AttackabilityEvents = append([]DynamicAttackabilityEventV2(nil), base.AttackabilityEvents...)
+			config.EffectiveArmorEvents = append([]DynamicEffectiveArmorEventV2(nil), base.EffectiveArmorEvents...)
+			tc.mutate(&config)
+			if tc.name != "hash" {
+				if digest, err := DynamicTargetSemanticsDigestV2(config); err == nil {
+					config.ContentSHA256 = digest
+				}
+			}
+			_, _, err := NewDynamicV2(dynamicRequest(health...), 1, config, 1)
+			if err == nil || !strings.Contains(err.Error(), tc.match) {
+				t.Fatalf("error = %v, want substring %q", err, tc.match)
+			}
+		})
+	}
+}
