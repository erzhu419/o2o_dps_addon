+func TestSlamCanRemainPendingAcrossGCDThenCancelToOriginalAttempt(t *testing.T) {
+	env := newTestWarriorEnvironment(t, turtleSlamRequest())
+	_, action := requireSpellAction(t, env, 0, turtleSlamSpellID)
+	character := env.player().GetCharacter()
+
+	accepted, err := env.ApplyWithAttemptID(action, "cross-step-slam")
+	if err != nil || !accepted.Casted {
+		t.Fatalf("Slam was not accepted: result=%+v error=%v", accepted, err)
+	}
+	// Build the Turtle timing case explicitly: the next GCD input boundary
+	// arrives while Slam's longer hardcast is still active.
+	character.SetGCDTimer(env.sim, env.sim.CurrentTime+500*time.Millisecond)
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if env.State().CurrentCast == nil {
+		t.Fatal("Slam completed before the synthetic shorter GCD boundary")
+	}
+	first, err := env.ServerResultsSinceLastDecision([]string{"cross-step-slam"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(first.Events) != 0 || len(first.PendingAttemptIDs) != 1 || first.PendingAttemptIDs[0] != "cross-step-slam" {
+		t.Fatalf("active Slam was not retained across the decision boundary: %+v", first)
+	}
+
+	stoppedAt := env.State().TimeMS
+	control, err := env.StopCast()
+	if err != nil || !control.Accepted || control.ConsumesDecision {
+		t.Fatalf("stop_cast did not cancel pending Slam: result=%+v error=%v", control, err)
+	}
+	canceled, err := env.ServerResultsSinceLastDecision([]string{"cross-step-slam"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(canceled.Events) != 1 || len(canceled.PendingAttemptIDs) != 0 {
+		t.Fatalf("unexpected canceled result batch: %+v", canceled)
+	}
+	event := canceled.Events[0]
+	if event.AttemptID != "cross-step-slam" || event.Outcome != "CANCELED" || event.Damage != 0 || event.Action != action || event.TimeMS != stoppedAt {
+		t.Fatalf("canceled Slam lost its original attempt binding: %+v", event)
+	}
+	if event.TargetResults == nil || len(event.TargetResults) != 0 {
+		t.Fatalf("canceled Slam must expose an empty target result array: %+v", event)
+	}
+	wire, err := json.Marshal(event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(wire, []byte(`"target_results":[]`)) {
+		t.Fatalf("canceled target_results did not encode as an empty array: %s", wire)
+	}
+}
