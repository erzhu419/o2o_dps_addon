+func TestNewUsesRequestAndOverrideSeedsAsAbsoluteValues(t *testing.T) {
+	tests := []struct {
+		name         string
+		requestSeed  int64
+		overrideSeed int64
+		wantSeed     int64
+	}{
+		{
+			name:        "request seed",
+			requestSeed: 123,
+			wantSeed:    123,
+		},
+		{
+			name:         "override seed",
+			requestSeed:  123,
+			overrideSeed: 456,
+			wantSeed:     456,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			request := testWarriorRequest()
+			request.SimOptions.RandomSeed = tc.requestSeed
+			env, err := New(request, tc.overrideSeed)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer env.Cleanup()
+
+			wantSim := newSeedReferenceSimulation(t, request, tc.wantSeed)
+			defer wantSim.Cleanup()
+			doubledSim := newSeedReferenceSimulation(t, request, 2*tc.wantSeed)
+			defer doubledSim.Cleanup()
+
+			const probeLabel = "o2o absolute seed regression probe"
+			got := env.sim.RandomFloat(probeLabel)
+			want := wantSim.RandomFloat(probeLabel)
+			doubled := doubledSim.RandomFloat(probeLabel)
+			if got != want {
+				t.Fatalf("effective RNG seed is not the absolute request/override seed: got draw %.17g, want %.17g", got, want)
+			}
+			if got == doubled {
+				t.Fatalf("effective RNG seed still behaves like the doubled seed %d", 2*tc.wantSeed)
+			}
+		})
+	}
+}
