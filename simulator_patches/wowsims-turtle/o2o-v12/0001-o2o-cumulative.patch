+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	rootSim "github.com/isfir/wowsims-turtle/sim"
+	"github.com/isfir/wowsims-turtle/sim/core"
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+	"google.golang.org/protobuf/encoding/protojson"
+)
+
+func main() {
+	outPath := flag.String("out", "", "destination RaidSimRequest JSON file")
+	gearDir := flag.String("gear-dir", filepath.FromSlash("ui/warrior/gear_sets"), "warrior gear-set directory")
+	flag.Parse()
+	if *outPath == "" {
+		fmt.Fprintln(os.Stderr, "-out is required")
+		os.Exit(2)
+	}
+
+	rootSim.RegisterAll()
+	gear := core.GetGearSet(*gearDir, "phase_1").GearSet
+	player := core.WithSpec(&proto.Player{
+		Name:               "O2O Fury Warrior Fixture",
+		Class:              proto.Class_ClassWarrior,
+		Race:               proto.Race_RaceOrc,
+		Equipment:          gear,
+		TalentsString:      "30305001302-05050005525010051",
+		DistanceFromTarget: 5,
+		ReactionTimeMs:     150,
+		Rotation:           &proto.APLRotation{},
+	}, &proto.Player_Warrior{Warrior: &proto.Warrior{Options: &proto.Warrior_Options{
+		StartingRage: 100,
+		Stance:       proto.WarriorStance_WarriorStanceBerserker,
+	}}})
+	request := &proto.RaidSimRequest{
+		Raid:      core.SinglePlayerRaidProto(player, &proto.PartyBuffs{}, &proto.RaidBuffs{}, &proto.Debuffs{}),
+		Encounter: core.MakeSingleTargetEncounter(0),
+		SimOptions: &proto.SimOptions{
+			Iterations:  1,
+			RandomSeed:  20260828,
+			Interactive: true,
+		},
+	}
+
+	data, err := (protojson.MarshalOptions{Multiline: true, Indent: "  "}).Marshal(request)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	if err := os.WriteFile(*outPath, append(data, '\n'), 0o644); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
