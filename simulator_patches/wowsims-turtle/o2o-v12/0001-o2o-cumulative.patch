+func TestDynamicV2FutureSemanticsCancelWithContiguousReceiptsWhenFightEnds(t *testing.T) {
+	config := boundDynamicV2Config(
+		t,
+		DynamicRetargetNextAliveCyclic,
+		[]float64{10},
+		[]BackgroundDamageEventV1{
+			{ScheduleIndex: 0, TimeMS: 10, TargetIndex: 0, EventID: "finish-before-semantics", Damage: 10},
+		},
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 20, TargetIndex: 0, Attackable: false},
+		},
+		[]DynamicEffectiveArmorEventV2{
+			{ScheduleIndex: 0, TimeMS: 20, TargetIndex: 0, EffectiveArmor: 0},
+		},
+	)
+	env := newDynamicV2TestEnvironment(t, config, 111)
+	if err := env.Wait(20 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if !env.State().Finished {
+		t.Fatal("background kill did not finish the single-target encounter")
+	}
+	attackability, err := env.DynamicAttackabilityReceiptsV2(0)
+	if err != nil || !attackability.ScheduleComplete || attackability.NextCursor != 1 ||
+		len(attackability.Receipts) != 1 || attackability.Receipts[0].ScheduleIndex != 0 ||
+		attackability.Receipts[0].Status != DynamicTransitionCanceledEncounterFinished {
+		t.Fatalf("future attackability schedule was not canceled contiguously: batch=%+v err=%v", attackability, err)
+	}
+	armor, err := env.DynamicArmorReceiptsV2(0)
+	if err != nil || !armor.ScheduleComplete || armor.NextCursor != 1 || len(armor.Receipts) != 1 ||
+		armor.Receipts[0].ScheduleIndex != 0 || armor.Receipts[0].Status != DynamicTransitionCanceledEncounterFinished {
+		t.Fatalf("future armor schedule was not canceled contiguously: batch=%+v err=%v", armor, err)
+	}
+}
