+func dynamicRequest(health ...float64) *proto.RaidSimRequest {
+	request := testWarriorRequest()
+	baseTarget := request.Encounter.Targets[0]
+	request.Encounter.Targets = nil
+	for index, value := range health {
+		target := googleProto.Clone(baseTarget).(*proto.Target)
+		target.Name = "dynamic-target"
+		target.Stats = make([]float64, stats.Len)
+		target.Stats[stats.Health] = value
+		target.Stats[stats.Armor] = float64(1000 + index)
+		target.SwingSpeed = 0
+		target.MinBaseDamage = 0
+		target.DamageSpread = 0
+		request.Encounter.Targets = append(request.Encounter.Targets, target)
+	}
+	request.Encounter.UseHealth = true
+	request.Encounter.Duration = 60
+	return request
+}
+
+func boundDynamicConfig(
+	t *testing.T,
+	mode DynamicRetargetMode,
+	health []float64,
+	events []BackgroundDamageEventV1,
+) DynamicTeamBackgroundConfigV1 {
+	t.Helper()
+	targets := make([]DynamicTargetHealthV1, len(health))
+	for index, value := range health {
+		targets[index] = DynamicTargetHealthV1{TargetIndex: int32(index), Health: value}
+	}
+	config := DynamicTeamBackgroundConfigV1{
+		Schema:                 DynamicTeamBackgroundSchemaV1,
+		TargetHealth:           targets,
+		BackgroundDamageEvents: events,
+		SameTimestampOrder:     DynamicSameTimestampOrderV1,
+		RetargetMode:           mode,
+	}
+	digest, err := DynamicTeamBackgroundDigestV1(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.ContentSHA256 = digest
+	return config
+}
+
+func newDynamicTestEnvironment(
+	t *testing.T,
+	request *proto.RaidSimRequest,
+	config DynamicTeamBackgroundConfigV1,
+) *Environment {
+	t.Helper()
+	env, receipt, err := NewDynamicV1(request, 246, config, 7)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(env.Cleanup)
+	if receipt.EnvironmentGeneration != 7 || receipt.ConfigDigest != config.ContentSHA256 {
+		t.Fatalf("dynamic load receipt lost its binding: %+v", receipt)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	return env
+}
