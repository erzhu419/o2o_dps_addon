diff --git a/sim/warrior/talents_test.go b/sim/warrior/talents_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fc95967bd0773c1fb3084621cd57ae5325634cf2
--- /dev/null
+++ b/sim/warrior/talents_test.go
@@ -0,0 +1,204 @@
+package warrior
+
+import (
+	"math"
+	"testing"
+	"time"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+)
+
+func newFlurryTestWarrior(name string) *Warrior {
+	party := &core.Party{Index: 0}
+	character := core.NewCharacter(party, 0, &proto.Player{
+		Name:      name,
+		Race:      proto.Race_RaceHuman,
+		Class:     proto.Class_ClassWarrior,
+		Spec:      &proto.Player_Warrior{Warrior: &proto.Warrior{}},
+		Equipment: &proto.EquipmentSpec{},
+	})
+	warrior := NewWarrior(&character, "", WarriorInputs{})
+	warrior.Unit.Env = &core.Environment{State: core.Constructed}
+	return warrior
+}
+
+func enableFlurryTestAutoAttacks(warrior *Warrior, sim *core.Simulation) {
+	warrior.EnableAutoAttacks(warrior, core.AutoAttackOptions{
+		MainHand: core.Weapon{
+			BaseDamageMin: 1,
+			BaseDamageMax: 1,
+			SwingSpeed:    2,
+		},
+		OffHand: core.Weapon{
+			BaseDamageMin: 1,
+			BaseDamageMax: 1,
+			SwingSpeed:    2.5,
+		},
+		AutoSwingMelee: true,
+	})
+	warrior.AutoAttacks.EnableAutoSwing(sim)
+	warrior.AutoAttacks.StopMeleeUntil(sim, sim.CurrentTime, false)
+}
+
+func scaledSwingDeadline(now time.Duration, deadline time.Duration, speedMultiplier float64) time.Duration {
+	return now + time.Duration(float64(deadline-now)/speedMultiplier)
+}
+
+func requireSwingDeadline(t *testing.T, got time.Duration, want time.Duration, label string) {
+	t.Helper()
+	if delta := math.Abs(float64(got - want)); delta > float64(time.Nanosecond) {
+		t.Fatalf("%s deadline = %s, want %s", label, got, want)
+	}
+}
+
+func TestTurtleUnbridledWrathRankFiveAndTwoHandBonus(t *testing.T) {
+	if got := unbridledWrathProcChance(5); got != 0.75 {
+		t.Fatalf("rank-5 Unbridled Wrath proc chance = %.2f, want 0.75", got)
+	}
+	if got := unbridledWrathRagePerProc(proto.HandType_HandTypeTwoHand); got != 2 {
+		t.Fatalf("two-hand Unbridled Wrath rage = %.0f, want 2", got)
+	}
+	if got := unbridledWrathRagePerProc(proto.HandType_HandTypeOneHand); got != 1 {
+		t.Fatalf("one-hand Unbridled Wrath rage = %.0f, want 1", got)
+	}
+}
+
+func TestTurtleTwoHandedWeaponSpecializationUsesTooltipScope(t *testing.T) {
+	if got, want := twoHandedWeaponSpecializationDamageMultiplier(3), 1.06; math.Abs(got-want) > 1e-12 {
+		t.Fatalf("rank-3 two-handed damage multiplier = %.3f, want %.3f", got, want)
+	}
+	if twoHandedWeaponSpecializationApplies(&core.Spell{
+		SpellCode:        SpellCode_WarriorBloodthirst,
+		BonusCoefficient: 1,
+	}) {
+		t.Fatal("Bloodthirst is AP-based and must not receive two-handed weapon damage")
+	}
+	if !twoHandedWeaponSpecializationApplies(&core.Spell{
+		SpellCode:        SpellCode_WarriorSlam,
+		BonusCoefficient: 1,
+	}) {
+		t.Fatal("Slam is weapon-based and must receive two-handed weapon damage")
+	}
+	if twoHandedWeaponSpecializationApplies(&core.Spell{
+		ActionID:         core.ActionID{SpellID: 6552},
+		BonusCoefficient: 1,
+	}) {
+		t.Fatal("Pummel fixed damage must not receive two-handed weapon damage")
+	}
+}
+
+func TestTurtleFlurryUsesProcAuraIDs(t *testing.T) {
+	wants := []int32{12966, 12967, 12968, 12969, 12970}
+	for index, want := range wants {
+		warrior := newFlurryTestWarrior("flurry-aura-id")
+		aura := warrior.makeFlurryAura(int32(index + 1))
+		if aura == nil {
+			t.Fatalf("Flurry rank %d aura was not registered", index+1)
+		}
+		if got := aura.ActionID.SpellID; got != want {
+			t.Fatalf("Flurry rank %d aura ID = %d, want proc aura %d", index+1, got, want)
+		}
+	}
+}
+
+func TestTurtleFlurryWhiteSwingOnlyRescalesTriggeringHand(t *testing.T) {
+	warrior := newFlurryTestWarrior("flurry-white-boundary")
+	warrior.Talents.Flurry = 5
+	warrior.applyFlurry()
+	warrior.Unit.Env.State = core.Finalized
+	sim := &core.Simulation{CurrentTime: time.Second}
+	enableFlurryTestAutoAttacks(warrior, sim)
+
+	flurry := warrior.GetAuraByID(core.ActionID{SpellID: 12970})
+	procTrigger := warrior.GetAura("Flurry Proc Trigger")
+	consumeTrigger := warrior.GetAura("Flurry Consume Trigger - 12970")
+	if flurry == nil || procTrigger == nil || consumeTrigger == nil {
+		t.Fatal("5/5 Flurry aura and triggers must all be registered")
+	}
+	procTrigger.Activate(sim)
+	consumeTrigger.Activate(sim)
+
+	mainHandBeforeGain := warrior.AutoAttacks.NextMHSwingAt()
+	offHandBeforeGain := warrior.AutoAttacks.NextOHSwingAt()
+	procTrigger.OnSpellHitDealt(
+		procTrigger,
+		sim,
+		&core.Spell{ProcMask: core.ProcMaskMeleeMHAuto},
+		&core.SpellResult{Outcome: core.OutcomeCrit},
+	)
+
+	requireSwingDeadline(
+		t,
+		warrior.AutoAttacks.NextMHSwingAt(),
+		scaledSwingDeadline(sim.CurrentTime, mainHandBeforeGain, 1.3),
+		"main-hand after white-crit Flurry gain",
+	)
+	if got := warrior.AutoAttacks.NextOHSwingAt(); got != offHandBeforeGain {
+		t.Fatalf("off-hand deadline after MH Flurry gain = %s, want preserved %s", got, offHandBeforeGain)
+	}
+
+	flurry.SetStacks(sim, 1)
+	warrior.AutoAttacks.StopMeleeUntil(sim, sim.CurrentTime, false)
+	mainHandBeforeExpire := warrior.AutoAttacks.NextMHSwingAt()
+	offHandBeforeExpire := warrior.AutoAttacks.NextOHSwingAt()
+	consumeTrigger.OnSpellHitDealt(
+		consumeTrigger,
+		sim,
+		&core.Spell{ProcMask: core.ProcMaskMeleeOHAuto},
+		&core.SpellResult{Outcome: core.OutcomeHit},
+	)
+
+	if flurry.IsActive() {
+		t.Fatal("last Flurry stack was not consumed")
+	}
+	if got := warrior.AutoAttacks.NextMHSwingAt(); got != mainHandBeforeExpire {
+		t.Fatalf("main-hand deadline after OH Flurry expiry = %s, want preserved %s", got, mainHandBeforeExpire)
+	}
+	requireSwingDeadline(
+		t,
+		warrior.AutoAttacks.NextOHSwingAt(),
+		scaledSwingDeadline(sim.CurrentTime, offHandBeforeExpire, 1/1.3),
+		"off-hand after last-stack Flurry expiry",
+	)
+	if got, want := warrior.AutoAttacks.OffhandSwingSpeed(), 2500*time.Millisecond; got != want {
+		t.Fatalf("off-hand swing period after Flurry expiry = %s, want base %s", got, want)
+	}
+}
+
+func TestTurtleFlurrySpecialCritKeepsGlobalTimerRescale(t *testing.T) {
+	warrior := newFlurryTestWarrior("flurry-special-global")
+	warrior.Talents.Flurry = 5
+	warrior.applyFlurry()
+	warrior.Unit.Env.State = core.Finalized
+	sim := &core.Simulation{CurrentTime: time.Second}
+	enableFlurryTestAutoAttacks(warrior, sim)
+	procTrigger := warrior.GetAura("Flurry Proc Trigger")
+	procTrigger.Activate(sim)
+
+	mainHandBefore := warrior.AutoAttacks.NextMHSwingAt()
+	offHandBefore := warrior.AutoAttacks.NextOHSwingAt()
+	procTrigger.OnSpellHitDealt(
+		procTrigger,
+		sim,
+		&core.Spell{ProcMask: core.ProcMaskMeleeMHSpecial},
+		&core.SpellResult{Outcome: core.OutcomeCrit},
+	)
+
+	requireSwingDeadline(t, warrior.AutoAttacks.NextMHSwingAt(), scaledSwingDeadline(sim.CurrentTime, mainHandBefore, 1.3), "main-hand after special-crit Flurry gain")
+	requireSwingDeadline(t, warrior.AutoAttacks.NextOHSwingAt(), scaledSwingDeadline(sim.CurrentTime, offHandBefore, 1.3), "off-hand after special-crit Flurry gain")
+}
+
+func TestMultiplyMeleeSpeedStillRescalesBothHands(t *testing.T) {
+	warrior := newFlurryTestWarrior("ordinary-melee-haste")
+	warrior.Unit.Env.State = core.Finalized
+	sim := &core.Simulation{CurrentTime: time.Second}
+	enableFlurryTestAutoAttacks(warrior, sim)
+	mainHandBefore := warrior.AutoAttacks.NextMHSwingAt()
+	offHandBefore := warrior.AutoAttacks.NextOHSwingAt()
+
+	warrior.MultiplyMeleeSpeed(sim, 1.2)
+
+	requireSwingDeadline(t, warrior.AutoAttacks.NextMHSwingAt(), scaledSwingDeadline(sim.CurrentTime, mainHandBefore, 1.2), "main-hand after ordinary melee haste")
+	requireSwingDeadline(t, warrior.AutoAttacks.NextOHSwingAt(), scaledSwingDeadline(sim.CurrentTime, offHandBefore, 1.2), "off-hand after ordinary melee haste")
+}
