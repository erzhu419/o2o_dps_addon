+func TestDynamicConfigValidationFailsClosed(t *testing.T) {
+	baseHealth := []float64{100, 200}
+	baseEvents := []BackgroundDamageEventV1{
+		{ScheduleIndex: 0, TimeMS: 10, TargetIndex: 0, EventID: "event-a", Damage: 1},
+		{ScheduleIndex: 1, TimeMS: 10, TargetIndex: 1, EventID: "event-b", Damage: 2},
+	}
+	tests := []struct {
+		name   string
+		mutate func(*DynamicTeamBackgroundConfigV1)
+		match  string
+	}{
+		{name: "duplicate target", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.TargetHealth[1].TargetIndex = 0 }, match: "target_health must cover"},
+		{name: "non-finite health", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.TargetHealth[0].Health = math.NaN() }, match: "health must be finite and positive"},
+		{name: "duplicate event id", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.BackgroundDamageEvents[1].EventID = "event-a" }, match: "duplicate background event_id"},
+		{name: "unsorted events", mutate: func(c *DynamicTeamBackgroundConfigV1) {
+			c.BackgroundDamageEvents[0].TimeMS = 20
+		}, match: "strictly sorted"},
+		{name: "out of range target", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.BackgroundDamageEvents[1].TargetIndex = 2 }, match: "target_index out of range"},
+		{name: "non-finite damage", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.BackgroundDamageEvents[0].Damage = math.Inf(1) }, match: "damage must be finite and positive"},
+		{name: "unknown ordering", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.SameTimestampOrder = "CANDIDATE_BEFORE_BACKGROUND" }, match: "same_timestamp_order"},
+		{name: "unknown retarget", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.RetargetMode = "RANDOM" }, match: "retarget_mode"},
+		{name: "hash mismatch", mutate: func(c *DynamicTeamBackgroundConfigV1) { c.ContentSHA256 = strings.Repeat("0", 64) }, match: "content_sha256 mismatch"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			config := boundDynamicConfig(t, DynamicRetargetNextAliveCyclic, baseHealth, append([]BackgroundDamageEventV1(nil), baseEvents...))
+			tc.mutate(&config)
+			if tc.name != "hash mismatch" {
+				digest, err := DynamicTeamBackgroundDigestV1(config)
+				if err == nil {
+					config.ContentSHA256 = digest
+				}
+			}
+			_, _, err := NewDynamicV1(dynamicRequest(baseHealth...), 1, config, 1)
+			if err == nil || !strings.Contains(err.Error(), tc.match) {
+				t.Fatalf("error = %v, want substring %q", err, tc.match)
+			}
+		})
+	}
+	config := boundDynamicConfig(t, DynamicRetargetNextAliveCyclic, baseHealth, baseEvents)
+	if _, _, err := NewDynamicV1(dynamicRequest(100, 201), 1, config, 1); err == nil || !strings.Contains(err.Error(), "does not match RaidSimRequest target health") {
+		t.Fatalf("request/config target HP mismatch did not fail closed: %v", err)
+	}
+}
