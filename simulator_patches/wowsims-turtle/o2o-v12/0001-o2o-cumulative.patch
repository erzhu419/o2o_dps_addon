+package o2o
+
+import (
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+)
+
+func TestCancelQueuedMeleeWithNoAcceptedQueueIsNoOp(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	character := env.player().GetCharacter()
+	if !character.AutoAttacks.IsDualWielding {
+		t.Fatal("queue-cancel fixture must be dual wielding")
+	}
+
+	rageBefore := character.CurrentRage()
+	targetBefore := character.CurrentTarget
+	mhBefore := character.AutoAttacks.NextMHSwingAt()
+	ohBefore := character.AutoAttacks.NextOHSwingAt()
+	result, err := env.CancelQueuedMelee()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Canceled || result.ConsumesDecision || result.Finished || !result.NeedsInput {
+		t.Fatalf("empty queue cancellation result = %+v", result)
+	}
+	if got := character.CurrentRage(); got != rageBefore {
+		t.Fatalf("empty queue cancellation changed rage: got %.3f, want %.3f", got, rageBefore)
+	}
+	if character.CurrentTarget != targetBefore {
+		t.Fatal("empty queue cancellation changed target")
+	}
+	if got := character.AutoAttacks.NextMHSwingAt(); got != mhBefore {
+		t.Fatalf("empty queue cancellation changed MH deadline: got %s, want %s", got, mhBefore)
+	}
+	if got := character.AutoAttacks.NextOHSwingAt(); got != ohBefore {
+		t.Fatalf("empty queue cancellation changed OH deadline: got %s, want %s", got, ohBefore)
+	}
+}
+
+func TestCancelAcceptedHeroicStrikeAndCleavePreservesStateAndNextMHIsWhite(t *testing.T) {
+	for _, testCase := range []struct {
+		name     string
+		spellIDs []int32
+	}{
+		{name: "heroic_strike", spellIDs: []int32{25286, 11567}},
+		{name: "cleave", spellIDs: []int32{20569}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			env := newTestWarriorEnvironment(t, testWarriorRequest())
+			character := env.player().GetCharacter()
+			if !character.AutoAttacks.IsDualWielding {
+				t.Fatal("queue-cancel fixture must be dual wielding")
+			}
+			queue := requireQueuedMeleeAction(t, env, testCase.spellIDs...)
+			queuedSwing := character.GetSpell(core.ActionID{SpellID: queue.SpellID})
+			if queuedSwing == nil {
+				t.Fatalf("queued next-swing replacement is not registered: %d", queue.SpellID)
+			}
+
+			queued, err := env.Apply(queue)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !queued.Casted || queued.ConsumesDecision || !queued.NeedsInput {
+				t.Fatalf("queue request did not preserve the decision: %+v", queued)
+			}
+
+			// Apply schedules acceptance. Before the pending action activates the
+			// queue aura there is deliberately nothing cancellable.
+			pending, err := env.CancelQueuedMelee()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pending.Canceled || pending.ConsumesDecision || !pending.NeedsInput {
+				t.Fatalf("unaccepted queue must not be canceled: %+v", pending)
+			}
+			advanceUntilQueueAura(t, env, queue)
+
+			// A second queue action remains an ordinary rejected cast, never a
+			// toggle or an implicit cancel operation.
+			requeued, err := env.Apply(queue)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if requeued.Casted || requeued.ConsumesDecision || !requeued.NeedsInput {
+				t.Fatalf("second queue request must not toggle the accepted aura: %+v", requeued)
+			}
+			if !hasQueueAura(env.State(), queue) {
+				t.Fatal("second queue request cleared the accepted queue aura")
+			}
+
+			rageBefore := character.CurrentRage()
+			targetBefore := character.CurrentTarget
+			mhBefore := character.AutoAttacks.NextMHSwingAt()
+			ohBefore := character.AutoAttacks.NextOHSwingAt()
+			whiteBefore := queuedCancelCastCount(character.AutoAttacks.MHAuto())
+			queuedBefore := queuedCancelCastCount(queuedSwing)
+
+			canceled, err := env.CancelQueuedMelee()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !canceled.Canceled || canceled.ConsumesDecision || canceled.Finished || !canceled.NeedsInput {
+				t.Fatalf("accepted queue cancellation result = %+v", canceled)
+			}
+			if got := character.CurrentRage(); got != rageBefore {
+				t.Fatalf("queue cancellation changed rage: got %.3f, want %.3f", got, rageBefore)
+			}
+			if character.CurrentTarget != targetBefore {
+				t.Fatal("queue cancellation changed target")
+			}
+			if got := character.AutoAttacks.NextMHSwingAt(); got != mhBefore {
+				t.Fatalf("queue cancellation changed MH deadline: got %s, want %s", got, mhBefore)
+			}
+			if got := character.AutoAttacks.NextOHSwingAt(); got != ohBefore {
+				t.Fatalf("queue cancellation changed OH deadline: got %s, want %s", got, ohBefore)
+			}
+			if hasQueueAura(env.State(), queue) {
+				t.Fatal("queue aura remained active after explicit cancellation")
+			}
+
+			second, err := env.CancelQueuedMelee()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if second.Canceled || second.ConsumesDecision || !second.NeedsInput {
+				t.Fatalf("second cancellation must be an empty no-op: %+v", second)
+			}
+
+			remaining := mhBefore - env.sim.CurrentTime
+			if remaining <= 0 {
+				t.Fatalf("test lost the future MH deadline: now=%s deadline=%s", env.sim.CurrentTime, mhBefore)
+			}
+			if err := env.Wait(remaining); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := env.AdvanceUntilDecision(); err != nil {
+				t.Fatal(err)
+			}
+			if got := queuedCancelCastCount(character.AutoAttacks.MHAuto()); got != whiteBefore+1 {
+				t.Fatalf("next MH was not one white swing: got casts=%d, want %d", got, whiteBefore+1)
+			}
+			if got := queuedCancelCastCount(queuedSwing); got != queuedBefore {
+				t.Fatalf("queued replacement fired after cancellation: got casts=%d, want %d", got, queuedBefore)
+			}
+			if hasQueueAura(env.State(), queue) {
+				t.Fatal("queue aura reappeared after the next white swing")
+			}
+		})
+	}
+}
+
+func requireQueuedMeleeAction(t *testing.T, env *Environment, spellIDs ...int32) ActionRef {
+	t.Helper()
+	for _, action := range env.AvailableActions() {
+		if action.Action.Tag != 1 {
+			continue
+		}
+		for _, spellID := range spellIDs {
+			if action.Action.SpellID == spellID {
+				if !action.Legal {
+					t.Fatalf("queued melee action is not legal: %+v", action)
+				}
+				return action.Action
+			}
+		}
+	}
+	t.Fatalf("queued melee action not found: spell_ids=%v", spellIDs)
+	return ActionRef{}
+}
+
+func advanceUntilQueueAura(t *testing.T, env *Environment, queue ActionRef) {
+	t.Helper()
+	for step := 0; step < 20 && !hasQueueAura(env.State(), queue); step++ {
+		if env.sim.Step() {
+			t.Fatal("encounter ended before queued melee aura was accepted")
+		}
+	}
+	if !hasQueueAura(env.State(), queue) {
+		t.Fatal("queued melee aura was not accepted within 20 simulator steps")
+	}
+	if !env.sim.NeedsInput {
+		t.Fatal("queue acceptance consumed the interactive decision")
+	}
+}
+
+func hasQueueAura(state State, queue ActionRef) bool {
+	for _, aura := range state.Auras {
+		if aura.Action.SpellID == queue.SpellID && aura.Action.Tag == 1 {
+			return true
+		}
+	}
+	return false
+}
+
+func queuedCancelCastCount(spell *core.Spell) int32 {
+	var casts int32
+	for _, metrics := range spell.SpellMetrics {
+		casts += metrics.Casts
+	}
+	return casts
+}
