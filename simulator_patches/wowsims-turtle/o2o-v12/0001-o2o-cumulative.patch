+func TestTurtleRavagerRankTwoCleaveQueuesNextSwing(t *testing.T) {
+	request := turtleSlamRequest()
+	player := request.Raid.Parties[0].Players[0]
+	player.TalentsString = ""
+	player.GetWarrior().Options.StartingRage = 50
+	env := newTestWarriorEnvironment(t, request)
+	character := env.player().GetCharacter()
+	cleave := character.GetSpell(core.ActionID{SpellID: 20569})
+	if cleave == nil {
+		t.Fatal("Cleave swing spell was not registered")
+	}
+	if got := cleave.Cost.GetCurrentCost(); got != 18 {
+		t.Fatalf("rank-2 Ravager Cleave cost = %.0f, want 18", got)
+	}
+
+	for _, available := range env.AvailableActions() {
+		if available.Action.SpellID == 20569 && available.Action.Tag == 0 {
+			t.Fatal("implementation-only tag-0 Cleave must not be exported")
+		}
+	}
+	if _, err := env.Apply(ActionRef{SpellID: 20569}); err == nil {
+		t.Fatal("implementation-only tag-0 Cleave must be rejected")
+	}
+	_, queue := requireSpellAction(t, env, 1, 20569)
+
+	deadline := character.AutoAttacks.NextMHSwingAt()
+	castsBefore := spellCastCount(cleave)
+	queued, err := env.Apply(queue)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !queued.Casted || queued.ConsumesDecision || !queued.NeedsInput {
+		t.Fatalf("Cleave queue should preserve the decision: %+v", queued)
+	}
+	if got := env.State().Power.Current; got != 50 {
+		t.Fatalf("Cleave queue spent rage before the swing: got %.0f, want 50", got)
+	}
+	if got := character.AutoAttacks.NextMHSwingAt(); got != deadline {
+		t.Fatalf("Cleave queue moved the main-hand deadline: got %s, want %s", got, deadline)
+	}
+
+	if err := env.Wait(deadline - env.sim.CurrentTime - time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if got := spellCastCount(cleave); got != castsBefore {
+		t.Fatalf("Cleave fired before the main-hand deadline: casts=%d before=%d", got, castsBefore)
+	}
+	rageBeforeSwing := env.State().Power.Current
+	if err := env.Wait(time.Millisecond + core.SpellBatchWindow); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if got := spellCastCount(cleave); got != castsBefore+1 {
+		t.Fatalf("Cleave did not replace exactly one main-hand swing: casts=%d before=%d", got, castsBefore)
+	}
+	if got := env.State().Power.Current - rageBeforeSwing; math.Abs(got+18) > 1e-9 {
+		t.Fatalf("Cleave swing rage delta = %.9f, want -18", got)
+	}
+	if got := character.AutoAttacks.NextMHSwingAt(); got <= deadline {
+		t.Fatalf("main-hand deadline did not advance after Cleave: next=%s old=%s", got, deadline)
+	}
+}
