@@ -0,0 +1,173 @@
+package database
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+)
+
+func spellCSVFixture(rows ...string) string {
+	headers := []string{
+		"id", "shapeshiftMask", "shapeshiftExclude", "targetCreatureType",
+		"effect_1", "effect_2", "effect_3",
+		"effectApplyAura_1", "effectApplyAura_2", "effectApplyAura_3",
+		"effectBasePoints_1", "effectBasePoints_2", "effectBasePoints_3",
+		"effectBaseDice_1", "effectBaseDice_2", "effectBaseDice_3",
+		"effectMiscValue_1", "effectMiscValue_2", "effectMiscValue_3",
+	}
+	return strings.Join(append([]string{strings.Join(headers, ",")}, rows...), "\n")
+}
+
+func TestParseSpellEffectsDoesNotFoldConditionalStats(t *testing.T) {
+	analyses := parseSpellEffectsCSV(spellCSVFixture(
+		// Raka'shishi form-only attack power aura (51064).
+		"51064,1073741969,0,0,6,0,0,99,0,0,447,0,0,1,0,0,0,0,0",
+		// Generic creature-target restriction: this protects future DBC rows too.
+		"900001,0,0,4,6,0,0,99,0,0,44,0,0,1,0,0,0,0,0",
+		// An ordinary unconditional aura remains reducible to a raw stat.
+		"900002,0,0,0,6,0,0,99,0,0,44,0,0,1,0,0,0,0,0",
+	))
+
+	for _, spellID := range []int32{51064, 900001} {
+		analysis := analyses[spellID]
+		if !analysis.HasUnhandledEffect {
+			t.Fatalf("conditional spell %d was not retained as unhandled", spellID)
+		}
+		if len(analysis.Effects) != 0 {
+			t.Fatalf("conditional spell %d leaked static effects: %+v", spellID, analysis.Effects)
+		}
+	}
+
+	control := analyses[900002]
+	if control.HasUnhandledEffect || len(control.Effects) != 1 {
+		t.Fatalf("unconditional control was not reduced normally: %+v", control)
+	}
+	if got := control.Effects[0]; got.Stat != proto.Stat_StatAttackPower || got.Value != 45 {
+		t.Fatalf("unconditional control effect = %+v, want 45 Attack Power", got)
+	}
+}
+
+func TestParseSpellEffectsKeepsCreatureAttackPowerConditional(t *testing.T) {
+	analyses := parseSpellEffectsCSV(spellCSVFixture(
+		// Demon Slaying 45 (14097): melee and ranged AP-vs-creature auras.
+		"14097,0,0,0,6,6,0,102,131,0,44,44,0,1,1,0,4,4,0",
+	))
+
+	analysis := analyses[14097]
+	if !analysis.HasUnhandledEffect {
+		t.Fatal("creature-specific attack power was not retained as an explicit effect")
+	}
+	if len(analysis.Effects) != 0 {
+		t.Fatalf("creature-specific attack power leaked into global stats: %+v", analysis.Effects)
+	}
+
+	itemHeaders := []string{"spell1ID", "spell1TriggerID"}
+	itemRow := []string{"14097", "1"}
+	itemCols := map[string]int{itemHeaders[0]: 0, itemHeaders[1]: 1}
+	bonuses, _, _ := parseItemSpellEffects(itemRow, itemCols, analyses)
+	if !isAllZeros(bonuses) {
+		t.Fatalf("creature-specific attack power leaked into item stats: %+v", bonuses)
+	}
+	effects := parseItemEffects(itemRow, itemCols, analyses)
+	if len(effects) != 1 || effects[0].SpellId != 14097 {
+		t.Fatalf("conditional spell record was lost: %+v", effects)
+	}
+}
+
+func TestTurtleDBCConditionalSpellRegression(t *testing.T) {
+	spellCSV, err := os.ReadFile("../../assets/db_inputs/Spell.csv")
+	if err != nil {
+		t.Fatalf("read Turtle Spell.csv: %v", err)
+	}
+	analyses := parseSpellEffectsCSV(string(spellCSV))
+
+	for _, spellID := range []int32{51064, 14097} {
+		analysis, ok := analyses[spellID]
+		if !ok {
+			t.Fatalf("Spell.csv analysis missing spell %d", spellID)
+		}
+		if !analysis.HasUnhandledEffect || len(analysis.Effects) != 0 {
+			t.Fatalf("conditional spell %d analysis = %+v, want explicit unhandled effect and no global stats", spellID, analysis)
+		}
+	}
+
+	itemsCSV, err := os.ReadFile("../../assets/db_inputs/Items.csv")
+	if err != nil {
+		t.Fatalf("read Turtle Items.csv: %v", err)
+	}
+	items := parseItemsCSV(
+		string(itemsCSV),
+		map[int32]string{},
+		analyses,
+		map[int32]proto.UIItem_FactionRestriction{},
+		map[int32]itemSetInfo{},
+	)
+	itemsByID := make(map[int32]*proto.UIItem, len(items))
+	for _, item := range items {
+		itemsByID[item.Id] = item
+	}
+
+	for _, itemID := range []int32{55113, 55116} {
+		item := itemsByID[itemID]
+		if item == nil {
+			t.Fatalf("Items.csv parse missing item %d", itemID)
+		}
+		for _, stat := range []proto.Stat{proto.Stat_StatAttackPower, proto.Stat_StatRangedAttackPower} {
+			if int(stat) < len(item.Stats) && item.Stats[stat] != 0 {
+				t.Fatalf("item %d leaked conditional spell value into %s: %.0f", itemID, stat, item.Stats[stat])
+			}
+		}
+	}
+
+	wantExplicitSpells := map[int32][]int32{
+		55113: {14097},
+		55116: {51064, 51068},
+	}
+	for itemID, spellIDs := range wantExplicitSpells {
+		seen := map[int32]bool{}
+		for _, effect := range itemsByID[itemID].Effects {
+			seen[effect.SpellId] = true
+		}
+		for _, spellID := range spellIDs {
+			if !seen[spellID] {
+				t.Fatalf("item %d lost explicit conditional/unhandled spell %d: %+v", itemID, spellID, itemsByID[itemID].Effects)
+			}
+		}
+	}
+}
+
+func TestNormalizeSpellAnalysisKeepsNonStatEffectsOutOfStrength(t *testing.T) {
+	weaponSkillEffects, handled := auraTypeToEffects(auraModSkill, 172, 7)
+	if !handled {
+		t.Fatal("two-handed axe skill effect was not handled")
+	}
+	physicalDamageEffects, handled := auraTypeToEffects(auraModDamageDone, 1, 5)
+	if !handled {
+		t.Fatal("physical damage effect was not handled")
+	}
+
+	analysis := SpellAnalysis{Effects: append(weaponSkillEffects, physicalDamageEffects...)}
+	normalizeSpellAnalysis(&analysis, 0, 0)
+
+	var strength, weaponSkill, physicalDamage float64
+	for _, effect := range analysis.Effects {
+		if effect.Stat == proto.Stat_StatStrength {
+			strength += effect.Value
+		}
+		if effect.WeaponSkill == proto.WeaponSkill_WeaponSkillTwoHandedAxes {
+			weaponSkill += effect.Value
+		}
+		physicalDamage += effect.BonusPhysicalDamage
+	}
+	if strength != 0 {
+		t.Fatalf("non-stat effects leaked %.0f Strength", strength)
+	}
+	if weaponSkill != 7 {
+		t.Fatalf("two-handed axe skill = %.0f, want 7", weaponSkill)
+	}
+	if physicalDamage != 5 {
+		t.Fatalf("bonus physical damage = %.0f, want 5", physicalDamage)
+	}
+}
