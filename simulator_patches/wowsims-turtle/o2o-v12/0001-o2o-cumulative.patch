+func forceHitOnEveryTarget(t *testing.T, env *Environment, spell *core.Spell) {
+	t.Helper()
+	character := env.player().GetCharacter()
+	character.PseudoStats.InFrontOfTarget = false
+	character.PseudoStats.DisableDWMissPenalty = true
+	spell.BonusCritRating = -10000
+	for _, target := range env.sim.Encounter.TargetUnits {
+		attackTable := character.AttackTables[target.UnitIndex][spell.CastType]
+		if attackTable == nil {
+			t.Fatalf("attack table not found for %s target %d", spell.ActionID, target.UnitIndex)
+		}
+		attackTable.BaseMissChance = 0
+		attackTable.BaseSpellMissChance = 0
+		attackTable.BaseDodgeChance = 0
+		attackTable.BaseParryChance = 0
+	}
+}
