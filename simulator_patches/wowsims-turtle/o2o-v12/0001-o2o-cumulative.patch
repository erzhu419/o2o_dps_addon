+	character := env.player().GetCharacter()
+
+	// Cast directly so this white-box fixture remains at an interactive input
+	// boundary while the hardcast is active. Environment.Apply intentionally
+	// closes that boundary for a GCD spell.
+	if !spell.Cast(env.sim, character.CurrentTarget) {
+		t.Fatal("Slam hardcast did not start")
+	}
+	if !character.IsCasting(env.sim) || env.State().CurrentCast == nil {
+		t.Fatal("expected an active Slam hardcast")
