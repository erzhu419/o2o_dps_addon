diff --git a/sim/o2o/precombat_actions_v1.go b/sim/o2o/precombat_actions_v1.go
new file mode 100644
index 000000000..130c3a799
--- /dev/null
+++ b/sim/o2o/precombat_actions_v1.go
@@ -0,0 +1,150 @@
+package o2o
+
+import (
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+)
+
+const PrecombatActionsSchemaV1 = "o2o_precombat_actions/v1"
+
+// PrecombatActionsConfigV1 declares the short interval before a modeled pull
+// and the exact self-only actions the caller may submit in that interval.  The
+// simulator clock remains non-negative; RelativeTimeMS in State is the clock
+// viewed from the pull origin.
+type PrecombatActionsConfigV1 struct {
+	Schema      string      `json:"schema"`
+	PullTimeMS  int64       `json:"pull_time_ms"`
+	SelfActions []ActionRef `json:"self_actions"`
+}
+
+type PrecombatActionsStateV1 struct {
+	Schema          string `json:"schema"`
+	PullTimeMS      int64  `json:"pull_time_ms"`
+	RelativeTimeMS  int64  `json:"relative_time_ms"`
+	Active          bool   `json:"active"`
+	SelfActionCount int    `json:"self_action_count"`
+}
+
+type precombatActionsRuntimeV1 struct {
+	config  PrecombatActionsConfigV1
+	allowed map[ActionRef]struct{}
+}
+
+// ConfigurePrecombatActionsV1 must run immediately after NewDynamicV3 and
+// before AdvanceUntilDecision.  It keeps the initial all-unattackable interval
+// policy-visible.  A target may become attackable at the pull or later when
+// player reachability is modeled separately from teammates already fighting.
+func (env *Environment) ConfigurePrecombatActionsV1(config PrecombatActionsConfigV1) error {
+	if env == nil || env.sim == nil || env.dynamicV3 == nil {
+		return errors.New("precombat actions require a live dynamic-v3 environment")
+	}
+	if env.precombat != nil || env.finished || env.sim.CurrentTime != 0 {
+		return errors.New("precombat actions must be configured once at simulator time zero")
+	}
+	if config.Schema != PrecombatActionsSchemaV1 {
+		return fmt.Errorf("precombat schema must be %q", PrecombatActionsSchemaV1)
+	}
+	if config.PullTimeMS <= 0 || config.PullTimeMS >= env.dynamicV3.config.IdleAdvanceHorizonMS {
+		return errors.New("pull_time_ms must be positive and before the scenario horizon")
+	}
+	if len(config.SelfActions) == 0 {
+		return errors.New("precombat self_actions must not be empty")
+	}
+	if env.sim.Environment.GetNumActiveTargets() != 0 {
+		return errors.New("precombat actions require every target to be unattackable at time zero")
+	}
+	foundCombatAccess := false
+	for _, event := range env.dynamicV3.config.AttackabilityEvents {
+		if event.TimeMS >= config.PullTimeMS &&
+			event.TimeMS < env.dynamicV3.config.IdleAdvanceHorizonMS &&
+			event.Attackable {
+			foundCombatAccess = true
+			break
+		}
+	}
+	if !foundCombatAccess {
+		return errors.New("scenario must have an attackable target transition at or after pull_time_ms")
+	}
+
+	character := env.player().GetCharacter()
+	allowed := make(map[ActionRef]struct{}, len(config.SelfActions))
+	for index, ref := range config.SelfActions {
+		if err := validatePrecombatActionRefV1(ref); err != nil {
+			return fmt.Errorf("self_actions[%d]: %w", index, err)
+		}
+		if _, duplicate := allowed[ref]; duplicate {
+			return fmt.Errorf("self_actions[%d] duplicates an earlier action", index)
+		}
+		spell := character.GetSpell(ref.coreID())
+		if spell == nil || !spell.Flags.Matches(core.SpellFlagAPL) {
+			return fmt.Errorf("self_actions[%d] is not an externally triggerable spellbook action", index)
+		}
+		if !precombatSelfSpellV1(spell) {
+			return fmt.Errorf("self_actions[%d] is not marked as a potion, helpful spell, prepull action, or equipment activation", index)
+		}
+		allowed[ref] = struct{}{}
+	}
+	config.SelfActions = append([]ActionRef(nil), config.SelfActions...)
+	env.precombat = &precombatActionsRuntimeV1{config: config, allowed: allowed}
+	return nil
+}
+
+func validatePrecombatActionRefV1(ref ActionRef) error {
+	if ref.SpellID < 0 || ref.ItemID < 0 || int32(ref.OtherID) < 0 || ref.Tag < 0 {
+		return errors.New("action identity fields must be non-negative")
+	}
+	identities := 0
+	if ref.SpellID > 0 {
+		identities++
+	}
+	if ref.ItemID > 0 {
+		identities++
+	}
+	if ref.OtherID > 0 {
+		identities++
+	}
+	if identities != 1 {
+		return errors.New("action must contain exactly one positive identity")
+	}
+	return nil
+}
+
+func precombatSelfSpellV1(spell *core.Spell) bool {
+	return spell.Flags.Matches(
+		core.SpellFlagPotion |
+			core.SpellFlagHelpful |
+			core.SpellFlagPrepullOnly |
+			core.SpellFlagOffensiveEquipment |
+			core.SpellFlagDefensiveEquipment,
+	)
+}
+
+func (env *Environment) precombatWindowOpenV1() bool {
+	return env.precombat != nil && !env.finished &&
+		env.sim.CurrentTime < time.Duration(env.precombat.config.PullTimeMS)*time.Millisecond
+}
+
+func (env *Environment) precombatActionAllowedV1(ref ActionRef) bool {
+	if !env.precombatWindowOpenV1() {
+		return false
+	}
+	_, ok := env.precombat.allowed[ref]
+	return ok
+}
+
+func (env *Environment) precombatStateV1() *PrecombatActionsStateV1 {
+	if env.precombat == nil {
+		return nil
+	}
+	pull := env.precombat.config.PullTimeMS
+	return &PrecombatActionsStateV1{
+		Schema:          PrecombatActionsSchemaV1,
+		PullTimeMS:      pull,
+		RelativeTimeMS:  env.sim.CurrentTime.Milliseconds() - pull,
+		Active:          env.precombatWindowOpenV1(),
+		SelfActionCount: len(env.precombat.allowed),
+	}
+}
