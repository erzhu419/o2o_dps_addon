+// O2OSwingQueueState exposes the next-swing replacement accepted by the
+// warrior queue machinery, including the reaction-delay interval before its
+// aura becomes active.
+func (warrior *Warrior) O2OSwingQueueState() (kind string, status string) {
+	if warrior.curQueueAura != nil && warrior.curQueueAura.IsActive() {
+		return warrior.o2oSwingQueueKind(warrior.curQueuedAutoSpell), "ACTIVE"
+	}
+	if warrior.pendingQueuedAutoSpell != nil {
+		return warrior.o2oSwingQueueKind(warrior.pendingQueuedAutoSpell), "PENDING"
+	}
+	return "NONE", "NONE"
+}
