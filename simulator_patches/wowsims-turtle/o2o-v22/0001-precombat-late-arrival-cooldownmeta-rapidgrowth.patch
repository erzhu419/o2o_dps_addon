+func newPrecombatTestEnvironmentWithConsumesAt(t *testing.T, actions []ActionRef, consumes *proto.Consumes, pullMS int64) *Environment {
+	t.Helper()
+	request := dynamicRequest(1_000_000)
+	request.Encounter.Duration = float64(pullMS+4000) / 1000
+	request.Raid.Parties[0].Players[0].Consumes = consumes
+	config := boundDynamicV3Config(
+		t,
+		DynamicRetargetNextAliveCyclic,
+		pullMS+4000,
+		[]float64{1_000_000},
+		nil,
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: pullMS, TargetIndex: 0, Attackable: true},
+		},
+		nil,
+	)
+	env, _, err := NewDynamicV3(request, 871, config, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(env.Cleanup)
+	if err := env.ConfigurePrecombatActionsV1(PrecombatActionsConfigV1{
+		Schema:      PrecombatActionsSchemaV1,
+		PullTimeMS:  pullMS,
+		SelfActions: actions,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if finished, err := env.AdvanceUntilDecision(); err != nil || finished {
+		t.Fatalf("precombat did not expose its initial decision: finished=%v err=%v", finished, err)
+	}
+	return env
+}
