+		if action := findPrecombatAction(t, env, ref); !action.Legal || action.CooldownDurationMS <= 0 {
+			t.Fatalf("burst action is not legal at -3000ms: %+v", action)
+		}
+	}
+	if result, err := env.Apply(potion); err != nil || !result.Casted || result.ConsumesDecision {
+		t.Fatalf("-3000ms potion failed: result=%+v err=%v", result, err)
+	}
+	if result, err := env.Apply(deathWish); err != nil || !result.Casted || !result.ConsumesDecision {
+		t.Fatalf("-3000ms Death Wish failed: result=%+v err=%v", result, err)
+	}
+	if finished, err := env.AdvanceUntilDecision(); err != nil || finished {
+		t.Fatalf("advance to -1500ms failed: finished=%v err=%v", finished, err)
+	}
+	beforeReck := env.State()
+	if beforeReck.TimeMS != 1500 || beforeReck.Precombat == nil || beforeReck.Precombat.RelativeTimeMS != -1500 {
+		t.Fatalf("Death Wish GCD did not reach -1500ms decision: %+v", beforeReck)
+	}
+	if result, err := env.Apply(recklessness); err != nil || !result.Casted || !result.ConsumesDecision {
+		t.Fatalf("-1500ms Recklessness failed: result=%+v err=%v", result, err)
+	}
+	if finished, err := env.AdvanceUntilDecision(); err != nil || finished {
+		t.Fatalf("advance from Recklessness to pull failed: finished=%v err=%v", finished, err)
+	}
+	atPull := env.State()
+	if atPull.TimeMS != pullMS || atPull.NumTargets != 1 || atPull.GCDRemainingMS != 0 {
+		t.Fatalf("combined burst did not land exactly at pull: %+v", atPull)
+	}
+	if got := activeAuraByLabel(t, atPull, "Mighty Rage Potion").RemainingMS; got != 17_000 {
+		t.Fatalf("Mighty Rage duration at pull = %dms, want 17000ms", got)
+	}
+	if got := activeAuraByLabel(t, atPull, "Death Wish").RemainingMS; got != 27_000 {
+		t.Fatalf("Death Wish duration at pull = %dms, want 27000ms", got)
+	}
+	if got := activeAuraByLabel(t, atPull, "Recklessness").RemainingMS; got != 13_500 {
+		t.Fatalf("Recklessness duration at pull = %dms, want 13500ms", got)
+	}
+}
+
+func TestPrecombatRecklessnessGCDNaturallyRemainsAtPull(t *testing.T) {
+	recklessness := ActionRef{SpellID: 1719}
+	env := newPrecombatTestEnvironment(t, []ActionRef{recklessness}, false)
+	if err := env.Wait(500 * time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if action := findPrecombatAction(t, env, recklessness); !action.Legal || !action.TriggersGCD {
+		t.Fatalf("Recklessness was not an admitted GCD self-buff: %+v", action)
+	}
+	if result, err := env.Apply(recklessness); err != nil || !result.Casted || !result.ConsumesDecision {
+		t.Fatalf("precombat Recklessness failed: result=%+v err=%v", result, err)
+	}
+	for env.sim.CurrentTime < time.Duration(precombatTestPullMS)*time.Millisecond {
+		if env.sim.Step() {
+			t.Fatal("simulator terminated before pull")
+		}
+	}
+	atPull := env.State()
+	if atPull.TimeMS != precombatTestPullMS || atPull.GCDRemainingMS != 1000 || atPull.NumTargets != 1 {
+		t.Fatalf("Recklessness GCD did not naturally cross pull: %+v", atPull)
+	}
+}
+
+func TestPrecombatDoesNotOpenHostileOrUndeclaredActions(t *testing.T) {
+	potion := ActionRef{ItemID: 13442}
+	bloodthirst := ActionRef{SpellID: 23894}
+	env := newPrecombatTestEnvironment(t, []ActionRef{potion}, true)
+	if findPrecombatAction(t, env, bloodthirst).Legal {
+		t.Fatal("Bloodthirst became legal without an attackable target")
+	}
+	if _, err := env.Apply(bloodthirst); err == nil || !strings.Contains(err.Error(), "unattackable") {
+		t.Fatalf("undeclared hostile action did not fail at the target gate: %v", err)
+	}
+
+	request := dynamicRequest(1_000_000)
+	request.Encounter.Duration = 5
+	config := boundDynamicV3Config(
+		t,
+		DynamicRetargetNextAliveCyclic,
+		5000,
+		[]float64{1_000_000},
+		nil,
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: precombatTestPullMS, TargetIndex: 0, Attackable: true},
+		},
+		nil,
+	)
+	invalid, _, err := NewDynamicV3(request, 872, config, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer invalid.Cleanup()
+	err = invalid.ConfigurePrecombatActionsV1(PrecombatActionsConfigV1{
+		Schema:      PrecombatActionsSchemaV1,
+		PullTimeMS:  precombatTestPullMS,
+		SelfActions: []ActionRef{bloodthirst},
+	})
+	if err == nil || !strings.Contains(err.Error(), "not marked") {
+		t.Fatalf("hostile action was admitted as a precombat self action: %v", err)
+	}
+}
+
+func TestPrecombatAllowsPlayerReachabilityAfterPull(t *testing.T) {
+	potion := ActionRef{ItemID: 13442}
+	request := dynamicRequest(1_000_000)
+	request.Encounter.Duration = 5
+	request.Raid.Parties[0].Players[0].Consumes = &proto.Consumes{
+		DefaultPotion: proto.Potions_MightyRagePotion,
+	}
+	config := boundDynamicV3Config(
+		t,
+		DynamicRetargetNextAliveCyclic,
+		5000,
+		[]float64{1_000_000},
+		nil,
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 2500, TargetIndex: 0, Attackable: true},
+		},
+		nil,
+	)
+	env, _, err := NewDynamicV3(request, 873, config, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer env.Cleanup()
+	if err := env.ConfigurePrecombatActionsV1(PrecombatActionsConfigV1{
+		Schema:      PrecombatActionsSchemaV1,
+		PullTimeMS:  precombatTestPullMS,
+		SelfActions: []ActionRef{potion},
+	}); err != nil {
+		t.Fatalf("post-pull reachability was rejected: %v", err)
+	}
+}
