+func newPrecombatTestEnvironmentAt(t *testing.T, actions []ActionRef, potion bool, pullMS int64) *Environment {
+	var consumes *proto.Consumes
+	if potion {
+		consumes = &proto.Consumes{DefaultPotion: proto.Potions_MightyRagePotion}
+	}
+	return newPrecombatTestEnvironmentWithConsumesAt(t, actions, consumes, pullMS)
