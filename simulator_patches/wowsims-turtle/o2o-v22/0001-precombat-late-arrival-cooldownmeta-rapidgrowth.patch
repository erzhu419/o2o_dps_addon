diff --git a/cmd/o2obridge/precombat_test.go b/cmd/o2obridge/precombat_test.go
new file mode 100644
index 000000000..c7fa6fdd6
--- /dev/null
+++ b/cmd/o2obridge/precombat_test.go
@@ -0,0 +1,113 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+	"github.com/isfir/wowsims-turtle/sim/o2o"
+	"google.golang.org/protobuf/encoding/protojson"
+)
+
+func TestRunBridgeLoadsPrecombatAtomicallyAndAcceptsPotion(t *testing.T) {
+	const health = 1_000_000.0
+	request := &proto.RaidSimRequest{}
+	if err := protojson.Unmarshal(bridgeDynamicTestRequest(t, health), request); err != nil {
+		t.Fatal(err)
+	}
+	request.Encounter.Duration = 5
+	request.Raid.Parties[0].Players[0].Consumes = &proto.Consumes{
+		DefaultPotion: proto.Potions_MightyRagePotion,
+	}
+	requestPayload, err := protojson.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dynamic := o2o.DynamicTargetSemanticsConfigV3{
+		Schema:                 o2o.DynamicTargetSemanticsSchemaV3,
+		TargetHealth:           []o2o.DynamicTargetHealthV1{{TargetIndex: 0, Health: health}},
+		BackgroundDamageEvents: []o2o.BackgroundDamageEventV1{},
+		AttackabilityEvents: []o2o.DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 1000, TargetIndex: 0, Attackable: true},
+		},
+		EffectiveArmorEvents: []o2o.DynamicEffectiveArmorEventV2{},
+		IdleAdvanceMode:      o2o.DynamicIdleAdvanceModeV3,
+		IdleAdvanceHorizonMS: 5000,
+		SameTimestampOrder:   o2o.DynamicSameTimestampOrderV3,
+		RetargetMode:         o2o.DynamicRetargetNextAliveCyclic,
+	}
+	dynamic.ContentSHA256, err = o2o.DynamicTargetSemanticsDigestV3(dynamic)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dynamicPayload, err := json.Marshal(dynamic)
+	if err != nil {
+		t.Fatal(err)
+	}
+	potion := o2o.ActionRef{ItemID: 13442}
+	precombatPayload, err := json.Marshal(o2o.PrecombatActionsConfigV1{
+		Schema:      o2o.PrecombatActionsSchemaV1,
+		PullTimeMS:  1000,
+		SelfActions: []o2o.ActionRef{potion},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	commands := []command{
+		{Command: "load_dynamic_v3_precombat", Request: requestPayload, Seed: 91, Dynamic: dynamicPayload, Precombat: precombatPayload},
+		{Command: "actions"},
+		{Command: "act", Action: potion},
+		{Command: "wait", WaitMS: 1000},
+		{Command: "advance"},
+		{Command: "close"},
+	}
+	var input bytes.Buffer
+	encoder := json.NewEncoder(&input)
+	for _, cmd := range commands {
+		if err := encoder.Encode(cmd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var output bytes.Buffer
+	var stderr bytes.Buffer
+	runBridge(&input, &output, &stderr)
+	if stderr.Len() != 0 {
+		t.Fatalf("bridge stderr: %s", stderr.String())
+	}
+	decoder := json.NewDecoder(&output)
+	responses := make([]response, 0, len(commands))
+	for decoder.More() {
+		var got response
+		if err := decoder.Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		responses = append(responses, got)
+	}
+	if len(responses) != len(commands) {
+		t.Fatalf("got %d responses, want %d: %s", len(responses), len(commands), output.String())
+	}
+	loaded := responses[0]
+	if !loaded.OK || loaded.State == nil || loaded.State.Precombat == nil ||
+		!loaded.State.Precombat.Active || loaded.State.Precombat.RelativeTimeMS != -1000 ||
+		loaded.State.NumTargets != 0 || !loaded.State.NeedsInput {
+		t.Fatalf("atomic precombat load is wrong: %+v", loaded)
+	}
+	foundPotion := false
+	for _, action := range responses[1].Actions {
+		if action.Action == potion {
+			foundPotion = action.Legal && !action.TriggersGCD
+		}
+	}
+	if !responses[1].OK || !foundPotion {
+		t.Fatalf("precombat potion was not advertised as legal: %+v", responses[1])
+	}
+	if !responses[2].OK || responses[2].Apply == nil || !responses[2].Apply.Casted || responses[2].Apply.ConsumesDecision {
+		t.Fatalf("precombat potion command was not accepted: %+v", responses[2])
+	}
+	if !responses[4].OK || responses[4].State == nil || responses[4].State.TimeMS != 1000 ||
+		responses[4].State.NumTargets != 1 || responses[4].State.Precombat == nil || responses[4].State.Precombat.Active {
+		t.Fatalf("bridge did not reach the pull boundary: %+v", responses[4])
+	}
+}
