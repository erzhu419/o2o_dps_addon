--- /dev/null
+++ b/cmd/o2obridge/press_clock_response_test.go
@@ -0,0 +1,56 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+)
+
+func TestRunBridgeOptInPressClockCommands(t *testing.T) {
+	commands := []command{
+		{Command: "load", Request: bridgeDynamicTestRequest(t, 1_000_000), Seed: 17},
+		{Command: "configure_press_clock", PressPeriodMS: 100, PressPhaseMS: 0},
+		{Command: "advance"},
+		{Command: "finish_press"},
+		{Command: "advance"},
+		{Command: "close"},
+	}
+	var input bytes.Buffer
+	for _, cmd := range commands {
+		if err := json.NewEncoder(&input).Encode(cmd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var output bytes.Buffer
+	var stderr bytes.Buffer
+	runBridge(&input, &output, &stderr)
+	if stderr.Len() != 0 {
+		t.Fatalf("bridge stderr: %s", stderr.String())
+	}
+	responses := make([]response, 0, len(commands))
+	decoder := json.NewDecoder(&output)
+	for decoder.More() {
+		var row response
+		if err := decoder.Decode(&row); err != nil {
+			t.Fatal(err)
+		}
+		responses = append(responses, row)
+	}
+	if len(responses) != len(commands) {
+		t.Fatalf("got %d bridge responses, want %d", len(responses), len(commands))
+	}
+	for index, row := range responses {
+		if !row.OK {
+			t.Fatalf("command %d failed: %s", index, row.Error)
+		}
+	}
+	if responses[0].State.PressClock != nil {
+		t.Fatal("default load unexpectedly enabled the press clock")
+	}
+	if clock := responses[2].State.PressClock; clock == nil || !clock.Ready || clock.PressIndex != 1 || responses[2].State.TimeMS != 0 {
+		t.Fatalf("first press receipt is missing: %+v", responses[2].State)
+	}
+	if clock := responses[4].State.PressClock; clock == nil || !clock.Ready || clock.PressIndex != 2 || responses[4].State.TimeMS != 100 {
+		t.Fatalf("second press receipt is missing: %+v", responses[4].State)
+	}
+}
