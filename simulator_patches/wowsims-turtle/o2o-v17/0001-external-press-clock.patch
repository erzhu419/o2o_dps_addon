+// ConfigurePressClock opts this environment into a fixed external key schedule.
+// Configure it before any policy action; the default interactive mode is unchanged.
+func (env *Environment) ConfigurePressClock(periodMS, phaseMS int64) error {
+	if env.finished || env.pressClock != nil {
+		return errors.New("press clock requires a live, unconfigured environment")
+	}
+	if env.dynamicV3 != nil || env.dynamicTeamResponse != nil {
+		return errors.New("press clock does not yet integrate dynamic idle or responsive team wakes")
+	}
+	if periodMS <= 0 || periodMS > 60_000 || phaseMS < 0 || phaseMS >= periodMS {
+		return errors.New("press clock requires period_ms in 1..60000 and phase_ms in 0..period_ms-1")
+	}
+	now := env.sim.CurrentTime.Milliseconds()
+	next := phaseMS
+	if next < now {
+		next += ((now - next + periodMS - 1) / periodMS) * periodMS
+	}
+	env.pressClock = &pressClockRuntime{
+		period:   time.Duration(periodMS) * time.Millisecond,
+		phaseMS:  phaseMS,
+		nextTime: time.Duration(next) * time.Millisecond,
+	}
+	env.schedulePress()
+	return nil
+}
+
+func (env *Environment) schedulePress() {
+	clock := env.pressClock
+	env.sim.AddPendingAction(&core.PendingAction{
+		NextActionAt: clock.nextTime,
+		Priority:     core.ActionPriorityLow,
+		OnAction: func(sim *core.Simulation) {
+			if env.finished {
+				return
+			}
+			clock.ready = true
+			clock.index++
+			sim.NeedsInput = true
+		},
+	})
+}
+
+// FinishPress closes exactly one physical-key opportunity, even if its only
+// accepted sink was a non-GCD swing queue. The next opportunity is a new tick.
+func (env *Environment) FinishPress() error {
+	if env.pressClock == nil || !env.pressClock.ready || env.finished {
+		return errors.New("no live press opportunity is ready")
+	}
+	clock := env.pressClock
+	clock.ready = false
+	clock.nextTime += clock.period
+	env.sim.NeedsInput = false
+	env.postGCDQueueReady = false
+	env.schedulePress()
+	return nil
+}
+
+func (env *Environment) inputOpportunityOpen() bool {
+	return env.sim.NeedsInput && (env.pressClock == nil || env.pressClock.ready)
+}
