index 0000000..22e825c
--- /dev/null
+++ b/sim/o2o/press_clock_test.go
@@ -0,0 +1,142 @@
+package o2o
+
+import "testing"
+
+func TestPressClockQueueAcceptanceDoesNotCreateSameTimeReentry(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	if env.State().PressClock != nil {
+		t.Fatal("default interactive mode unexpectedly has a press clock")
+	}
+	if err := env.ConfigurePressClock(100, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	first := env.State()
+	if first.TimeMS != 0 || first.PressClock == nil || !first.PressClock.Ready || first.PressClock.PressIndex != 1 {
+		t.Fatalf("first external press was not at time zero: %+v", first.PressClock)
+	}
+	_, queue := requireSpellAction(t, env, 1, 11567, 25286)
+	accepted, err := env.Apply(queue)
+	if err != nil || !accepted.Casted || accepted.ConsumesDecision || !accepted.NeedsInput {
+		t.Fatalf("next-swing queue was not accepted without consuming GCD: %+v, %v", accepted, err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err == nil {
+		t.Fatal("advance reused an unclosed physical key opportunity")
+	}
+	if err := env.FinishPress(); err != nil {
+		t.Fatal(err)
+	}
+	if env.State().NeedsInput || env.State().PressClock.Ready {
+		t.Fatal("finish_press left the old key opportunity open")
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	second := env.State()
+	if second.TimeMS != 100 || second.PressClock.PressIndex != 2 || !second.PressClock.Ready {
+		t.Fatalf("second press did not occur at the external 100 ms tick: %+v", second.PressClock)
+	}
+}
+
+func TestPressClockExposesGCDBusyPressWithoutGCDReadyReentry(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	if err := env.ConfigurePressClock(800, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	_, bloodthirst := requireSpellAction(t, env, 0, 23894)
+	cast, err := env.ApplyWithAttemptID(bloodthirst, "press-clock-bt")
+	if err != nil || !cast.Casted || !cast.ConsumesDecision {
+		t.Fatalf("initial Bloodthirst did not consume GCD: %+v, %v", cast, err)
+	}
+	if err := env.FinishPress(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	busy := env.State()
+	if busy.TimeMS != 800 || busy.GCDRemainingMS <= 0 || busy.PressClock == nil || !busy.PressClock.Ready {
+		t.Fatalf("GCD-busy external press was not exposed: time=%d gcd=%d clock=%+v", busy.TimeMS, busy.GCDRemainingMS, busy.PressClock)
+	}
+	rejected, err := env.ApplyWithAttemptID(bloodthirst, "press-clock-bt-rejected")
+	if err != nil || rejected.Casted || rejected.ConsumesDecision {
+		t.Fatalf("GCD-busy key did not get a typed spell rejection: %+v, %v", rejected, err)
+	}
+	if err := env.FinishPress(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	ready := env.State()
+	if ready.TimeMS != 1600 || ready.GCDRemainingMS != 0 || ready.PressClock.PressIndex != 3 {
+		t.Fatalf("GCD ready created an extra key opportunity before the next tick: time=%d gcd=%d clock=%+v", ready.TimeMS, ready.GCDRemainingMS, ready.PressClock)
+	}
+}
+
+func TestPressClockDoesNotAllowCommandsOutsideReadyPress(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	if err := env.ConfigurePressClock(100, 0); err != nil {
+		t.Fatal(err)
+	}
+	_, queue := requireSpellAction(t, env, 1, 11567, 25286)
+	if result, err := env.Apply(queue); err == nil || result.Casted {
+		t.Fatalf("queue was accepted outside a press: %+v, %v", result, err)
+	}
+	if err := env.Wait(100); err == nil {
+		t.Fatal("legacy WAIT bypassed the external press clock")
+	}
+}
+
+func TestPressClockBusyGCDUsesNativeOnSwingQueueAcceptance(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	if err := env.ConfigurePressClock(800, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	_, bloodthirst := requireSpellAction(t, env, 0, 23894)
+	cast, err := env.ApplyWithAttemptID(bloodthirst, "press-clock-queue-bt")
+	if err != nil || !cast.Casted || !cast.ConsumesDecision {
+		t.Fatalf("initial GCD was not accepted: %+v, %v", cast, err)
+	}
+	if err := env.FinishPress(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if env.State().TimeMS != 800 || env.State().GCDRemainingMS <= 0 {
+		t.Fatal("separate on-swing queue press did not occur during the GCD")
+	}
+	var queue ActionRef
+	var nativeLegal bool
+	for _, action := range env.AvailableActions() {
+		if action.Action.Tag == 1 && (action.Action.SpellID == 11567 || action.Action.SpellID == 25286) {
+			queue, nativeLegal = action.Action, action.Legal
+			break
+		}
+	}
+	if queue.SpellID == 0 {
+		t.Fatal("on-swing queue was absent from the native spellbook")
+	}
+	result, err := env.Apply(queue)
+	if err != nil || result.Casted != nativeLegal || result.ConsumesDecision || !result.NeedsInput {
+		t.Fatalf("press clock bypassed native queue legality: legal=%t result=%+v err=%v", nativeLegal, result, err)
+	}
+	if err := env.FinishPress(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.Apply(queue); err == nil {
+		t.Fatal("queue was resubmitted at the same millisecond after finish_press")
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil || env.State().TimeMS != 1600 {
+		t.Fatalf("next queue opportunity was not the next external tick: time=%d err=%v", env.State().TimeMS, err)
+	}
+}
