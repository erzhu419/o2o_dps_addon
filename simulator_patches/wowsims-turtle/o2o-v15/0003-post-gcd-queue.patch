@@ -0,0 +1,78 @@
+package o2o
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestPostGCDQueueAfterWhirlwindPreservesSourceOrder(t *testing.T) {
+	request := testWarriorRequest()
+	second := *request.Encounter.Targets[0]
+	second.Stats = append([]float64(nil), second.Stats...)
+	request.Encounter.Targets = append(request.Encounter.Targets, &second)
+	env := newTestWarriorEnvironment(t, request)
+	_, whirlwind := requireSpellAction(t, env, 0, 1680)
+	_, cleave := requireSpellAction(t, env, 1, 20569)
+	before := env.State().TimeMS
+
+	gcd, err := env.ApplyWithAttemptID(whirlwind, "ww-then-cleave")
+	if err != nil || !gcd.Casted || !gcd.ConsumesDecision || gcd.NeedsInput {
+		t.Fatalf("Whirlwind did not consume the decision: result=%+v err=%v", gcd, err)
+	}
+	queued, err := env.ApplyPostGCDQueue(cleave)
+	if err != nil || !queued.Casted || queued.ConsumesDecision || queued.NeedsInput {
+		t.Fatalf("post-GCD Cleave queue was not accepted: result=%+v err=%v", queued, err)
+	}
+	if env.State().TimeMS != before {
+		t.Fatalf("post-GCD queue advanced time: %d -> %d", before, env.State().TimeMS)
+	}
+	if _, err := env.ApplyPostGCDQueue(cleave); err == nil {
+		t.Fatal("second post-GCD queue reused the same GCD window")
+	}
+}
+
+func TestPostGCDQueueRejectsMissingOrAdvancedGCDWindow(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	_, whirlwind := requireSpellAction(t, env, 0, 1680)
+	_, cleave := requireSpellAction(t, env, 1, 20569)
+	if _, err := env.ApplyPostGCDQueue(cleave); err == nil {
+		t.Fatal("queue without preceding GCD was accepted")
+	}
+	if result, err := env.ApplyWithAttemptID(whirlwind, "ww-before-advance"); err != nil || !result.ConsumesDecision {
+		t.Fatalf("Whirlwind did not consume the decision: result=%+v err=%v", result, err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.ApplyPostGCDQueue(cleave); err == nil {
+		t.Fatal("queue after advance reused the old GCD window")
+	}
+}
+
+func TestPostGCDQueueRejectsNonQueueAndInsufficientRage(t *testing.T) {
+	env := newTestWarriorEnvironment(t, testWarriorRequest())
+	_, whirlwind := requireSpellAction(t, env, 0, 1680)
+	_, cleave := requireSpellAction(t, env, 1, 20569)
+	if result, err := env.ApplyWithAttemptID(whirlwind, "ww-before-wrong-action"); err != nil || !result.ConsumesDecision {
+		t.Fatalf("Whirlwind did not consume the decision: result=%+v err=%v", result, err)
+	}
+	if _, err := env.ApplyPostGCDQueue(whirlwind); err == nil || !strings.Contains(err.Error(), "Heroic Strike or Cleave queue") {
+		t.Fatalf("normal GCD action was not rejected: %v", err)
+	}
+	if _, err := env.ApplyPostGCDQueue(cleave); err == nil {
+		t.Fatal("invalid post-GCD action did not close the window")
+	}
+
+	request := testWarriorRequest()
+	request.Raid.Parties[0].Players[0].GetWarrior().Options.StartingRage = 40
+	lowRage := newTestWarriorEnvironment(t, request)
+	_, whirlwind = requireSpellAction(t, lowRage, 0, 1680)
+	_, cleave = requireSpellAction(t, lowRage, 1, 20569)
+	if result, err := lowRage.ApplyWithAttemptID(whirlwind, "ww-low-rage"); err != nil || !result.ConsumesDecision {
+		t.Fatalf("low-rage Whirlwind did not consume the decision: result=%+v err=%v", result, err)
+	}
+	result, err := lowRage.ApplyPostGCDQueue(cleave)
+	if err != nil || result.Casted || result.ConsumesDecision || result.NeedsInput {
+		t.Fatalf("insufficient-rage queue was not rejected as an action: result=%+v err=%v", result, err)
+	}
+}
