+// ApplyPostGCDQueue models one next-swing queue attempt immediately after a
+// consuming GCD in the same source invocation. This is a simulator assumption,
+// not evidence that a WoW client accepted the post-GCD CastSpellByName call.
+func (env *Environment) ApplyPostGCDQueue(ref ActionRef) (ApplyResult, error) {
+	if env.finished || !env.postGCDQueueReady || env.sim.NeedsInput || env.sim.CurrentTime != env.postGCDQueueTime {
+		return ApplyResult{}, errors.New("post-GCD queue requires the preceding unadvanced GCD decision")
+	}
+	env.postGCDQueueReady = false
+	if ref.Tag != 1 || ref.ItemID != 0 || ref.OtherID != proto.OtherAction_OtherActionNone ||
+		(ref.SpellID != 25286 && ref.SpellID != 11567 && ref.SpellID != 20569) {
+		return ApplyResult{}, errors.New("post-GCD action must be Heroic Strike or Cleave queue")
+	}
+	character := env.player().GetCharacter()
+	spell := character.GetSpell(ref.coreID())
+	if spell == nil || !spell.Flags.Matches(core.SpellFlagAPL) || !spell.Flags.Matches(core.SpellFlagCastTimeNoGCD) {
+		return ApplyResult{}, errors.New("post-GCD queue action is absent or not externally triggerable")
+	}
+	if env.dynamic != nil && (character.CurrentTarget == nil || !env.sim.Encounter.DynamicTargetUnitIsAttackable(character.CurrentTarget)) {
+		return ApplyResult{NeedsInput: false}, nil
+	}
+	if !spell.CanCast(env.sim, character.CurrentTarget) {
+		return ApplyResult{NeedsInput: false}, nil
+	}
+	casted := spell.Cast(env.sim, character.CurrentTarget)
+	return ApplyResult{Casted: casted, ConsumesDecision: false, Finished: env.finished, NeedsInput: false}, nil
+}
