@@ -0,0 +1,84 @@
+package o2o
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+)
+
+func checkpointFloat(value float64) *float64 { return &value }
+func checkpointInt(value int64) *int64       { return &value }
+
+func testPlayerCheckpointV1(dual bool) PlayerStateCheckpointV1 {
+	checkpoint := PlayerStateCheckpointV1{
+		Schema:                PlayerCheckpointSchemaV1,
+		RageCurrent:           checkpointFloat(47),
+		Stance:                "BATTLE",
+		GCDRemainingMS:        checkpointInt(700),
+		Cooldowns:             []CooldownCheckpointV1{},
+		MHSwingRemainingMS:    checkpointInt(350),
+		QueuedNextSwing:       "NONE",
+		SelfAurasAndProcs:     []AuraCheckpointV1{},
+		CandidateOwnedDebuffs: []AuraCheckpointV1{},
+	}
+	if dual {
+		checkpoint.OHSwingRemainingMS = checkpointInt(650)
+	}
+	return checkpoint
+}
+
+func TestPlayerCheckpointRestoresBeforeFirstEvent(t *testing.T) {
+	config := boundDynamicV4Config(t, DynamicRetargetNextAliveCyclic, 3000, []float64{1_000_000}, []float64{500_000}, nil)
+	request := dynamicRequest(1_000_000)
+	request.Encounter.Duration = 3
+	base, _, err := NewDynamicV4(request, 101, config, 5)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dual := base.player().GetCharacter().AutoAttacks.IsDualWielding
+	base.Cleanup()
+	checkpoint := testPlayerCheckpointV1(dual)
+	checkpoint.Cooldowns = []CooldownCheckpointV1{{Action: ActionRef{SpellID: 23894}, RemainingMS: 800}}
+	env, _, err := NewDynamicV5(request, 101, config, checkpoint, 5)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(env.Cleanup)
+	character := env.player().GetCharacter()
+	if character.CurrentRage() != 47 || character.GCD.TimeToReady(env.sim) != 700*time.Millisecond ||
+		character.AutoAttacks.NextMHSwingAt() != 350*time.Millisecond ||
+		character.GetSpell(core.ActionID{SpellID: 23894}).CD.Timer.TimeToReady(env.sim) != 800*time.Millisecond {
+		t.Fatalf("pre-event player checkpoint not restored: %+v", env.State())
+	}
+	if dual && character.AutoAttacks.NextOHSwingAt() != 650*time.Millisecond {
+		t.Fatalf("off-hand deadline = %s", character.AutoAttacks.NextOHSwingAt())
+	}
+	if !character.GetAuraByID(core.ActionID{SpellID: 2457}).IsActive() || character.GetAuraByID(core.ActionID{SpellID: 2458}).IsActive() {
+		t.Fatal("stance aura not restored")
+	}
+	state := env.State()
+	if state.Power.Current != 47 || state.GCDRemainingMS != 700 || state.MHSwingRemainingMS != 350 || state.TargetHealth != 500_000 {
+		t.Fatalf("bridge-visible checkpoint changed before first decision: %+v", state)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	if env.State().TimeMS < 700 {
+		t.Fatalf("advance stopped before restored GCD: %+v", env.State())
+	}
+}
+
+func TestPlayerCheckpointRejectsNonrestorableState(t *testing.T) {
+	checkpoint := testPlayerCheckpointV1(false)
+	checkpoint.QueuedNextSwing = "HEROIC_STRIKE"
+	if err := validatePlayerCheckpointV1(checkpoint, false); err == nil || !strings.Contains(err.Error(), "queued next-swing") {
+		t.Fatalf("queue must reject: %v", err)
+	}
+	checkpoint.QueuedNextSwing = "NONE"
+	checkpoint.SelfAurasAndProcs = []AuraCheckpointV1{{Action: ActionRef{SpellID: 12970}, Stacks: 3, RemainingMS: 5000}}
+	if err := validatePlayerCheckpointV1(checkpoint, false); err == nil || !strings.Contains(err.Error(), "not restorable") {
+		t.Fatalf("proc aura must reject: %v", err)
+	}
+}
diff --git a/sim/warrior/warrior.go b/sim/warrior/warrior.go
index 34a1b64..2a5d71f 100644
--- a/sim/warrior/warrior.go
+++ b/sim/warrior/warrior.go
@@ -229,6 +229,35 @@ func (warrior *Warrior) Reset(sim *core.Simulation) {
 	}
 }
 
+// RestoreO2OStanceCheckpoint applies stance aura side effects without a
+// player cast, rage loss, or an artificial stance cooldown.
+func (warrior *Warrior) RestoreO2OStanceCheckpoint(sim *core.Simulation, stance string) bool {
+	var next Stance
+	var aura *core.Aura
+	switch stance {
+	case "BATTLE":
+		next, aura = BattleStance, warrior.BattleStanceAura
+	case "DEFENSIVE":
+		next, aura = DefensiveStance, warrior.DefensiveStanceAura
+	case "BERSERKER":
+		next, aura = BerserkerStance, warrior.BerserkerStanceAura
+	default:
+		return false
+	}
+	if warrior.Stance == next {
+		return true
+	}
+	for _, existing := range []*core.Aura{warrior.BattleStanceAura, warrior.DefensiveStanceAura, warrior.BerserkerStanceAura} {
+		if existing.IsActive() {
+			existing.Deactivate(sim)
+		}
+	}
+	warrior.PreviousStance = warrior.Stance
+	warrior.Stance = next
+	aura.Activate(sim)
+	return aura.IsActive()
+}
+
 func NewWarrior(character *core.Character, talents string, inputs WarriorInputs) *Warrior {
 	warrior := &Warrior{
 		Character:     *character,
