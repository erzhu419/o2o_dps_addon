diff --git a/sim/o2o/player_checkpoint_v1.go b/sim/o2o/player_checkpoint_v1.go
new file mode 100644
index 0000000..1af55c6
--- /dev/null
+++ b/sim/o2o/player_checkpoint_v1.go
@@ -0,0 +1,136 @@
+package o2o
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"time"
+
+	"github.com/isfir/wowsims-turtle/sim/core"
+	"github.com/isfir/wowsims-turtle/sim/core/proto"
+	"github.com/isfir/wowsims-turtle/sim/warrior"
+)
+
+const PlayerCheckpointSchemaV1 = "o2o_player_state_checkpoint/v1"
+
+// PlayerStateCheckpointV1 is a pre-first-event restoration, not a generic
+// simulator snapshot. Aura/proc/debuff replay is not implemented here, so a
+// nonempty observed set is rejected instead of being silently discarded.
+type PlayerStateCheckpointV1 struct {
+	Schema                string                 `json:"schema"`
+	RageCurrent           *float64               `json:"rage_current"`
+	Stance                string                 `json:"stance"`
+	GCDRemainingMS        *int64                 `json:"gcd_remaining_ms"`
+	Cooldowns             []CooldownCheckpointV1 `json:"cooldowns"`
+	MHSwingRemainingMS    *int64                 `json:"mh_swing_remaining_ms"`
+	OHSwingRemainingMS    *int64                 `json:"oh_swing_remaining_ms"`
+	QueuedNextSwing       string                 `json:"queued_next_swing"`
+	SelfAurasAndProcs     []AuraCheckpointV1     `json:"self_auras_and_procs"`
+	CandidateOwnedDebuffs []AuraCheckpointV1     `json:"candidate_owned_debuffs"`
+}
+
+type CooldownCheckpointV1 struct {
+	Action      ActionRef `json:"action"`
+	RemainingMS int64     `json:"remaining_ms"`
+}
+
+type AuraCheckpointV1 struct {
+	Action      ActionRef `json:"action"`
+	Stacks      int32     `json:"stacks"`
+	RemainingMS int64     `json:"remaining_ms"`
+}
+
+func validatePlayerCheckpointV1(checkpoint PlayerStateCheckpointV1, dualWield bool) error {
+	if checkpoint.Schema != PlayerCheckpointSchemaV1 {
+		return fmt.Errorf("player checkpoint schema must be %q", PlayerCheckpointSchemaV1)
+	}
+	if checkpoint.RageCurrent == nil || math.IsNaN(*checkpoint.RageCurrent) || math.IsInf(*checkpoint.RageCurrent, 0) || *checkpoint.RageCurrent < 0 || *checkpoint.RageCurrent > 100 {
+		return errors.New("rage_current must be an exact value in [0,100]")
+	}
+	if checkpoint.Stance != "BATTLE" && checkpoint.Stance != "DEFENSIVE" && checkpoint.Stance != "BERSERKER" {
+		return errors.New("stance must be BATTLE, DEFENSIVE, or BERSERKER")
+	}
+	if checkpoint.GCDRemainingMS == nil || checkpoint.MHSwingRemainingMS == nil ||
+		!validCheckpointDuration(*checkpoint.GCDRemainingMS) || !validCheckpointDuration(*checkpoint.MHSwingRemainingMS) {
+		return errors.New("GCD and main-hand swing remaining milliseconds must be nonnegative and at most 24 hours")
+	}
+	if dualWield != (checkpoint.OHSwingRemainingMS != nil) {
+		return errors.New("off-hand swing must be present exactly for dual-wielding characters")
+	}
+	if dualWield && !validCheckpointDuration(*checkpoint.OHSwingRemainingMS) {
+		return errors.New("off-hand swing remaining milliseconds must be nonnegative and at most 24 hours")
+	}
+	if checkpoint.Cooldowns == nil {
+		return errors.New("cooldowns must be an explicit complete list (possibly empty)")
+	}
+	for _, cooldown := range checkpoint.Cooldowns {
+		if !validCheckpointDuration(cooldown.RemainingMS) || cooldown.Action.coreID().IsEmptyAction() {
+			return errors.New("cooldown action and remaining milliseconds are invalid")
+		}
+	}
+	if checkpoint.QueuedNextSwing != "NONE" {
+		return errors.New("queued next-swing state is not restorable in player checkpoint v1")
+	}
+	if checkpoint.SelfAurasAndProcs == nil || checkpoint.CandidateOwnedDebuffs == nil {
+		return errors.New("aura and owned-debuff lists must be explicit complete lists")
+	}
+	if len(checkpoint.SelfAurasAndProcs) != 0 || len(checkpoint.CandidateOwnedDebuffs) != 0 {
+		return errors.New("active self aura/proc or owned debuff is not restorable in player checkpoint v1")
+	}
+	return nil
+}
+
+func validCheckpointDuration(ms int64) bool {
+	return ms >= 0 && ms <= 24*60*60*1000
+}
+
+// NewDynamicV5 retains v4 target semantics and adds an exact, currently
+// supported player-state restoration before any simulated combat event.
+func NewDynamicV5(request *proto.RaidSimRequest, seed int64, config DynamicTargetSemanticsConfigV4, checkpoint PlayerStateCheckpointV1, generation uint64) (*Environment, DynamicLoadReceiptV1, error) {
+	env, receipt, err := NewDynamicV4(request, seed, config, generation)
+	if err != nil {
+		return nil, receipt, err
+	}
+	if err = env.restorePlayerCheckpointV1(checkpoint); err != nil {
+		env.Cleanup()
+		return nil, DynamicLoadReceiptV1{}, err
+	}
+	return env, receipt, nil
+}
+
+func (env *Environment) restorePlayerCheckpointV1(checkpoint PlayerStateCheckpointV1) error {
+	if env.sim.CurrentTime != 0 {
+		return errors.New("player checkpoint requires no pre-pull simulation actions")
+	}
+	character := env.player().GetCharacter()
+	warriorAgent, ok := env.player().(interface{ GetWarrior() *warrior.Warrior })
+	if !ok || !character.HasRageBar() || !character.AutoAttacks.AutoSwingMelee {
+		return errors.New("player checkpoint v1 requires an auto-attacking Warrior")
+	}
+	if err := validatePlayerCheckpointV1(checkpoint, character.AutoAttacks.IsDualWielding); err != nil {
+		return err
+	}
+	seen := make(map[core.ActionID]bool, len(checkpoint.Cooldowns))
+	for _, cooldown := range checkpoint.Cooldowns {
+		id := cooldown.Action.coreID()
+		spell := character.GetSpell(id)
+		if spell == nil || spell.CD.Timer == nil || seen[id] {
+			return fmt.Errorf("checkpoint cooldown %s is unknown, has no own timer, or is repeated", id)
+		}
+		seen[id] = true
+	}
+	if !warriorAgent.GetWarrior().RestoreO2OStanceCheckpoint(env.sim, checkpoint.Stance) {
+		return errors.New("checkpoint stance could not be activated")
+	}
+	character.RestoreRageCheckpoint(*checkpoint.RageCurrent)
+	character.SetGCDTimer(env.sim, time.Duration(*checkpoint.GCDRemainingMS)*time.Millisecond)
+	for _, cooldown := range checkpoint.Cooldowns {
+		character.GetSpell(cooldown.Action.coreID()).CD.Timer.Set(time.Duration(cooldown.RemainingMS) * time.Millisecond)
+	}
+	oh := time.Duration(0)
+	if checkpoint.OHSwingRemainingMS != nil {
+		oh = time.Duration(*checkpoint.OHSwingRemainingMS) * time.Millisecond
+	}
+	character.AutoAttacks.RestoreMeleeSwingCheckpoint(time.Duration(*checkpoint.MHSwingRemainingMS)*time.Millisecond, oh)
+	return nil
+}
