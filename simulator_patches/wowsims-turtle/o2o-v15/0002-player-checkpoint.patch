@@ -0,0 +1,86 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/isfir/wowsims-turtle/sim/o2o"
+)
+
+func TestBridgeV5ReturnsPreEventPlayerCheckpointAndRejectsQueue(t *testing.T) {
+	const maximum = 1_000_000.0
+	config := o2o.DynamicTargetSemanticsConfigV4{
+		Schema:                 o2o.DynamicTargetSemanticsSchemaV4,
+		TargetHealth:           []o2o.DynamicTargetHealthV4{{TargetIndex: 0, MaximumHealth: maximum, CurrentHealth: 500_000}},
+		BackgroundDamageEvents: []o2o.BackgroundDamageEventV1{},
+		AttackabilityEvents:    []o2o.DynamicAttackabilityEventV2{},
+		EffectiveArmorEvents:   []o2o.DynamicEffectiveArmorEventV2{},
+		IdleAdvanceMode:        o2o.DynamicIdleAdvanceModeV3,
+		IdleAdvanceHorizonMS:   300_000,
+		SameTimestampOrder:     o2o.DynamicSameTimestampOrderV4,
+		RetargetMode:           o2o.DynamicRetargetNextAliveCyclic,
+	}
+	digest, err := o2o.DynamicTargetSemanticsDigestV4(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.ContentSHA256 = digest
+	dynamic, _ := json.Marshal(config)
+	rage := 47.0
+	gcd, mh, oh := int64(700), int64(350), int64(650)
+	checkpoint := o2o.PlayerStateCheckpointV1{
+		Schema:                o2o.PlayerCheckpointSchemaV1,
+		RageCurrent:           &rage,
+		Stance:                "BATTLE",
+		GCDRemainingMS:        &gcd,
+		Cooldowns:             []o2o.CooldownCheckpointV1{},
+		MHSwingRemainingMS:    &mh,
+		OHSwingRemainingMS:    &oh,
+		QueuedNextSwing:       "NONE",
+		SelfAurasAndProcs:     []o2o.AuraCheckpointV1{},
+		CandidateOwnedDebuffs: []o2o.AuraCheckpointV1{},
+	}
+	playerState, _ := json.Marshal(checkpoint)
+	checkpoint.QueuedNextSwing = "HEROIC_STRIKE"
+	invalidState, _ := json.Marshal(checkpoint)
+	commands := []command{
+		{Command: "load_dynamic_v5", Request: bridgeDynamicTestRequest(t, maximum), Seed: 77, Dynamic: dynamic, PlayerState: playerState},
+		{Command: "advance"},
+		{Command: "load_dynamic_v5", Request: bridgeDynamicTestRequest(t, maximum), Seed: 77, Dynamic: dynamic, PlayerState: invalidState},
+	}
+	var input bytes.Buffer
+	encoder := json.NewEncoder(&input)
+	for _, cmd := range commands {
+		if err := encoder.Encode(cmd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var output bytes.Buffer
+	runBridge(&input, &output, &bytes.Buffer{})
+	decoder := json.NewDecoder(&output)
+	var results []response
+	for decoder.More() {
+		var result response
+		if err := decoder.Decode(&result); err != nil {
+			t.Fatal(err)
+		}
+		results = append(results, result)
+	}
+	if len(results) != 3 {
+		t.Fatalf("got %d responses", len(results))
+	}
+	load := results[0]
+	if !load.OK || load.DynamicLoad == nil || load.State == nil || load.State.TimeMS != 0 ||
+		load.State.Power.Current != rage || load.State.GCDRemainingMS != gcd ||
+		load.State.MHSwingRemainingMS != mh || load.State.TargetHealth != 500_000 {
+		t.Fatalf("v5 load did not expose pre-event checkpoint: %+v", load)
+	}
+	if !results[1].OK || results[1].State == nil || results[1].State.TimeMS < gcd {
+		t.Fatalf("advance did not process restored timers: %+v", results[1])
+	}
+	if results[2].OK || !strings.Contains(results[2].Error, "queued next-swing") {
+		t.Fatalf("nonrestorable queue was accepted: %+v", results[2])
+	}
+}
