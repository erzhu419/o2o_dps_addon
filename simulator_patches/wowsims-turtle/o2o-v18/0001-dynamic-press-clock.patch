+func TestPressClockResponsiveWakeIsInternalBeforeSameTimePress(t *testing.T) {
+	config := boundDynamicV4Config(t, DynamicRetargetNextAliveCyclic, 300,
+		[]float64{1000}, []float64{1000},
+		[]BackgroundDamageEventV1{{ScheduleIndex: 0, TimeMS: 100, TargetIndex: 0, EventID: "fixed", Damage: 5}})
+	env := newDynamicV4TestEnvironment(t, config)
+	env.player().GetCharacter().AutoAttacks.CancelAutoSwing(env.sim)
+	if err := env.ConfigurePressClock(100, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	digest := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	if _, err := env.ArmDynamicTeamWakeV1(DynamicTeamWakeRequestV1{
+		Schema: DynamicTeamWakeSchemaV1, ModelContentSHA256: digest, WakeID: "wake", TimeMS: 100,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := env.FinishPress(); err != nil {
+		t.Fatal(err)
+	}
+	finished, err := env.AdvanceUntilDecision()
+	wake := env.State()
+	if err != nil || finished || wake.TimeMS != 100 || wake.WakeReady == nil || wake.NeedsInput ||
+		wake.PressClock.Ready || wake.PressClock.PressIndex != 1 || wake.DynamicTeamBackground.BackgroundDamageApplied != 5 {
+		t.Fatalf("responsive wake created a policy key or preceded fixed damage: finished=%t state=%+v err=%v", finished, wake, err)
+	}
+	if _, err := env.StartAttack(); err == nil {
+		t.Fatal("policy control was accepted at an internal responsive wake")
+	}
+	target := int32(0)
+	if _, err := env.EmitDynamicTeamEventV1(DynamicTeamEventRequestV1{
+		Schema: DynamicTeamEventSchemaV1, ModelContentSHA256: digest, WakeID: "wake",
+		EventID: "event", ActorGUID: "0xF100000001", EventType: "DMG", TargetIndex: &target, RequestedDamage: 10,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	finished, err = env.AdvanceUntilDecision()
+	press := env.State()
+	if err != nil || finished || press.TimeMS != 100 || !press.NeedsInput ||
+		!press.PressClock.Ready || press.PressClock.PressIndex != 2 || press.DynamicTeamBackground.BackgroundDamageApplied != 15 {
+		t.Fatalf("same-time press did not follow responsive event exactly once: finished=%t state=%+v err=%v", finished, press, err)
+	}
+}
