+func TestPressClockDynamicV3KeepsTicksAcrossUnattackableWindow(t *testing.T) {
+	config := boundDynamicV3Config(t, DynamicRetargetRequireExplicit, 200,
+		[]float64{1000},
+		[]BackgroundDamageEventV1{
+			{ScheduleIndex: 0, TimeMS: 25, TargetIndex: 0, EventID: "blocked", Damage: 100},
+			{ScheduleIndex: 1, TimeMS: 100, TargetIndex: 0, EventID: "restored", Damage: 50},
+		},
+		[]DynamicAttackabilityEventV2{
+			{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false},
+			{ScheduleIndex: 1, TimeMS: 100, TargetIndex: 0, Attackable: true},
+		}, nil)
+	env := newDynamicV3TestEnvironment(t, config, 1001)
+	env.player().GetCharacter().AutoAttacks.CancelAutoSwing(env.sim)
+	if err := env.ConfigurePressClock(50, 0); err != nil {
+		t.Fatal(err)
+	}
+	for index, at := range []int64{0, 50, 100} {
+		finished, err := env.AdvanceUntilDecision()
+		if err != nil || finished {
+			t.Fatalf("press %d did not arrive: finished=%t err=%v", index+1, finished, err)
+		}
+		state := env.State()
+		if state.TimeMS != at || !state.NeedsInput || state.PressClock == nil ||
+			!state.PressClock.Ready || state.PressClock.PressIndex != int64(index+1) {
+			t.Fatalf("physical tick shifted or suppressed: %+v", state)
+		}
+		if index < 2 && state.NumTargets != 0 {
+			t.Fatalf("unattackable target appeared before transition: %+v", state)
+		}
+		if index == 2 && (state.NumTargets != 1 || state.DynamicTeamBackground.BackgroundDamageApplied != 50) {
+			t.Fatalf("same-time environment effects did not precede key: %+v", state)
+		}
+		if err := env.FinishPress(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	idle, err := env.DynamicIdleAdvanceReceiptsV3(0)
+	if err != nil || len(idle.Receipts) != 0 {
+		t.Fatalf("press mode incorrectly entered no-policy auto-idle: batch=%+v err=%v", idle, err)
+	}
+	background, err := env.DynamicDamageReceiptsV1(0)
+	if err != nil || len(background.Receipts) != 2 ||
+		background.Receipts[0].Status != DynamicDamageCanceledTargetUnattackable ||
+		background.Receipts[1].Status != DynamicDamageApplied {
+		t.Fatalf("background did not follow attackability order: batch=%+v err=%v", background, err)
+	}
+}
