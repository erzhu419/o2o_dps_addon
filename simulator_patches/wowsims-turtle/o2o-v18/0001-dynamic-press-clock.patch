+func TestPressClockDynamicV3TerminatesDuringUnattackableInterval(t *testing.T) {
+	config := boundDynamicV3Config(t, DynamicRetargetNextAliveCyclic, 150,
+		[]float64{1000}, nil,
+		[]DynamicAttackabilityEventV2{{ScheduleIndex: 0, TimeMS: 0, TargetIndex: 0, Attackable: false}}, nil)
+	env := newDynamicV3TestEnvironment(t, config, 1002)
+	env.player().GetCharacter().AutoAttacks.CancelAutoSwing(env.sim)
+	if err := env.ConfigurePressClock(100, 0); err != nil {
+		t.Fatal(err)
+	}
+	for _, at := range []int64{0, 100} {
+		finished, err := env.AdvanceUntilDecision()
+		if err != nil || finished || env.State().TimeMS != at || !env.State().PressClock.Ready {
+			t.Fatalf("missing no-target physical tick %d: finished=%t state=%+v err=%v", at, finished, env.State(), err)
+		}
+		if err := env.FinishPress(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	finished, err := env.AdvanceUntilDecision()
+	state := env.State()
+	if err != nil || !finished || !state.Finished || state.NeedsInput || state.TimeMS != 150 || state.PressClock.Ready {
+		t.Fatalf("horizon did not terminate before the next physical tick: finished=%t state=%+v err=%v", finished, state, err)
+	}
+}
