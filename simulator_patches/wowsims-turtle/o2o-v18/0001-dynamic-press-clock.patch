+func TestPressClockOffGridResponsiveWakeDoesNotShiftNextPress(t *testing.T) {
+	config := boundDynamicV3Config(t, DynamicRetargetNextAliveCyclic, 200,
+		[]float64{1000}, nil, nil, nil)
+	env := newDynamicV3TestEnvironment(t, config, 1003)
+	env.player().GetCharacter().AutoAttacks.CancelAutoSwing(env.sim)
+	if err := env.ConfigurePressClock(100, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	digest := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+	if _, err := env.ArmDynamicTeamWakeV1(DynamicTeamWakeRequestV1{
+		Schema: DynamicTeamWakeSchemaV1, ModelContentSHA256: digest, WakeID: "off-grid", TimeMS: 50,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := env.FinishPress(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	wake := env.State()
+	if wake.TimeMS != 50 || wake.WakeReady == nil || wake.NeedsInput || wake.PressClock.Ready || wake.PressClock.PressIndex != 1 {
+		t.Fatalf("off-grid wake became an external key: %+v", wake)
+	}
+	if _, err := env.EmitDynamicTeamEventV1(DynamicTeamEventRequestV1{
+		Schema: DynamicTeamEventSchemaV1, ModelContentSHA256: digest, WakeID: "off-grid",
+		EventID: "off-grid-event", ActorGUID: "0xF100000001", EventType: "START",
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.AdvanceUntilDecision(); err != nil {
+		t.Fatal(err)
+	}
+	press := env.State()
+	if press.TimeMS != 100 || !press.NeedsInput || !press.PressClock.Ready || press.PressClock.PressIndex != 2 {
+		t.Fatalf("internal wake shifted the fixed next key: %+v", press)
+	}
+}
