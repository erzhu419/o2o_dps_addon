      "claim": "The package default profile is empty and no captured Cat2CharacterDB policy is part of this manifest; capabilities alone are not an expert policy."
    },
    {
      "id": "BOOLEAN_NOT_ACCEPTANCE",
      "claim": "Execute true controls traversal only; Cat2.Cast has no return value and may suppress its downstream sink while a channel is active."
    },
    {
      "id": "NEARBY_SCAN_IS_CACHED",
      "claim": "Nearby-enemy capabilities depend on the SuperWoW object cache and return zero without SuperWoW; they are not an exact full-scene oracle."
    },
    {
      "id": "FRONT_FILTER_REQUIRES_UNITXP",
      "claim": "The front-only cleave passive additionally requires UnitXP behind checks; absent support yields zero eligible front targets."
    },
    {
      "id": "BOSS_GATE_USES_CURRENT_HEALTH",
      "claim": "The effective later IsBossTarget definition uses cached classification, current target health greater than 280000, or two hard-coded names; targetHealth is UnitHealth rather than UnitHealthMax."
    },
    {
      "id": "NEARBY_EXECUTE_ORDER_UNSPECIFIED",
      "claim": "ExecuteNearbyTarget iterates a Lua table with pairs, so target and sink order is not stable across executions."
    },
    {
      "id": "ACTIVE_ERRORS_CONTINUE",
      "claim": "An active card error increments failure counts and traversal continues; passive Apply or Validate failure stops the pass."
    },
    {
      "id": "DIRECT_CARD_STEP_OMITTED",
      "claim": "ExecuteCardById invokes a target card without its step; no current Warrior card calls it, but option-dependent direct execution is not safe."
    },
    {
      "id": "SAVEDVARIABLES_SCHEMA_IS_NOT_SEMANTIC_IDENTITY",
      "claim": "Schema version 1 can restore old card IDs, but changed source semantics require a new profile snapshot and new evidence identity."
