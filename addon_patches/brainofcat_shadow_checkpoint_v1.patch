diff --git a/addon/ShadowCheckpoint.lua b/addon/ShadowCheckpoint.lua
new file mode 100644
index 0000000..24e7da5
--- /dev/null
+++ b/addon/ShadowCheckpoint.lua
@@ -0,0 +1,482 @@
+-- Lightweight, append-only observations for later same-pull replay.  This is
+-- evidence collection, not a simulator restore contract: missing timer and
+-- aura fields must never be filled with zero or an empty set downstream.
+local checkpoint = {}
+BrainOfCat.ShadowCheckpoint = checkpoint
+
+checkpoint.Schema = "brainofcat_shadow_checkpoint/v1"
+checkpoint.FileName = "BrainOfCatShadowCheckpoints.jsonl"
+checkpoint.IntervalSeconds = 5
+checkpoint.FlushSeconds = 2
+checkpoint.SessionId = nil
+checkpoint.PullId = nil
+checkpoint.LastError = nil
+checkpoint.WrittenCount = 0
+checkpoint.DroppedCount = 0
+checkpoint.CapturedCount = 0
+
+local pending = {}
+local pullSequence = 0
+local journalSequence = 0
+local lastCheckpointAt = -100
+local lastEquipmentKey = nil
+local flushElapsed = 0
+local loggedError = false
+
+local function Now()
+    return type(GetTime) == "function" and GetTime() or 0
+end
+
+local function PlayerGuid()
+    if type(UnitExists) ~= "function" then
+        return nil
+    end
+    local _, guid = UnitExists("player")
+    return guid
+end
+
+local function IsWarrior()
+    if type(UnitClass) ~= "function" then
+        return false
+    end
+    local _, classFile = UnitClass("player")
+    return classFile == "WARRIOR"
+end
+
+local function CharacterKey()
+    local realm = type(GetRealmName) == "function" and GetRealmName() or "unknown"
+    local name = type(UnitName) == "function" and UnitName("player") or "unknown"
+    return tostring(realm) .. "/" .. tostring(name)
+end
+
+local function Field(quality, source, value)
+    local entry = { quality = quality, source = source }
+    if value ~= nil then
+        entry.value = value
+    end
+    return entry
+end
+
+local function NumberField(value, source, quality)
+    local number = tonumber(value)
+    if number == nil or number < 0 then
+        return Field("MISSING", source)
+    end
+    return Field(quality or "PARTIAL", source, number)
+end
+
+local function Milliseconds(value)
+    local seconds = tonumber(value)
+    if seconds == nil or seconds < 0 then
+        return nil
+    end
+    return math.floor(seconds * 1000 + 0.5)
+end
+
+local function SpellRemaining(name)
+    if type(Cat2) ~= "table" or type(Cat2.GetSpellCooldown) ~= "function" then
+        return nil
+    end
+    local ok, value = pcall(Cat2.GetSpellCooldown, name)
+    return ok and Milliseconds(value) or nil
+end
+
+local function CaptureAuras(api, unit)
+    local auras = {}
+    if type(api) ~= "function" then
+        return auras
+    end
+    local slot = 1
+    while slot <= 40 do
+        local texture, stacks, buffSpellId, debuffSpellId = api(unit, slot)
+        if not texture then
+            break
+        end
+        -- Nampower extends UnitBuff with spellId in return 3, while
+        -- UnitDebuff returns debuffType in 3 and spellId in return 4.
+        local spellId = api == UnitBuff and buffSpellId or debuffSpellId
+        table.insert(auras, {
+            spellId = tonumber(spellId),
+            stacks = tonumber(stacks),
+            texture = texture,
+            -- Vanilla UnitBuff/UnitDebuff do not establish a stable caster or
+            -- remaining duration for every observed aura.
+        })
+        slot = slot + 1
+    end
+    return auras
+end
+
+local function CaptureTarget()
+    if type(UnitExists) ~= "function" then
+        return nil
+    end
+    local exists, guid = UnitExists("target")
+    if not exists or type(guid) ~= "string" or guid == "" then
+        return nil
+    end
+    local attackable = nil
+    if type(UnitCanAttack) == "function" then
+        attackable = UnitCanAttack("player", "target") and true or false
+    end
+    local target = {
+        guid = guid,
+        name = type(UnitName) == "function" and UnitName("target") or nil,
+        currentHealth = type(UnitHealth) == "function" and tonumber(UnitHealth("target")) or nil,
+        maxHealth = type(UnitHealthMax) == "function" and tonumber(UnitHealthMax("target")) or nil,
+        attackable = attackable,
+        healthQuality = "PARTIAL",
+        source = "UnitExists+UnitHealth+UnitHealthMax+UnitCanAttack(target)",
+    }
+    return target
+end
+
+local function CaptureFields(state, target)
+    local fields = {}
+    fields["target.max_health"] = NumberField(
+        target and target.maxHealth, "UnitHealthMax(target)", "PARTIAL")
+    fields["target.current_health"] = NumberField(
+        target and target.currentHealth, "UnitHealth(target)", "PARTIAL")
+
+    local powerType = type(UnitPowerType) == "function" and UnitPowerType("player") or nil
+    local rage = powerType == 1 and type(UnitMana) == "function"
+        and tonumber(UnitMana("player")) or nil
+    local rageSource = "UnitMana(player)"
+    local rageQuality = "PARTIAL"
+    if rage ~= nil and type(GetUnitField) == "function" then
+        -- Nampower's known Vanilla warrior field is in tenths.  Like the
+        -- calibration logger, call it directly because it repairs Lua state.
+        local rawRage = tonumber(GetUnitField("player", "power2"))
+        local rawMax = tonumber(GetUnitField("player", "maxPower2"))
+        local maxRage = type(UnitManaMax) == "function"
+            and tonumber(UnitManaMax("player")) or nil
+        if rawRage and rawMax and maxRage and maxRage > 0
+            and rawMax / maxRage == 10 then
+            rage = rawRage / 10
+            rageSource = "Nampower.GetUnitField(player,power2)/10"
+            rageQuality = "EXACT"
+        end
+    end
+    fields["player.rage_current"] = NumberField(rage, rageSource, rageQuality)
+
+    local stance = nil
+    if type(GetShapeshiftForm) == "function" then
+        local index = tonumber(GetShapeshiftForm())
+        if index == 1 then stance = "BATTLE"
+        elseif index == 2 then stance = "DEFENSIVE"
+        elseif index == 3 then stance = "BERSERKER" end
+    end
+    fields["player.stance"] = stance
+        and Field("EXACT", "GetShapeshiftForm()", stance)
+        or Field("MISSING", "GetShapeshiftForm()")
+
+    local gcd = state and Milliseconds(state.gcd)
+    if not gcd and type(Cat2) == "table"
+        and type(Cat2.GetLeftGCD) == "function" then
+        local ok, value = pcall(Cat2.GetLeftGCD)
+        gcd = ok and Milliseconds(value) or nil
+    end
+    fields["timers.gcd_remaining_ms"] = NumberField(
+        gcd, "Cat2.GetLeftGCD()", "PARTIAL")
+
+    local cooldowns = {
+        { tag = "BLOODTHIRST", spellId = 23894,
+          remainingMs = state and Milliseconds(state.bloodthirstCooldown)
+              or SpellRemaining("嗜血") },
+        { tag = "WHIRLWIND", spellId = 1680,
+          remainingMs = state and Milliseconds(state.whirlwindCooldown)
+              or SpellRemaining("旋风斩") },
+    }
+    local cooldownKnown = cooldowns[1].remainingMs ~= nil
+        and cooldowns[2].remainingMs ~= nil
+    fields["timers.cooldowns_remaining_ms"] = cooldownKnown
+        and Field("PARTIAL", "Cat2.GetSpellCooldown()", cooldowns)
+        or Field("MISSING", "Cat2.GetSpellCooldown()")
+
+    local mh = state and state.mainHandSwingRemainingKnown
+        and Milliseconds(state.mainHandSwingRemaining) or nil
+    fields["timers.main_hand_swing_remaining_ms"] = NumberField(
+        mh, "Cat2.GetMainHandLeft() validated by BuildState", "PARTIAL")
+    fields["timers.off_hand_swing_remaining_ms"] = Field(
+        "MISSING", "no validated off-hand swing anchor")
+
+    local queue = state and state.queuedSwingKnown and state.queuedSwing or nil
+    if queue == "KEEP" then queue = "NONE" end
+    fields["queue.next_swing"] = queue
+        and Field("PARTIAL", "Cat2 action-bar IsCurrentAction probe", queue)
+        or Field("MISSING", "next-swing queue not observable at boundary")
+
+    fields["player.self_auras_and_procs"] = type(UnitBuff) == "function"
+        and Field("PARTIAL", "UnitBuff(player), duration/caster unavailable",
+            CaptureAuras(UnitBuff, "player"))
+        or Field("MISSING", "UnitBuff unavailable")
+    fields["target.candidate_owned_existing_debuffs"] = Field(
+        "MISSING", "UnitDebuff(target) does not prove caster ownership or duration")
+    return fields
+end
+
+local function Stamp(ordinal)
+    return {
+        epochSeconds = type(time) == "function" and time() or nil,
+        getTimeSeconds = Now(),
+        causalOrdinal = ordinal,
+    }
+end
+
+local function AllocateOrdinal()
+    local brain = BrainOfCat.PolicyBrain
+    if type(brain) == "table"
+        and type(brain.AllocateCausalOrdinal) == "function" then
+        return brain.AllocateCausalOrdinal()
+    end
+    return nil
+end
+
+local function Queue(kind, trigger, extras, ordinal)
+    if not checkpoint.SessionId then
+        return
+    end
+    journalSequence = journalSequence + 1
+    local document = {
+        schema = checkpoint.Schema,
+        kind = kind,
+        sessionId = checkpoint.SessionId,
+        characterKey = CharacterKey(),
+        pullId = checkpoint.PullId,
+        playerGuid = PlayerGuid(),
+        at = Stamp(ordinal or AllocateOrdinal()),
+        sequence = journalSequence,
+        trigger = trigger,
+    }
+    if type(extras) == "table" then
+        for key, value in pairs(extras) do document[key] = value end
+    end
+    table.insert(pending, document)
+    if table.getn(pending) > 256 then
+        table.remove(pending, 1)
+        checkpoint.DroppedCount = checkpoint.DroppedCount + 1
+    end
+end
+
+local function Capture(trigger, state)
+    if not checkpoint.PullId then return end
+    local target = CaptureTarget()
+    local guid = target and target.guid or nil
+    local zone = type(GetRealZoneText) == "function" and GetRealZoneText()
+        or (type(GetZoneText) == "function" and GetZoneText() or nil)
+    Queue("checkpoint", trigger, {
+        targetGuid = guid,
+        targets = target and { target } or {},
+        targetRegistryQuality = "PARTIAL_VISIBLE_TARGET_ONLY",
+        instance = { zone = zone, idQuality = "MISSING" },
+        fields = CaptureFields(state, target),
+        visibleTargetDebuffs = target and type(UnitDebuff) == "function"
+            and CaptureAuras(UnitDebuff, "target") or nil,
+    })
+    checkpoint.CapturedCount = checkpoint.CapturedCount + 1
+    lastCheckpointAt = Now()
+end
+
+function checkpoint.CaptureNow(trigger)
+    if not checkpoint.PullId then return false end
+    Capture(trigger or "manual_smoke")
+    return true
+end
+
+-- Combat text is an explicitly client-only fallback when old Nampower does
+-- not emit typed white results. It never pretends to identify a server event.
+function checkpoint.RecordClientCombatText(eventName, message)
+    if not checkpoint.PullId then return false end
+    Queue("event_delta", eventName, {
+        event = {
+            name = eventName,
+            kind = "CLIENT_LOG_RESULT",
+            message = tostring(message or ""),
+        },
+    })
+    return true
+end
+
+local function CaptureEquipment()
+    local equipment = {}
+    local key = ""
+    if type(GetInventoryItemLink) ~= "function" then return equipment, key end
+    for slot = 1, 19 do
+        local link = GetInventoryItemLink("player", slot)
+        if link then table.insert(equipment, { slot = slot, link = link }) end
+        key = key .. tostring(link or "-") .. ";"
+    end
+    return equipment, key
+end
+
+local function CaptureBinding(trigger)
+    local equipment, key = CaptureEquipment()
+    if key == lastEquipmentKey
+        and trigger ~= "player_login" and trigger ~= "pull_start" then return end
+    lastEquipmentKey = key
+    local talents = {}
+    if type(GetNumTalentTabs) == "function"
+        and type(GetNumTalents) == "function"
+        and type(GetTalentInfo) == "function" then
+        for tab = 1, GetNumTalentTabs() or 0 do
+            for index = 1, GetNumTalents(tab) or 0 do
+                local name, _, _, _, rank = GetTalentInfo(tab, index)
+                if tonumber(rank) and rank > 0 then
+                    table.insert(talents, {
+                        tab = tab, index = index, name = name, rank = rank,
+                    })
+                end
+            end
+        end
+    end
+    local version, build = nil, nil
+    if type(GetBuildInfo) == "function" then version, build = GetBuildInfo() end
+    Queue("binding", trigger, {
+        equipment = equipment,
+        talents = talents,
+        clientBuild = { version = version, build = build },
+    })
+end
+
+local function BeginPull(trigger)
+    if checkpoint.PullId then return end
+    pullSequence = pullSequence + 1
+    checkpoint.PullId = checkpoint.SessionId .. "/pull-" .. tostring(pullSequence)
+    lastCheckpointAt = -100
+    CaptureBinding("pull_start")
+    Capture(trigger)
+end
+
+function checkpoint.OnDecisionState(state)
+    if not checkpoint.SessionId or not IsWarrior()
+        or type(state) ~= "table" or state.inCombat ~= true then return end
+    if not checkpoint.PullId then BeginPull("first_decision_in_combat") end
+    if Now() - lastCheckpointAt >= checkpoint.IntervalSeconds then
+        Capture("decision_boundary", state)
+    end
+end
+
+function checkpoint.OnObservedEvent(record)
+    if not checkpoint.SessionId or not checkpoint.PullId
+        or type(record) ~= "table" then return end
+    local name = record.event
+    if name ~= "UNIT_CASTEVENT" and name ~= "SPELL_CAST_EVENT"
+        and name ~= "SPELL_QUEUE_EVENT" and name ~= "SPELL_START_SELF"
+        and name ~= "SPELL_GO_SELF"
+        and name ~= "SPELL_FAILED_SELF" and name ~= "SPELL_DAMAGE_EVENT_SELF"
+        and name ~= "SPELL_MISS_SELF" and name ~= "AUTO_ATTACK_SELF" then
+        return
+    end
+    Queue("event_delta", name, {
+        targetGuid = record.targetGUID or (record.state and record.state.targetGUID),
+        event = {
+            name = name,
+            kind = name == "SPELL_START_SELF" and "START"
+                or (name == "SPELL_GO_SELF" and "GO"
+                or (name == "SPELL_FAILED_SELF" and "FAIL"
+                or ((name == "SPELL_DAMAGE_EVENT_SELF"
+                    or name == "AUTO_ATTACK_SELF") and "DMG"
+                or (name == "SPELL_MISS_SELF" and "MISS"
+                or "CLIENT_OR_UNIT_CAST")))),
+            sourceGuid = record.sourceGUID,
+            targetGuid = record.targetGUID,
+            spellId = tonumber(record.spellID),
+            amount = tonumber(record.amount),
+            eventTimeSeconds = tonumber(record.time),
+            castKind = record.castKind,
+            queueEventCode = tonumber(record.queueEventCode),
+            hitInfo = tonumber(record.hitInfo),
+            missInfo = tonumber(record.missInfo),
+        },
+    }, record.causalOrdinal)
+    if type(checkpoint.SmokeOnTypedEvent) == "function" then
+        checkpoint.SmokeOnTypedEvent(record)
+    end
+    if Now() - lastCheckpointAt >= checkpoint.IntervalSeconds then
+        Capture("periodic_event")
+    end
+end
+
+function checkpoint.Flush()
+    if table.getn(pending) == 0 then return true end
+    if type(WriteCustomFile) ~= "function" then
+        checkpoint.LastError = "WriteCustomFile_missing"
+        return false
+    end
+    local encoder = BrainOfCat.TimerCalibrationDebug
+    if type(encoder) ~= "table" or type(encoder.JsonEncode) ~= "function" then
+        checkpoint.LastError = "JsonEncode_missing"
+        return false
+    end
+    local lines = {}
+    for index = 1, table.getn(pending) do
+        local ok, json = pcall(encoder.JsonEncode, pending[index])
+        if not ok or type(json) ~= "string" then
+            checkpoint.LastError = ok and "JsonEncode_invalid" or tostring(json)
+            return false
+        end
+        table.insert(lines, json)
+    end
+    local ok, written, errorMessage = pcall(
+        WriteCustomFile, checkpoint.FileName, table.concat(lines, "\n") .. "\n", "a")
+    if not ok or written == false then
+        checkpoint.LastError = tostring(not ok and written or errorMessage or "WriteCustomFile_false")
+        return false
+    end
+    checkpoint.WrittenCount = checkpoint.WrittenCount + table.getn(pending)
+    pending = {}
+    checkpoint.LastError = nil
+    loggedError = false
+    return true
+end
+
+local frame = CreateFrame("Frame", "BrainOfCatShadowCheckpointFrame")
+frame:RegisterEvent("PLAYER_LOGIN")
+frame:RegisterEvent("PLAYER_REGEN_DISABLED")
+frame:RegisterEvent("PLAYER_REGEN_ENABLED")
+frame:RegisterEvent("PLAYER_TARGET_CHANGED")
+frame:RegisterEvent("UNIT_INVENTORY_CHANGED")
+frame:RegisterEvent("PLAYER_LOGOUT")
+frame:SetScript("OnEvent", function()
+    if event == "PLAYER_LOGIN" then
+        if not IsWarrior() then return end
+        checkpoint.SessionId = "checkpoint-" .. tostring(type(time) == "function" and time() or 0)
+            .. "-" .. tostring(math.floor(Now() * 1000)) .. "-" .. CharacterKey()
+        CaptureBinding("player_login")
+        if type(UnitAffectingCombat) == "function"
+            and UnitAffectingCombat("player") then
+            BeginPull("login_during_combat_origin_unknown")
+        end
+    elseif not checkpoint.SessionId then
+        return
+    elseif event == "PLAYER_REGEN_DISABLED" then
+        BeginPull("combat_start")
+    elseif event == "PLAYER_REGEN_ENABLED" then
+        if checkpoint.PullId then
+            Capture("combat_end")
+            checkpoint.PullId = nil
+        end
+        checkpoint.Flush()
+    elseif event == "PLAYER_TARGET_CHANGED" then
+        if checkpoint.PullId then Capture("target_changed") end
+    elseif event == "UNIT_INVENTORY_CHANGED" then
+        if arg1 == "player" then CaptureBinding("equipment_changed") end
+    elseif event == "PLAYER_LOGOUT" then
+        if checkpoint.PullId then Capture("logout_during_combat") end
+        checkpoint.Flush()
+    end
+end)
+frame:SetScript("OnUpdate", function()
+    if table.getn(pending) == 0 then return end
+    flushElapsed = flushElapsed + (arg1 or 0)
+    if flushElapsed < checkpoint.FlushSeconds then return end
+    flushElapsed = 0
+    if not checkpoint.Flush() and not loggedError then
+        loggedError = true
+        if DEFAULT_CHAT_FRAME then
+            DEFAULT_CHAT_FRAME:AddMessage(
+                "|cff6bc7e0BrainOfCat checkpoint：|r写入失败="
+                .. tostring(checkpoint.LastError))
+        end
+    end
+end)
diff --git a/addon/ShadowCheckpointSmoke.lua b/addon/ShadowCheckpointSmoke.lua
new file mode 100644
index 0000000..874f0e4
--- /dev/null
+++ b/addon/ShadowCheckpointSmoke.lua
@@ -0,0 +1,360 @@
+-- One-key client smoke for the append-only Shadow checkpoint writer.  This
+-- checks actual white-result events and flushed records, never macro presses.
+local checkpoint = BrainOfCat.ShadowCheckpoint
+local smoke = { phase = "ready", nativeWhite = 0, typedWhite = 0 }
+checkpoint.Smoke = smoke
+
+local macroName = "BoC采集"
+local macroBody = "/boccp press"
+local guide = CreateFrame("Frame", "BrainOfCatCheckpointSmokeGuide", UIParent)
+guide:SetWidth(470)
+guide:SetHeight(112)
+guide:SetPoint("TOP", UIParent, "TOP", 0, -96)
+guide:SetFrameStrata("HIGH")
+guide:SetBackdrop({
+    bgFile = "Interface\\Tooltips\\UI-Tooltip-Background",
+    edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
+    tile = true, tileSize = 16, edgeSize = 12,
+    insets = { left = 4, right = 4, top = 4, bottom = 4 },
+})
+guide:SetBackdropColor(0.02, 0.06, 0.09, 0.94)
+local title = guide:CreateFontString(nil, "OVERLAY", "GameFontNormalLarge")
+title:SetPoint("TOPLEFT", guide, "TOPLEFT", 13, -12)
+title:SetPoint("TOPRIGHT", guide, "TOPRIGHT", -13, -12)
+title:SetJustifyH("LEFT")
+local progress = guide:CreateFontString(nil, "OVERLAY", "GameFontHighlight")
+progress:SetPoint("TOPLEFT", title, "BOTTOMLEFT", 0, -8)
+progress:SetPoint("TOPRIGHT", title, "BOTTOMRIGHT", 0, -8)
+progress:SetJustifyH("LEFT")
+local action = guide:CreateFontString(nil, "OVERLAY", "GameFontNormal")
+action:SetPoint("TOPLEFT", progress, "BOTTOMLEFT", 0, -8)
+action:SetPoint("TOPRIGHT", progress, "BOTTOMRIGHT", 0, -8)
+action:SetHeight(52)
+action:SetJustifyH("LEFT")
+action:SetJustifyV("TOP")
+guide:Hide()
+
+local function Show(header, detail, instruction)
+    title:SetText(header)
+    progress:SetText(detail)
+    action:SetText(instruction)
+    guide:Show()
+end
+
+local function Now()
+    return type(GetTime) == "function" and GetTime() or 0
+end
+
+local function HideOldGuides()
+    local tasks = BrainOfCat.CalibrationTasks
+    if type(tasks) == "table" and type(tasks.HideGuide) == "function" then
+        tasks.HideGuide()
+    end
+    local bridge = BrainOfCat.Cat2Bridge
+    if type(bridge) == "table" and bridge.ProgressPanel then
+        bridge.ProgressPanel:Hide()
+    end
+end
+
+local function AttackActionState()
+    if type(IsAttackAction) ~= "function"
+        or type(IsCurrentAction) ~= "function" then return nil, nil end
+    for slot = 1, 72 do
+        if IsAttackAction(slot) then
+            return slot, IsCurrentAction(slot) and true or false
+        end
+    end
+    return nil, nil
+end
+
+local function StartAttackFromPress(firstPress)
+    local slot, current = AttackActionState()
+    if slot and type(UseAction) == "function" then
+        if not current then UseAction(slot) end
+        return true
+    end
+    -- The fallback is requested only once per smoke, never on a repeated
+    -- macro press; AttackTarget itself can toggle an ongoing white attack.
+    if firstPress and type(Cat2) == "table"
+        and type(Cat2.StartAttack) == "function" then
+        Cat2.StartAttack()
+        return true
+    end
+    return false
+end
+
+local function StopAttackFromPress()
+    local slot, current = AttackActionState()
+    if slot and current and type(UseAction) == "function" then
+        UseAction(slot)
+        return true
+    end
+    if type(Cat2) == "table" and Cat2.AutoAttack == true
+        and type(Cat2.StopAttack) == "function" then
+        Cat2.StopAttack()
+        return true
+    end
+    return false
+end
+
+local function EndOwnedTelemetry(reason)
+    if not smoke.ownsTelemetry then return end
+    smoke.ownsTelemetry = false
+    local logger = BrainOfCat.CalibrationLogger
+    if type(logger) == "table"
+        and type(logger.EndShadowOutcomeSession) == "function" then
+        logger.EndShadowOutcomeSession(reason)
+    end
+end
+
+local function ResultCount()
+    return smoke.nativeWhite + smoke.typedWhite
+end
+
+local function RenderRunning()
+    local elapsed = smoke.pullStartedAt and math.floor(Now() - smoke.pullStartedAt) or 0
+    local captures = checkpoint.CapturedCount - smoke.capturedBefore
+    local written = checkpoint.WrittenCount - smoke.writtenBefore
+    local telemetry = smoke.telemetryError and
+        ("；typed不可用=" .. tostring(smoke.telemetryError)) or ""
+    Show(
+        "BrainOfCat checkpoint · 阶段 2/3 保持平砍",
+        tostring(elapsed) .. "/15 秒；白字结果：原生 " .. tostring(smoke.nativeWhite)
+            .. " / typed " .. tostring(smoke.typedWhite)
+            .. "；状态采样 " .. tostring(captures) .. "；已写盘 " .. tostring(written),
+        "现在不用再按宏，也不要释放技能；保持攻击木桩。"
+            .. telemetry
+    )
+end
+
+local function Finish()
+    if not checkpoint.Flush() then
+        smoke.phase = "write_failed"
+        Show("BrainOfCat checkpoint · 写盘失败", tostring(checkpoint.LastError),
+            "日志仍在内存，先别 /reload；请把屏幕上的错误发给我。")
+        return
+    end
+    if checkpoint.DroppedCount > smoke.droppedBefore then
+        smoke.phase = "write_failed"
+        Show("BrainOfCat checkpoint · 日志缓冲溢出", "已丢失采集记录",
+            "先别 /reload；请把这条提示发给我。")
+        return
+    end
+    if checkpoint.WrittenCount - smoke.writtenBefore < 2 then
+        smoke.phase = "write_failed"
+        Show("BrainOfCat checkpoint · 写盘未闭合", "不足 2 条新记录已写盘",
+            "先别 /reload；请把这条提示发给我。")
+        return
+    end
+    smoke.phase = "complete"
+    EndOwnedTelemetry("checkpoint_smoke_complete")
+    Show(
+        "BrainOfCat checkpoint · 阶段 3/3 已完成",
+        "真实白字结果：原生 " .. tostring(smoke.nativeWhite)
+            .. " / typed " .. tostring(smoke.typedWhite)
+            .. "；状态采样 " .. tostring(checkpoint.CapturedCount - smoke.capturedBefore)
+            .. "；已写盘 " .. tostring(checkpoint.WrittenCount - smoke.writtenBefore),
+        "数据已写入 CustomData，不用 /reload。再按一次同一宏可停止平砍。"
+    )
+end
+
+function checkpoint.SmokeOnTypedEvent(record)
+    if smoke.phase == "running" and record.event == "AUTO_ATTACK_SELF" then
+        smoke.typedWhite = smoke.typedWhite + 1
+    end
+end
+
+function checkpoint.SmokeOneKey()
+    if smoke.phase == "write_failed" then
+        Show("BrainOfCat checkpoint · 写盘失败", tostring(checkpoint.LastError or "记录未闭合"),
+            "先别 /reload；请把这条提示发给我。")
+        return
+    end
+    if smoke.phase == "complete" then
+        if smoke.stopRequested then return end
+        smoke.stopRequested = true
+        if StopAttackFromPress() then
+            action:SetText("平砍已停止；日志已写盘，不用 /reload。")
+        else
+            action:SetText("日志已写盘；若仍在平砍，请手动停止攻击。")
+        end
+        return
+    end
+    if smoke.phase == "running" then
+        StartAttackFromPress(false)
+        RenderRunning()
+        return
+    end
+    local exists, guid = nil, nil
+    if type(UnitExists) == "function" then
+        exists, guid = UnitExists("target")
+    end
+    if not exists or type(guid) ~= "string" or guid == ""
+        or type(UnitCanAttack) ~= "function"
+        or not UnitCanAttack("player", "target") then
+        Show("BrainOfCat checkpoint · 阶段 1/3", "尚未选中可攻击木桩",
+            "选中木桩后再按同一个“BoC采集”宏。")
+        return
+    end
+    if not checkpoint.SessionId or type(WriteCustomFile) ~= "function" then
+        Show("BrainOfCat checkpoint · 无法开始", "采集器或 CustomData 未就绪",
+            "请把这条提示发给我；现在不用 /reload。")
+        return
+    end
+    local logger = BrainOfCat.CalibrationLogger
+    local alreadyActive = type(logger) == "table"
+        and logger.shadowOutcomeSessionActive == true
+    smoke.telemetryError = nil
+    smoke.ownsTelemetry = false
+    if type(logger) == "table" and logger.enabled ~= true
+        and type(logger.BeginShadowOutcomeSession) == "function" then
+        local ready, reason = logger.BeginShadowOutcomeSession()
+        if ready and not alreadyActive then smoke.ownsTelemetry = true end
+        if not ready then smoke.telemetryError = reason or "unknown" end
+    end
+    smoke.phase = "running"
+    smoke.pressedAt = Now()
+    smoke.pullStartedAt = nil
+    smoke.lastCaptureAt = nil
+    smoke.nativeWhite = 0
+    smoke.typedWhite = 0
+    smoke.stopRequested = false
+    smoke.capturedBefore = checkpoint.CapturedCount
+    smoke.writtenBefore = checkpoint.WrittenCount
+    smoke.droppedBefore = checkpoint.DroppedCount
+    HideOldGuides()
+    StartAttackFromPress(true)
+    RenderRunning()
+end
+
+local function FindMacro()
+    if type(GetMacroIndexByName) == "function" then
+        local index = tonumber(GetMacroIndexByName(macroName)) or 0
+        if index > 0 then return index end
+    end
+    if type(GetMacroInfo) == "function" then
+        for index = 1, 36 do
+            local name = GetMacroInfo(index)
+            if name == macroName then return index end
+        end
+    end
+    return nil
+end
+
+function checkpoint.CreateSmokeMacro()
+    HideOldGuides()
+    local index = FindMacro()
+    if index and type(EditMacro) == "function" then
+        local _, _, _, isLocal = GetMacroInfo(index)
+        local ok = pcall(EditMacro, index, macroName, 1, macroBody, isLocal)
+        if not ok then index = nil end
+    elseif not index and type(CreateMacro) == "function" then
+        local ok, created = pcall(CreateMacro, macroName, 1, macroBody, nil, true)
+        index = ok and tonumber(created) or nil
+    end
+    if not index then
+        Show("BrainOfCat checkpoint · 宏创建失败", "手动创建“BoC采集”宏",
+            "宏内容：" .. macroBody)
+        return false
+    end
+    local picked = false
+    if type(PickupMacro) == "function" then picked = pcall(PickupMacro, index) end
+    Show("BrainOfCat checkpoint · 阶段 1/3 宏已就绪",
+        picked and "宏已放到鼠标上" or "宏已创建",
+        "放到动作条并绑定一个键；选中木桩后只按这个键一次。")
+    return true
+end
+
+SLASH_BOC_CHECKPOINT1 = "/boccp"
+SlashCmdList["BOC_CHECKPOINT"] = function(message)
+    local command = string.lower(tostring(message or ""))
+    if command == "macro" then
+        checkpoint.CreateSmokeMacro()
+    elseif command == "press" then
+        checkpoint.SmokeOneKey()
+    else
+        if smoke.phase == "running" then RenderRunning()
+        elseif smoke.phase == "complete" then
+            Show("BrainOfCat checkpoint · 已完成",
+                "状态采样和白字结果已写盘", "无需 /reload；如仍在平砍，再按“BoC采集”可停止。")
+        else
+            Show("BrainOfCat checkpoint · 阶段 1/3",
+                "输入 /boccp macro 自动创建“BoC采集”宏",
+                "把宏放到动作条，选中木桩后按一次。")
+        end
+    end
+end
+
+local frame = CreateFrame("Frame", "BrainOfCatCheckpointSmokeFrame")
+frame:RegisterEvent("PLAYER_LOGIN")
+frame:RegisterEvent("PLAYER_REGEN_ENABLED")
+frame:RegisterEvent("CHAT_MSG_COMBAT_SELF_HITS")
+frame:RegisterEvent("CHAT_MSG_COMBAT_SELF_MISSES")
+frame:RegisterEvent("PLAYER_LOGOUT")
+frame:SetScript("OnEvent", function()
+    if event == "PLAYER_LOGIN" then
+        local _, classFile = UnitClass("player")
+        if classFile == "WARRIOR" then
+            Show("BrainOfCat checkpoint · 阶段 1/3",
+                "输入 /boccp macro 自动创建“BoC采集”宏",
+                "把宏放到动作条，选中木桩后按一次；不用旧的“BoC标定”宏。")
+        end
+    elseif event == "CHAT_MSG_COMBAT_SELF_HITS"
+        or event == "CHAT_MSG_COMBAT_SELF_MISSES" then
+        if smoke.phase == "running"
+            and checkpoint.RecordClientCombatText(event, arg1) then
+            smoke.nativeWhite = smoke.nativeWhite + 1
+        end
+    elseif event == "PLAYER_REGEN_ENABLED" then
+        if smoke.phase == "running" then
+            if smoke.pullStartedAt and Now() - smoke.pullStartedAt >= 15
+                and ResultCount() > 0
+                and checkpoint.CapturedCount - smoke.capturedBefore >= 2 then
+                Finish()
+            else
+                smoke.phase = "retry"
+                EndOwnedTelemetry("checkpoint_smoke_interrupted")
+                Show("BrainOfCat checkpoint · 战斗提前结束",
+                    "本轮未达到 15 秒且有真实白字的完成条件",
+                    "选一个能持续战斗的木桩，再按同一个宏重试。")
+            end
+        end
+    elseif event == "PLAYER_LOGOUT" then
+        EndOwnedTelemetry("checkpoint_smoke_logout")
+    end
+end)
+
+local elapsedUpdate = 0
+frame:SetScript("OnUpdate", function()
+    if smoke.phase ~= "running" then return end
+    elapsedUpdate = elapsedUpdate + (arg1 or 0)
+    if elapsedUpdate < 0.5 then return end
+    elapsedUpdate = 0
+    local now = Now()
+    if not checkpoint.PullId then
+        if now - smoke.pressedAt >= 8 then
+            Show("BrainOfCat checkpoint · 尚未进入战斗", "未观察到 pull 起点",
+                "检查是否在平砍木桩；若攻击未启动，把“攻击”放到动作条，再按同一宏。")
+        end
+        return
+    end
+    if not smoke.pullStartedAt then
+        smoke.pullStartedAt = now
+        smoke.lastCaptureAt = now
+    end
+    if now - smoke.lastCaptureAt >= checkpoint.IntervalSeconds then
+        checkpoint.CaptureNow("smoke_periodic")
+        smoke.lastCaptureAt = now
+    end
+    if now - smoke.pullStartedAt >= 15 and ResultCount() > 0
+        and checkpoint.CapturedCount - smoke.capturedBefore >= 2 then
+        Finish()
+    elseif now - smoke.pullStartedAt >= 30 and ResultCount() == 0 then
+        smoke.phase = "retry"
+        EndOwnedTelemetry("checkpoint_smoke_no_white_result")
+        Show("BrainOfCat checkpoint · 没收到平砍结果", "已有状态但没有白字事件",
+            "确认在攻击木桩，再按同一宏重试；日志已保留。")
+    else
+        RenderRunning()
+    end
+end)
